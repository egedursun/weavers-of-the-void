    "strip-comments": "node scripts/strip-comments.mjs",
    "typegen": "node scripts/typegen.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:lint-rules": "node --test eslint/aeronaPlugin.test.js"
