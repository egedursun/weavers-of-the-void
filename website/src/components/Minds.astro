---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import { copyFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = copyFor(locale).minds
const emblems: EmblemName[] = ['crown', 'scroll', 'orb', 'tome']
---

<section class="section minds" id="minds" aria-labelledby="minds-title">
  <div class="wrap">
    <div class="head center">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="minds-title" style="--delay: 0.08s">{copy.title}</h2>
      <p class="lead minds__lead reveal" style="--delay: 0.14s">{copy.lead}</p>
    </div>

    <ul class="minds__grid">
      {
        copy.items.map((item, index) => (
          <Frame as="li" size="card" class="minds__item reveal" style={`--delay: ${0.08 * index}s`}>
            <span class="minds__shine" aria-hidden="true" />
            <span class="medallion minds__medal">
              <Emblem name={emblems[index]} />
            </span>
            <div class="minds__words">
              <h3 class="gilded">{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </Frame>
        ))
      }
    </ul>

    <div class="minds__voice reveal">
      <Frame size="panel" gem class="minds__plate">
        <span class="medallion minds__seal" aria-hidden="true">
          <Emblem name="quill" />
        </span>
        <div class="minds__voice-words">
          <h3 class="gilded">{copy.voice.title}</h3>
          <span class="minds__rule" aria-hidden="true"></span>
          <p>{copy.voice.text}</p>
        </div>
      </Frame>
    </div>

    <ul class="minds__stats">
      {
        copy.stats.map((stat, index) => (
          <li class="minds__stat reveal" style={`--delay: ${0.1 * index}s`}>
            <span class="minds__value gilded">{stat.value}</span>
            <span class="minds__label">{stat.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .minds__lead {
    color: var(--fg);
    opacity: 0.9;
  }

  .minds__grid {
    display: grid;
    gap: 2.4rem;
    margin: 0;
    padding: 0.5rem 0 0;
    list-style: none;
  }

  .minds__item {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 1.3rem;
    padding: 2rem 1.9rem 2.1rem;
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.6s var(--ease);
  }

  .minds__shine {
    position: absolute;
    inset: 4px;
    z-index: 1;
    overflow: hidden;
    border-radius: 2px;
    pointer-events: none;
  }

  .minds__shine::after {
    content: '';
    position: absolute;
    inset: -30% -80%;
    background: linear-gradient(
      105deg,
      transparent 40%,
      oklch(1 0 0 / 0.05) 45%,
      oklch(0.98 0.07 92 / 0.22) 50%,
      oklch(1 0 0 / 0.05) 55%,
      transparent 60%
    );
    transform: translateX(-70%);
  }

  .minds__item:hover {
    transform: translateY(-6px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 40px -6px oklch(0.84 0.16 86 / 0.55),
      0 30px 56px -28px oklch(0.05 0.04 290 / 0.95);
  }

  .minds__item:hover .minds__shine::after {
    animation: minds-sweep 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .minds__medal {
    width: 4.4rem;
    height: 4.4rem;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .minds__medal :global(.emblem) {
    width: 2.45rem;
    height: 2.45rem;
  }

  .minds__item:hover .minds__medal {
    transform: scale(1.08);
  }

  .minds__words {
    display: grid;
    gap: 0.6rem;
    min-width: 0;
  }

  .minds__words h3 {
    margin: 0.35rem 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2vw, 1.5rem);
    line-height: 1.2;
    text-wrap: balance;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.85));
  }

  .minds__words p {
    margin: 0;
    color: var(--fg);
    opacity: 0.88;
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .minds__voice {
    position: relative;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .minds__voice::before {
    content: '';
    position: absolute;
    inset: -12% 8%;
    z-index: -1;
    background:
      radial-gradient(closest-side, oklch(0.6 0.23 302 / 0.32), transparent 72%),
      radial-gradient(closest-side, oklch(0.84 0.16 86 / 0.14), transparent 60%);
    filter: blur(24px);
    pointer-events: none;
  }

  .minds__plate {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    padding: clamp(2.6rem, 5vw, 3.6rem) clamp(1.6rem, 5vw, 4rem) clamp(2.4rem, 5vw, 3.4rem);
    text-align: center;
    background:
      radial-gradient(50rem 18rem at 50% 0%, oklch(0.84 0.16 86 / 0.12), transparent 70%),
      radial-gradient(40rem 20rem at 50% 100%, oklch(0.6 0.23 302 / 0.22), transparent 70%),
      linear-gradient(180deg, var(--frame-hi), var(--frame-lo));
  }

  .minds__seal {
    width: 5.4rem;
    height: 5.4rem;
  }

  .minds__seal :global(.emblem) {
    width: 3rem;
    height: 3rem;
  }

  .minds__voice-words {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    max-width: 52rem;
  }

  .minds__voice-words h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3.4vw, 2.5rem);
    line-height: 1.18;
    text-wrap: balance;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.9)) drop-shadow(0 0 22px oklch(0.84 0.16 86 / 0.3));
  }

  .minds__rule {
    width: min(18rem, 60%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gild-hi), transparent);
    box-shadow: 0 0 10px oklch(0.84 0.16 86 / 0.6);
  }

  .minds__voice-words p {
    margin: 0;
    color: var(--fg);
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .minds__stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.4rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .minds__stat {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    max-width: 100%;
    padding: 0.7rem 1.6rem 0.7rem 1.3rem;
    border: 2px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(180deg, oklch(0.24 0.08 298), oklch(0.16 0.06 294)) padding-box,
      linear-gradient(135deg, #fff1b8, var(--gild) 30%, var(--gild-lo) 55%, #f7dc8a 78%, var(--gild)) border-box;
    box-shadow:
      0 0 0 1px oklch(0.36 0.09 56 / 0.7),
      0 0 30px -8px oklch(0.84 0.16 86 / 0.5),
      inset 0 1px 0 oklch(1 0 0 / 0.12);
  }

  .minds__value {
    flex: none;
    font-family: var(--font-decorative);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.4vw, 2.5rem);
    line-height: 1;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.9));
  }

  .minds__label {
    min-width: 0;
    max-width: 17rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.86rem;
    line-height: 1.35;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gild-hi);
  }

  @keyframes minds-sweep {
    to {
      transform: translateX(70%);
    }
  }

  @media (min-width: 860px) {
    .minds__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .minds__item {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      padding: 2rem 1.4rem;
    }

    .minds__stat {
      border-radius: 18px;
      padding: 0.9rem 1.2rem;
    }
  }
</style>
