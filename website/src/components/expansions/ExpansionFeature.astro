---
import Frame from '../Frame.astro'
import Emblem, { type EmblemName } from '../Emblem.astro'
import { asset, page, type Locale } from '../../i18n'
import { coverOf, leadSentence, type Expansion } from '../../data/expansions'

interface Props {
  locale: Locale
  item: Expansion
  label: string
  emblem: EmblemName
  open: string
}

const { locale, item, label, emblem, open } = Astro.props
const square = item.cover === null
---

<Frame as="article" size="panel" gem class:list={['xfeature', { 'xfeature--square': square }]}>
  <a class="xfeature__link" href={page(locale, `expansions/${item.slug}`)}>
    <span class="xfeature__art">
      <img src={asset(coverOf(item))} alt="" width={square ? 1200 : 480} height={square ? 1200 : 720} decoding="async" />
      <span class="xfeature__shine" aria-hidden="true"></span>
    </span>
    <span class="xfeature__body">
      <span class="xfeature__label">
        <span class="medallion xfeature__medal" aria-hidden="true"><Emblem name={emblem} /></span>
        {label}
      </span>
      <span class="xfeature__name gilded">{item.name}</span>
      {item.motto && <span class="xfeature__motto">{item.motto}</span>}
      <span class="xfeature__intro">{leadSentence(item.intro)} {leadSentence(item.intro.slice(leadSentence(item.intro).length).trim())}</span>
      <span class="xfeature__open">{open}</span>
    </span>
  </a>
</Frame>

<style>
  .xfeature {
    padding: 1.6rem 1.5rem 2.2rem;
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.6s var(--ease);
  }

  .xfeature:hover {
    transform: translateY(-5px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 44px -6px oklch(0.84 0.16 86 / 0.5),
      0 30px 56px -28px oklch(0.05 0.04 290 / 0.95);
  }

  .xfeature__link {
    display: grid;
    gap: clamp(1.1rem, 2.5vw, 1.8rem);
    align-items: center;
    height: 100%;
    color: var(--fg);
    text-decoration: none;
  }

  .xfeature__link:focus-visible {
    outline: 2px solid var(--gild-hi);
    outline-offset: 6px;
    border-radius: 6px;
  }

  .xfeature__art {
    position: relative;
    display: block;
    justify-self: center;
    width: min(100%, 11rem);
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 6px;
    border: 3px solid transparent;
    background:
      linear-gradient(180deg, oklch(0.16 0.06 294), oklch(0.11 0.04 291)) padding-box,
      linear-gradient(135deg, #fff1b8, var(--gild) 22%, var(--gild-lo) 45%, #f7dc8a 62%, var(--gild) 80%, var(--gild-lo)) border-box;
    box-shadow:
      0 0 0 1px oklch(0.36 0.09 56),
      0 22px 40px -20px oklch(0.04 0.04 290 / 0.95);
  }

  .xfeature--square .xfeature__art {
    aspect-ratio: 1;
    width: min(100%, 14rem);
  }

  .xfeature__art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .xfeature:hover .xfeature__art img {
    transform: scale(1.05);
  }

  .xfeature__shine {
    position: absolute;
    inset: -20% -90%;
    background: linear-gradient(
      105deg,
      transparent 40%,
      oklch(1 0 0 / 0.07) 45%,
      oklch(0.98 0.07 92 / 0.45) 50%,
      oklch(1 0 0 / 0.07) 55%,
      transparent 60%
    );
    transform: translateX(-70%);
    pointer-events: none;
  }

  .xfeature:hover .xfeature__shine {
    animation: xfeature-shine 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .xfeature__body {
    display: grid;
    gap: 0.7rem;
    min-width: 0;
  }

  .xfeature__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gild);
  }

  .xfeature__medal {
    width: 2.6rem;
    height: 2.6rem;
  }

  .xfeature__medal :global(.emblem) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .xfeature__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    line-height: 1.1;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.9));
  }

  .xfeature__motto {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--gild-hi);
  }

  .xfeature__intro {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.9;
  }

  .xfeature__open {
    justify-self: start;
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gild-hi);
  }

  .xfeature__open::after {
    content: ' \2192';
  }

  @keyframes xfeature-shine {
    to {
      transform: translateX(70%);
    }
  }

  @media (min-width: 640px) {
    .xfeature {
      padding: clamp(1.1rem, 2vw, 1.6rem) clamp(1.1rem, 2vw, 1.6rem) clamp(1.4rem, 2.4vw, 1.9rem);
    }

    .xfeature__link {
      grid-template-columns: auto minmax(0, 1fr);
    }

    .xfeature__art {
      width: 11rem;
    }

    .xfeature--square .xfeature__art {
      width: 13rem;
    }
  }
</style>
