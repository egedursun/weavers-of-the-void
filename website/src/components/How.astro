---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import { asset, copyFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = copyFor(locale).how
const emblems: EmblemName[] = ['quill', 'crown', 'planet', 'scroll']
const pictures = ['you-create', 'gods-decide', 'world-lives', 'fate-remembers']
---

<section class="section how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <div class="head center">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="how-title" style="--delay: 0.08s">{copy.title}</h2>
      <span class="divider reveal" style="--delay: 0.12s" aria-hidden="true"></span>
    </div>
    <ol class="how__steps">
      {
        copy.steps.map((step, index) => (
          <Frame as="li" size="card" class="how__step reveal" style={`--delay: ${0.08 * index}s`}>
            <figure class="how__picture">
              <img
                src={asset(`art/steps/${pictures[index]}.webp`)}
                alt=""
                width="900"
                height="900"
                loading="lazy"
                decoding="async"
              />
              <span class="how__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            </figure>
            <span class="medallion how__medal">
              <Emblem name={emblems[index]} />
            </span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </Frame>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .how__steps {
    position: relative;
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how__step {
    display: flex;
    flex-direction: column;
    padding: 1.1rem 1.1rem 1.6rem;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .how__step:hover {
    transform: translateY(-6px);
  }

  .how__picture {
    position: relative;
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 3px;
    padding: 3px;
    background: linear-gradient(135deg, #fff1b8, var(--gild) 22%, var(--gild-lo) 45%, #f7dc8a 62%, var(--gild) 80%, var(--gild-lo));
    box-shadow:
      0 0 0 1px oklch(0.36 0.09 56),
      0 14px 28px -14px oklch(0.05 0.04 290 / 0.9);
  }

  .how__picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
    transform: scale(1.001);
    transition:
      transform 1.4s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.8s ease;
  }

  .how__picture::before {
    content: '';
    position: absolute;
    inset: 3px;
    z-index: 1;
    border-radius: 2px;
    box-shadow:
      inset 0 0 0 1px oklch(0.96 0.09 96 / 0.35),
      inset 0 0 40px 6px oklch(0.1 0.05 292 / 0.75);
    pointer-events: none;
  }

  .how__picture::after {
    content: '';
    position: absolute;
    inset: -30% -70%;
    z-index: 2;
    background: linear-gradient(
      105deg,
      transparent 40%,
      oklch(1 0 0 / 0.07) 45%,
      oklch(0.98 0.06 92 / 0.4) 50%,
      oklch(1 0 0 / 0.07) 55%,
      transparent 60%
    );
    transform: translateX(-75%);
    pointer-events: none;
  }

  .how__step:hover .how__picture img {
    transform: scale(1.07);
    filter: saturate(1.12) brightness(1.06);
  }

  .how__step:hover .how__picture::after {
    animation: how-sweep 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .how__number {
    position: absolute;
    top: 0.55rem;
    right: 0.75rem;
    z-index: 3;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1;
    background: linear-gradient(180deg, #fff6d6, var(--gild) 60%, var(--gild-lo));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 2px 4px oklch(0.05 0.04 290 / 0.95));
  }

  .how__medal {
    position: relative;
    z-index: 4;
    margin: -1.9rem 0 0.4rem 0.6rem;
  }

  .how__step h3 {
    margin: 0 0 0.5rem;
    padding-inline: 0.4rem;
    font-family: var(--font-display);
    font-size: 1.32rem;
    color: var(--gild-hi);
  }

  .how__step p {
    margin: 0;
    padding-inline: 0.4rem;
    color: var(--muted);
    font-size: 0.98rem;
  }

  @keyframes how-sweep {
    to {
      transform: translateX(75%);
    }
  }

  @media (min-width: 720px) {
    .how__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1080px) {
    .how__steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
