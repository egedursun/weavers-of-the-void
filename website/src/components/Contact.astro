---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import Icon from './Icon.astro'
import { FORM_ENDPOINT, copyFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = copyFor(locale).contact
const options = Object.entries(copy.options)
const stepEmblems: EmblemName[] = ['scroll', 'quill', 'planet']
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact__grid">
    <div class="contact__copy">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="contact-title" style="--delay: 0.08s">{copy.title}</h2>
      <p class="lead contact__lead reveal" style="--delay: 0.14s">{copy.lead}</p>
      <div class="contact__next reveal" style="--delay: 0.2s">
        <h3 class="contact__next-title">{copy.stepsTitle}</h3>
        <ol class="contact__steps">
          {
            copy.steps.map((step, index) => (
              <li class="contact__step">
                <span class="medallion contact__medal">
                  <Emblem name={stepEmblems[index] ?? 'scroll'} />
                  <span class="contact__number" aria-hidden="true">{index + 1}</span>
                </span>
                <div class="contact__step-words">
                  <h4>{step.title}</h4>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
      <p class="contact__privacy reveal" style="--delay: 0.26s">
        <span class="medallion contact__seal">
          <Emblem name="chest" />
        </span>
        <span>{copy.privacy}</span>
      </p>
    </div>

    <Frame
      as="form"
      size="panel"
      gem
      class="contact__form reveal"
      action={FORM_ENDPOINT}
      method="post"
      novalidate
      data-contact
      data-sending={copy.sending}
      data-send={copy.send}
      data-required={copy.required}
      data-invalid-email={copy.invalidEmail}
    >
      <input type="hidden" name="_subject" value="Weavers of the Void · service request" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="language" value={locale} />
      <input class="visually-hidden" type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <div class="field">
        <label for="contact-name">{copy.name}</label>
        <input id="contact-name" name="name" type="text" autocomplete="name" required maxlength="120" />
        <p class="field__error" data-error-for="contact-name"></p>
      </div>
      <div class="field">
        <label for="contact-email">{copy.email}</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="200" />
        <p class="field__error" data-error-for="contact-email"></p>
      </div>
      <div class="field">
        <label for="contact-company">{copy.company} <span>({copy.optional})</span></label>
        <input id="contact-company" name="company" type="text" autocomplete="organization" maxlength="160" />
      </div>
      <div class="field">
        <label for="contact-service">{copy.service}</label>
        <div class="select">
          <select id="contact-service" name="service" required data-service-select>
            <option value="" disabled selected>{copy.servicePlaceholder}</option>
            {options.map(([key, label]) => <option value={key}>{label}</option>)}
          </select>
          <Icon name="chevronDown" />
        </div>
        <p class="field__error" data-error-for="contact-service"></p>
      </div>
      <div class="field field--wide">
        <label for="contact-message">{copy.message}</label>
        <textarea id="contact-message" name="message" rows="5" required maxlength="5000"></textarea>
        <p class="field__error" data-error-for="contact-message"></p>
      </div>

      <div class="contact__submit field--wide">
        <button class="button button--gold button--block contact__send" type="submit" data-submit>
          <span data-submit-label>{copy.send}</span>
          <Icon name="arrowRight" />
        </button>
        <p class="contact__status" role="status" aria-live="polite" data-status data-sent={copy.sent} data-failed={copy.failed}></p>
      </div>
    </Frame>
  </div>
</section>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

  document.querySelectorAll<HTMLFormElement>('[data-contact]').forEach((form) => {
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')
    const label = form.querySelector<HTMLElement>('[data-submit-label]')
    const status = form.querySelector<HTMLElement>('[data-status]')
    const required = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[required]'))

    const problemOf = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      if (!field.value.trim()) return form.dataset.required ?? ''
      if (field.type === 'email' && !EMAIL.test(field.value.trim())) return form.dataset.invalidEmail ?? ''
      return ''
    }

    const show = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement, problem: string) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`)
      field.setAttribute('aria-invalid', problem ? 'true' : 'false')
      if (error) {
        error.textContent = problem
        error.id = `${field.id}-error`
        if (problem) field.setAttribute('aria-describedby', error.id)
        else field.removeAttribute('aria-describedby')
      }
    }

    required.forEach((field) => {
      field.addEventListener('blur', () => show(field, problemOf(field)))
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid') === 'true') show(field, problemOf(field))
      })
      field.addEventListener('change', () => {
        if (field.getAttribute('aria-invalid') === 'true') show(field, problemOf(field))
      })
    })

    form.addEventListener('submit', async (event) => {
      event.preventDefault()
      const problems = required.map((field) => {
        const problem = problemOf(field)
        show(field, problem)
        return problem ? field : null
      })
      const first = problems.find((field) => field !== null)
      if (first) {
        first.focus()
        return
      }
      if (!submit || !label || !status) return
      submit.disabled = true
      form.dataset.state = 'sending'
      label.textContent = form.dataset.sending ?? ''
      status.textContent = ''
      status.className = 'contact__status'
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        })
        if (!response.ok) throw new Error(String(response.status))
        form.reset()
        form.dataset.state = 'sent'
        status.textContent = status.dataset.sent ?? ''
        status.classList.add('is-sent')
      } catch {
        form.dataset.state = 'failed'
        status.textContent = status.dataset.failed ?? ''
        status.classList.add('is-failed')
      } finally {
        submit.disabled = false
        label.textContent = form.dataset.send ?? ''
      }
    })
  })
</script>

<style>
  .contact__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .contact__copy {
    min-width: 0;
  }

  .contact__lead {
    color: var(--fg);
    opacity: 0.9;
  }

  .contact__next {
    margin-top: 2.25rem;
  }

  .contact__next-title {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 0 0 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.86rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gild);
  }

  .contact__next-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--gild), transparent);
    opacity: 0.6;
  }

  .contact__steps {
    position: relative;
    display: grid;
    gap: 1.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact__steps::before {
    content: '';
    position: absolute;
    left: calc(var(--medal) / 2 - 1px);
    top: calc(var(--medal) / 2);
    bottom: calc(var(--medal) / 2);
    width: 2px;
    background: linear-gradient(180deg, var(--gild-lo), var(--gild-hi) 50%, var(--gild-lo));
    opacity: 0.5;
  }

  .contact__step {
    --medal: 3.4rem;
    display: grid;
    grid-template-columns: var(--medal) minmax(0, 1fr);
    gap: 1.1rem;
    align-items: center;
  }

  .contact__steps {
    --medal: 3.4rem;
  }

  .contact__medal {
    position: relative;
    width: var(--medal);
    height: var(--medal);
  }

  .contact__medal :global(.emblem) {
    width: 50%;
    height: 50%;
  }

  .contact__number {
    position: absolute;
    right: -0.3rem;
    bottom: -0.3rem;
    display: grid;
    place-items: center;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    background: linear-gradient(180deg, var(--gild-hi), var(--gild) 60%, var(--gild-lo));
    box-shadow:
      0 0 0 1px oklch(0.36 0.09 56),
      0 3px 8px oklch(0.05 0.04 290 / 0.8);
    color: oklch(0.18 0.06 290);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    line-height: 1;
  }

  .contact__step-words {
    min-width: 0;
  }

  .contact__step h4 {
    margin: 0 0 0.25rem;
    font-family: var(--font-display);
    font-size: 1.08rem;
    color: var(--gild-hi);
  }

  .contact__step p {
    margin: 0;
    color: var(--fg);
    opacity: 0.82;
    font-size: 0.97rem;
    line-height: 1.55;
  }

  .contact__privacy {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    margin: 2.25rem 0 0;
    padding: 0.55rem 1.2rem 0.55rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: oklch(0.17 0.055 293 / 0.75);
    color: var(--fg);
    font-size: 0.95rem;
  }

  .contact__seal {
    width: 2.3rem;
    height: 2.3rem;
    flex: none;
  }

  .contact__seal :global(.emblem) {
    width: 52%;
    height: 52%;
  }

  .contact__form {
    display: grid;
    gap: 1.25rem;
    min-width: 0;
    padding: clamp(3.1rem, 5vw, 3.4rem) clamp(1.6rem, 4.5vw, 3.2rem) clamp(3.1rem, 4.5vw, 3.2rem);
  }

  .field {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
  }

  .field label {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 0.84rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .field label span {
    color: var(--faint);
    font-family: var(--font-body, inherit);
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    white-space: nowrap;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.1rem;
    padding: 0.8rem 1rem;
    border: 1px solid oklch(0.82 0.12 86 / 0.42);
    border-radius: 6px;
    background: linear-gradient(180deg, oklch(0.1 0.035 290 / 0.95), oklch(0.13 0.045 292 / 0.9));
    box-shadow:
      inset 0 2px 6px oklch(0.03 0.03 290 / 0.8),
      inset 0 0 0 1px oklch(0.05 0.03 290 / 0.6),
      0 1px 0 oklch(1 0 0 / 0.05);
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .field input::placeholder,
  .field textarea::placeholder {
    color: var(--faint);
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: oklch(0.84 0.14 86 / 0.65);
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--gild-hi);
    box-shadow:
      inset 0 2px 6px oklch(0.03 0.03 290 / 0.8),
      0 0 0 3px oklch(0.84 0.16 86 / 0.28),
      0 0 22px -2px oklch(0.84 0.16 86 / 0.45);
  }

  .field [aria-invalid='true'] {
    border-color: var(--danger);
  }

  .field [aria-invalid='true']:focus {
    box-shadow:
      inset 0 2px 6px oklch(0.03 0.03 290 / 0.8),
      0 0 0 3px oklch(0.7 0.19 25 / 0.3);
  }

  .select {
    position: relative;
  }

  .select select {
    appearance: none;
    padding-right: 3.4rem;
    cursor: pointer;
  }

  .select select:invalid {
    color: var(--faint);
  }

  .select option {
    background: oklch(0.16 0.05 293);
    color: var(--fg);
  }

  .select::before {
    content: '';
    position: absolute;
    right: 2.7rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 1px;
    background: linear-gradient(180deg, transparent, oklch(0.84 0.14 86 / 0.55), transparent);
    pointer-events: none;
  }

  .select :global(svg) {
    position: absolute;
    right: 0.95rem;
    top: 50%;
    width: 1.05rem;
    height: 1.05rem;
    translate: 0 -50%;
    pointer-events: none;
    color: var(--gild-hi);
    transition: rotate 0.3s var(--ease);
  }

  .select:focus-within :global(svg) {
    rotate: 180deg;
  }

  .field__error {
    min-height: 0;
    margin: 0;
    color: var(--danger);
    font-size: 0.88rem;
  }

  .field__error:empty {
    display: none;
  }

  .contact__submit {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.5rem;
  }

  .contact__send {
    min-height: 3.4rem;
    font-size: 1.05rem;
    overflow: hidden;
  }

  .contact__send :global(svg) {
    transition: translate 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .contact__send:hover :global(svg) {
    translate: 0.3rem 0;
  }

  .contact__send::after {
    content: '';
    position: absolute;
    inset: -40% -60%;
    background: linear-gradient(105deg, transparent 42%, oklch(1 0 0 / 0.45) 50%, transparent 58%);
    transform: translateX(-70%);
    pointer-events: none;
  }

  .contact__send:hover::after {
    animation: contact-sweep 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .contact__form[data-state='sending'] .contact__send {
    cursor: progress;
    opacity: 0.85;
  }

  .contact__form[data-state='sending'] .contact__send::after {
    animation: contact-sweep 1.2s linear infinite;
  }

  .contact__status {
    margin: 0;
    padding: 0.85rem 1.1rem;
    border: 1px solid transparent;
    border-radius: 6px;
    font-size: 0.98rem;
    text-align: center;
  }

  .contact__status:empty {
    display: none;
  }

  .contact__status.is-sent {
    border-color: oklch(0.78 0.16 150 / 0.55);
    background: oklch(0.78 0.16 150 / 0.12);
    color: var(--success);
  }

  .contact__status.is-failed {
    border-color: oklch(0.7 0.19 25 / 0.55);
    background: oklch(0.7 0.19 25 / 0.12);
    color: var(--danger);
  }

  @keyframes contact-sweep {
    from {
      transform: translateX(-70%);
    }

    to {
      transform: translateX(70%);
    }
  }

  @media (min-width: 640px) {
    .contact__form {
      grid-template-columns: 1fr 1fr;
      row-gap: 0;
    }

    .field {
      grid-row: span 3;
      grid-template-rows: subgrid;
      row-gap: 0.5rem;
      align-content: stretch;
      align-items: end;
      padding-bottom: 1.25rem;
    }

    .field label {
      align-self: end;
    }

    .field input,
    .field select,
    .field textarea {
      align-self: start;
    }

    .field__error {
      align-self: start;
    }

    .field--wide {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1080px) {
    .contact__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__send::after {
      display: none;
    }
  }
</style>
