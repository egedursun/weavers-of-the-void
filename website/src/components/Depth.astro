---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import { copyFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = copyFor(locale).depth
---

<section class="section depth" id="depth" aria-labelledby="depth-title">
  <div class="wrap wrap--wide">
    <div class="depth__head">
      <div class="depth__intro">
        <p class="eyebrow reveal">{copy.eyebrow}</p>
        <h2 class="title reveal" id="depth-title" style="--delay: 0.08s">{copy.title}</h2>
        <p class="lead depth__lead reveal" style="--delay: 0.14s">{copy.lead}</p>
      </div>
      <dl class="depth__stats reveal" style="--delay: 0.18s">
        {
          copy.stats.map((stat) => (
            <div class="depth__stat">
              <dt class="depth__value gilded">{stat.value}</dt>
              <dd class="depth__label">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <Frame size="panel" gem class="depth__panel reveal">
      <ul class="depth__list">
        {
          copy.areas.map((area) => (
            <li class="depth__row">
              <span class="medallion depth__medal">
                <Emblem name={area.emblem as EmblemName} />
              </span>
              <span class="depth__words">
                <strong class="depth__name">{area.title}</strong>
                <span class="depth__text">{area.text}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </Frame>
  </div>
</section>

<style>
  .depth__head {
    display: grid;
    gap: 2rem;
    align-items: end;
    margin-bottom: clamp(2.25rem, 4vw, 3rem);
  }

  .depth__intro .eyebrow {
    margin-bottom: 0.8rem;
  }

  .depth__lead {
    max-width: 40rem;
    color: var(--fg);
    opacity: 0.88;
  }

  .depth__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 0;
  }

  .depth__stat {
    display: grid;
    gap: 0.35rem;
    min-width: 12rem;
    padding: 0.9rem 1.3rem 1rem;
    border-radius: 6px;
    background:
      linear-gradient(180deg, oklch(0.22 0.08 298), oklch(0.15 0.055 293)) padding-box,
      linear-gradient(135deg, #fff1b8, var(--gild) 30%, var(--gild-lo) 55%, #f7dc8a 78%, var(--gild)) border-box;
    border: 2px solid transparent;
    box-shadow:
      0 0 0 1px oklch(0.36 0.09 56 / 0.7),
      0 0 26px -10px oklch(0.84 0.16 86 / 0.5);
  }

  .depth__value {
    margin: 0;
    font-family: var(--font-decorative);
    font-weight: 700;
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    line-height: 1;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.9));
  }

  .depth__label {
    margin: 0;
    max-width: 13rem;
    color: var(--fg);
    opacity: 0.85;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .depth__panel {
    padding: clamp(1.75rem, 3.5vw, 2.75rem) clamp(1.25rem, 3vw, 2.5rem);
  }

  .depth__list {
    display: grid;
    gap: 0.4rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .depth__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.95rem;
    padding: 0.85rem 0.75rem;
    border-radius: 6px;
    transition:
      background-color 0.35s var(--ease),
      box-shadow 0.35s var(--ease);
  }

  .depth__row:hover {
    background: oklch(0.84 0.14 86 / 0.06);
    box-shadow: inset 0 0 0 1px oklch(0.84 0.14 86 / 0.25);
  }

  .depth__medal {
    width: 2.9rem;
    height: 2.9rem;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .depth__medal :global(.emblem) {
    width: 1.55rem;
    height: 1.55rem;
  }

  .depth__row:hover .depth__medal {
    transform: scale(1.1);
  }

  .depth__words {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .depth__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.02rem;
    letter-spacing: 0.02em;
    color: var(--gild-hi);
  }

  .depth__text {
    color: var(--fg);
    opacity: 0.85;
    font-size: 0.93rem;
    line-height: 1.45;
  }

  @media (min-width: 720px) {
    .depth__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .depth__head {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .depth__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
