---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import { copyFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = copyFor(locale).depth
---

<section class="section depth" id="depth" aria-labelledby="depth-title">
  <div class="wrap wrap--wide">
    <div class="head center">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="depth-title" style="--delay: 0.08s">{copy.title}</h2>
      <p class="lead depth__lead reveal" style="--delay: 0.14s">{copy.lead}</p>
    </div>
    <ul class="depth__grid">
      {
        copy.areas.map((area, index) => (
          <Frame as="li" size="tile" class="depth__tile reveal" style={`--delay: ${0.04 * (index % 4)}s`}>
            <span class="depth__shine" aria-hidden="true" />
            <span class="medallion depth__medal">
              <Emblem name={area.emblem as EmblemName} />
            </span>
            <h3 class="gilded">{area.title}</h3>
            <p>{area.text}</p>
          </Frame>
        ))
      }
    </ul>
    <div class="depth__stats">
      {
        copy.stats.map((stat, index) => (
          <div class="depth__stat reveal" style={`--delay: ${0.1 * index}s`}>
            <span class="depth__value gilded">{stat.value}</span>
            <span class="depth__rule" aria-hidden="true" />
            <span class="depth__label">{stat.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .depth::before {
    content: '';
    position: absolute;
    inset: 10% 0 auto;
    height: 60%;
    z-index: -1;
    background: radial-gradient(closest-side, oklch(0.55 0.22 300 / 0.16), transparent);
    filter: blur(30px);
    pointer-events: none;
  }

  .depth__lead {
    color: var(--fg);
    opacity: 0.9;
  }

  .depth__grid {
    display: grid;
    gap: 2.2rem 2rem;
    margin: 0;
    padding: 0.6rem 0 0;
    list-style: none;
  }

  .depth__tile {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.6rem 1.4rem 1.7rem;
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.6s var(--ease);
  }

  .depth__shine {
    position: absolute;
    inset: 3px;
    z-index: 1;
    overflow: hidden;
    border-radius: 2px;
    pointer-events: none;
  }

  .depth__shine::after {
    content: '';
    position: absolute;
    inset: -30% -80%;
    background: linear-gradient(
      105deg,
      transparent 40%,
      oklch(1 0 0 / 0.05) 45%,
      oklch(0.98 0.07 92 / 0.22) 50%,
      oklch(1 0 0 / 0.05) 55%,
      transparent 60%
    );
    transform: translateX(-70%);
  }

  .depth__tile:hover {
    transform: translateY(-5px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 34px -6px oklch(0.84 0.16 86 / 0.55),
      0 26px 48px -26px oklch(0.05 0.04 290 / 0.95);
  }

  .depth__tile:hover .depth__shine::after {
    animation: depth-sweep 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .depth__medal {
    width: 3.8rem;
    height: 3.8rem;
    margin-bottom: 0.3rem;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .depth__medal :global(.emblem) {
    width: 2.15rem;
    height: 2.15rem;
  }

  .depth__tile:hover .depth__medal {
    transform: scale(1.08);
  }

  .depth__tile h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.25;
    text-wrap: balance;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.85));
  }

  .depth__tile p {
    margin: 0;
    color: var(--fg);
    opacity: 0.86;
    font-size: 0.97rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .depth__stats {
    display: grid;
    gap: 2rem;
    justify-content: center;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  .depth__stat {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .depth__value {
    font-family: var(--font-decorative);
    font-weight: 700;
    font-size: clamp(2.8rem, 6vw, 4.2rem);
    line-height: 1;
    filter: drop-shadow(0 3px 0 oklch(0.25 0.07 56 / 0.9)) drop-shadow(0 0 26px oklch(0.84 0.16 86 / 0.35));
  }

  .depth__rule {
    width: 7rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gild-hi), transparent);
  }

  .depth__label {
    max-width: 18rem;
    color: var(--fg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.86rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  @keyframes depth-sweep {
    to {
      transform: translateX(70%);
    }
  }

  @media (min-width: 640px) {
    .depth__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .depth__stats {
      grid-template-columns: repeat(2, minmax(0, 20rem));
      gap: 3rem;
    }
  }

  @media (min-width: 960px) {
    .depth__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 1240px) {
    .depth__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
