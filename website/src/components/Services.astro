---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import star from '../assets/ornate/star.webp'
import { copyFor, page, type Locale } from '../i18n'

interface Props {
  locale: Locale
  compact?: boolean
}

const { locale, compact = false } = Astro.props
const copy = copyFor(locale).services
const packageEmblems: Record<string, EmblemName> = { standard: 'quill', professional: 'tome', enterprise: 'crown' }
const hourlyEmblems: Record<string, EmblemName> = { engineering: 'anvil', canon: 'scroll', consulting: 'book' }
---

<section class="section services" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="head center">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="services-title" style="--delay: 0.08s">{copy.title}</h2>
      <p class="lead services__lead reveal" style="--delay: 0.14s">{copy.lead}</p>
    </div>

    <div class="services__intro reveal">
      <h3 class="gilded">{copy.packagesTitle}</h3>
      <p>{copy.packagesLead}</p>
    </div>

    <ul class="packages">
      {
        copy.packages.map((item, index) => {
          const popular = item.key === 'professional'
          return (
            <Frame
              as="li"
              size="card"
              class:list={['package', 'reveal', { 'package--popular': popular }]}
              style={`--delay: ${0.08 * index}s`}
            >
              <span class="sweep" aria-hidden="true"></span>
              {popular && (
                <span class="plate package__plate">
                  <span class="plate__face">{copy.popular}</span>
                </span>
              )}
              <div class="package__head">
                <span class="medallion package__medal">
                  <Emblem name={packageEmblems[item.key] ?? 'quill'} />
                </span>
                <h4>{item.name}</h4>
              </div>
              <p class="price price--stack">
                <strong class="price__amount gilded">{item.price}</strong>
                <span class="price__unit">{copy.perProject}</span>
              </p>
              <p class="package__fit">{item.fit}</p>
              <ul class="points">
                {[item.review, item.delivery, item.revisions].map((point) => (
                  <li>
                    <img class="star-bullet" src={star.src} alt="" width="104" height="108" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
              <a class:list={['button', 'button--block', popular ? 'button--gold' : 'button--ghost']} href="#contact" data-service={item.key}>
                {copy.choose}
              </a>
            </Frame>
          )
        })
      }
    </ul>

    <div class="offers">
      <Frame as="article" size="card" class="offer offer--cloud reveal">
        <span class="sweep" aria-hidden="true"></span>
        <div class="offer__head">
          <span class="medallion offer__medal">
            <Emblem name="tower" />
          </span>
          <div class="offer__title">
            <h3>{copy.cloud.name}</h3>
            <p class="price">
              <strong class="price__amount price__amount--offer gilded">{copy.cloud.price}</strong>
              <span class="price__unit">{copy.cloud.period}</span>
            </p>
          </div>
        </div>
        <p class="offer__text">{copy.cloud.text}</p>
        <ul class="points">
          {
            copy.cloud.points.map((point) => (
              <li>
                <img class="star-bullet" src={star.src} alt="" width="104" height="108" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
        <a class="button button--gold offer__cta" href="#contact" data-service="cloud">
          {copy.cloud.cta}
        </a>
      </Frame>

      <Frame as="article" size="card" class="offer reveal" style="--delay: 0.08s">
        <span class="sweep" aria-hidden="true"></span>
        <div class="offer__head">
          <span class="medallion offer__medal">
            <Emblem name="crown" />
          </span>
          <div class="offer__title">
            <h3>{copy.enterprise.name}</h3>
            <p class="price">
              <strong class="price__amount price__amount--offer gilded">{copy.enterprise.price}</strong>
            </p>
          </div>
        </div>
        <p class="offer__text">{copy.enterprise.text}</p>
        <ul class="points">
          {
            copy.enterprise.points.map((point) => (
              <li>
                <img class="star-bullet" src={star.src} alt="" width="104" height="108" />
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
        <a class="button button--ghost offer__cta" href="#contact" data-service="deployment">
          {copy.enterprise.cta}
        </a>
      </Frame>
    </div>

    <h3 class="services__subtitle gilded reveal">{copy.hourlyTitle}</h3>
    <ul class="hourly">
      {
        copy.hourly.map((item, index) => (
          <Frame as="li" size="tile" class="hourly__item reveal" style={`--delay: ${0.08 * index}s`}>
            <span class="sweep" aria-hidden="true"></span>
            <span class="medallion hourly__medal">
              <Emblem name={hourlyEmblems[item.key] ?? 'book'} />
            </span>
            <h4>{item.name}</h4>
            <p class="price price--center">
              <strong class="price__amount price__amount--hour gilded">{item.price}</strong>
              <span class="price__unit">{copy.perHour}</span>
            </p>
            <p class="hourly__text">{item.text}</p>
            <a class="button button--ghost hourly__cta" href="#contact" data-service={item.key}>
              {copy.enterprise.cta}
            </a>
          </Frame>
        ))
      }
    </ul>

    <p class="services__notes reveal">{copy.notes}</p>
    {
      compact && (
        <div class="center reveal">
          <a class="button button--ghost" href={page(locale, 'services')}>
            {copy.details}
          </a>
        </div>
      )
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-service]').forEach((link) => {
    link.addEventListener('click', () => {
      const select = document.querySelector<HTMLSelectElement>('[data-service-select]')
      if (select && link.dataset.service) {
        select.value = link.dataset.service
        select.dispatchEvent(new Event('change'))
      }
    })
  })
</script>

<style>
  .services__lead {
    color: var(--fg);
    opacity: 0.88;
  }

  .services__intro {
    max-width: 52rem;
    margin: 0 auto 3.25rem;
    text-align: center;
  }

  .services__intro h3,
  .services__subtitle {
    margin: 0 0 0.7rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1.15;
    text-wrap: balance;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.9)) drop-shadow(0 0 18px oklch(0.84 0.16 86 / 0.25));
  }

  .services__intro p {
    margin: 0;
    color: var(--fg);
    opacity: 0.85;
    text-wrap: pretty;
  }

  .packages,
  .hourly {
    display: grid;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .package,
  .offer,
  .hourly__item {
    position: relative;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.55s var(--ease);
  }

  .sweep {
    position: absolute;
    inset: var(--edge);
    z-index: 1;
    overflow: hidden;
    border-radius: 2px;
    pointer-events: none;
  }

  .sweep::before {
    content: '';
    position: absolute;
    inset: -30% -80%;
    background: linear-gradient(
      105deg,
      transparent 42%,
      oklch(1 0 0 / 0.05) 46%,
      oklch(0.98 0.07 92 / 0.22) 50%,
      oklch(1 0 0 / 0.05) 54%,
      transparent 58%
    );
    transform: translateX(-70%);
  }

  .package:hover,
  .offer:hover,
  .hourly__item:hover {
    transform: translateY(-6px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 40px -6px oklch(0.84 0.16 86 / 0.5),
      0 28px 52px -26px oklch(0.05 0.04 290 / 0.95);
  }

  .package:hover .sweep::before,
  .offer:hover .sweep::before,
  .hourly__item:hover .sweep::before {
    animation: card-sweep 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .package {
    gap: 1.1rem;
    padding: 2.4rem 1.9rem 1.9rem;
  }

  .package--popular {
    --frame-hi: oklch(0.33 0.12 302);
    --frame-lo: oklch(0.2 0.08 296);
    --frame-glow: oklch(0.84 0.16 86 / 0.24);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 0 4px oklch(0.84 0.16 86 / 0.14),
      0 0 64px -10px oklch(0.84 0.16 86 / 0.6),
      0 30px 60px -30px oklch(0.05 0.04 290 / 0.95);
  }

  .package--popular:hover {
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 0 4px oklch(0.84 0.16 86 / 0.2),
      0 0 80px -8px oklch(0.84 0.16 86 / 0.75),
      0 30px 60px -30px oklch(0.05 0.04 290 / 0.95);
  }

  .plate {
    position: absolute;
    left: 50%;
    z-index: 4;
    display: block;
    padding: 2px;
    clip-path: polygon(1rem 0, calc(100% - 1rem) 0, 100% 50%, calc(100% - 1rem) 100%, 1rem 100%, 0 50%);
    background: linear-gradient(180deg, #fff1b8, var(--gild) 40%, var(--gild-lo) 75%, #f7dc8a);
    translate: -50% 0;
    filter: drop-shadow(0 6px 12px oklch(0.05 0.04 290 / 0.85));
  }

  .plate__face {
    display: block;
    padding: 0.5rem 1.8rem;
    clip-path: polygon(calc(1rem - 1px) 0, calc(100% - 1rem + 1px) 0, 100% 50%, calc(100% - 1rem + 1px) 100%, calc(1rem - 1px) 100%, 0 50%);
    background: linear-gradient(180deg, oklch(0.34 0.13 302), oklch(0.2 0.08 296));
    color: var(--gild-hi);
    font-family: var(--font-display);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    text-shadow: 0 1px 0 oklch(0.08 0.04 290 / 0.9);
  }

  .package__plate {
    top: 0;
    translate: -50% -50%;
  }

  .package__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .package__medal,
  .offer__medal,
  .hourly__medal {
    flex: none;
  }

  .package h4,
  .hourly__item h4 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--gild-hi);
  }

  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin: 0;
  }

  .price--center {
    justify-content: center;
  }

  .price--stack {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  .price__amount {
    font-family: var(--font-decorative);
    font-weight: 700;
    font-size: clamp(2.3rem, 3.6vw, 2.8rem);
    line-height: 1.05;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.9));
  }

  .price__amount--offer {
    font-size: clamp(1.55rem, 2.6vw, 2rem);
  }

  .price__amount--hour {
    font-size: 2.1rem;
  }

  .price__unit {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gild);
  }

  .package__fit {
    margin: 0;
    color: var(--fg);
    opacity: 0.85;
    text-wrap: pretty;
  }

  .points {
    display: grid;
    gap: 0.7rem;
    margin: 0.2rem 0 0.6rem;
    padding: 1.1rem 0 0;
    border-top: 1px solid var(--frame-rule);
    list-style: none;
  }

  .points li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: var(--fg);
    line-height: 1.45;
  }

  .points .star-bullet {
    margin-top: 0.12rem;
  }

  .package .button,
  .offer__cta,
  .hourly__cta {
    margin-top: auto;
  }

  .offers {
    display: grid;
    gap: 2.25rem;
    margin-top: 3rem;
  }

  .offer {
    align-items: stretch;
    gap: 1.1rem;
    padding: 2.1rem 1.9rem 1.9rem;
  }

  .offer--cloud {
    --frame-glow: oklch(0.6 0.23 302 / 0.3);
  }

  .offer__head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .offer__title {
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }

  .offer h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--gild-hi);
  }

  .offer__text {
    margin: 0;
    color: var(--fg);
    opacity: 0.85;
    text-wrap: pretty;
  }

  .offer__cta {
    align-self: flex-start;
  }

  .services__subtitle {
    margin-top: clamp(3.5rem, 7vw, 4.5rem);
    margin-bottom: 2rem;
    text-align: center;
  }

  .hourly__item {
    align-items: center;
    gap: 0.8rem;
    padding: 1.9rem 1.6rem 1.7rem;
    text-align: center;
  }

  .hourly__medal {
    margin-bottom: 0.2rem;
  }

  .hourly__item h4 {
    font-size: 1.25rem;
    text-wrap: balance;
  }

  .hourly__text {
    margin: 0;
    color: var(--fg);
    opacity: 0.82;
    font-size: 0.98rem;
    text-wrap: pretty;
  }

  .hourly__cta {
    min-height: 2.6rem;
    padding: 0.5rem 1.3rem;
    font-size: 0.88rem;
  }

  .services__notes {
    max-width: 50rem;
    margin: 3rem auto 1.75rem;
    color: var(--fg);
    opacity: 0.7;
    font-size: 0.94rem;
    text-align: center;
    text-wrap: balance;
  }

  @keyframes card-sweep {
    to {
      transform: translateX(70%);
    }
  }

  @media (min-width: 900px) {
    .packages,
    .hourly {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .packages {
      align-items: stretch;
    }

    .package--popular {
      margin-top: -1rem;
    }

    .offers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 899px) {
    .packages {
      gap: 2.75rem;
    }
  }

  @media (max-width: 520px) {
    .offer__head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.8rem;
    }
  }
</style>
