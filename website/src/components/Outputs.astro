---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import { copyFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = copyFor(locale).outputs
const emblems: EmblemName[] = ['book', 'tome', 'chest']
---

<section class="section outputs" aria-labelledby="outputs-title">
  <div class="wrap">
    <div class="head center">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="outputs-title" style="--delay: 0.08s">
        {copy.title} <span class="gilded outputs__accent">{copy.titleAccent}</span>
      </h2>
      <p class="lead outputs__lead reveal" style="--delay: 0.14s">{copy.lead}</p>
    </div>
    <ul class="outputs__grid">
      {
        copy.items.map((item, index) => (
          <Frame as="li" size="card" gem class="outputs__item reveal" style={`--delay: ${0.08 * index}s`}>
            <span class="outputs__shine" aria-hidden="true" />
            <span class="medallion outputs__medal">
              <Emblem name={emblems[index]} />
            </span>
            <h3 class="gilded">{item.title}</h3>
            <span class="outputs__format">{item.format}</span>
            <p>{item.text}</p>
          </Frame>
        ))
      }
    </ul>
    <div class="seal reveal">
      <span class="seal__line" aria-hidden="true"></span>
      <Frame size="panel" gem class="seal__plate">
        <span class="medallion seal__medal" aria-hidden="true">
          <Emblem name="key" />
        </span>
        <div class="seal__words">
          <p class="seal__text gilded">{copy.rights}</p>
          <span class="seal__rule" aria-hidden="true"></span>
          <p class="seal__note">{copy.rightsNote}</p>
        </div>
        <span class="medallion seal__medal seal__medal--mirror" aria-hidden="true">
          <Emblem name="key" />
        </span>
      </Frame>
      <span class="seal__line" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .outputs__accent {
    display: inline-block;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.9)) drop-shadow(0 0 20px oklch(0.84 0.16 86 / 0.3));
  }

  .outputs__lead {
    color: var(--fg);
    opacity: 0.9;
  }

  .outputs__grid {
    display: grid;
    gap: 2.5rem 2rem;
    margin: 0;
    padding: 1rem 0 0;
    list-style: none;
  }

  .outputs__item {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.85rem;
    padding: 2.6rem 1.9rem 2.2rem;
    text-align: center;
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.6s var(--ease);
  }

  .outputs__shine {
    position: absolute;
    inset: 4px;
    z-index: 1;
    overflow: hidden;
    border-radius: 2px;
    pointer-events: none;
  }

  .outputs__shine::after {
    content: '';
    position: absolute;
    inset: -30% -80%;
    background: linear-gradient(
      105deg,
      transparent 40%,
      oklch(1 0 0 / 0.05) 45%,
      oklch(0.98 0.07 92 / 0.22) 50%,
      oklch(1 0 0 / 0.05) 55%,
      transparent 60%
    );
    transform: translateX(-70%);
    pointer-events: none;
  }

  .outputs__item:hover {
    transform: translateY(-6px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 40px -6px oklch(0.84 0.16 86 / 0.55),
      0 30px 56px -28px oklch(0.05 0.04 290 / 0.95);
  }

  .outputs__item:hover .outputs__shine::after {
    animation: outputs-sweep 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .outputs__medal {
    width: 5rem;
    height: 5rem;
    margin-bottom: 0.4rem;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .outputs__medal :global(.emblem) {
    width: 2.8rem;
    height: 2.8rem;
  }

  .outputs__item:hover .outputs__medal {
    transform: scale(1.08);
  }

  .outputs__item h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.35rem, 2vw, 1.55rem);
    line-height: 1.2;
    text-wrap: balance;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.85));
  }

  .outputs__format {
    display: inline-flex;
    align-items: center;
    padding: 0.38rem 1rem;
    border: 1.5px solid transparent;
    border-radius: 999px;
    background:
      linear-gradient(180deg, oklch(0.26 0.09 298), oklch(0.17 0.06 294)) padding-box,
      linear-gradient(135deg, #fff1b8, var(--gild) 30%, var(--gild-lo) 55%, #f7dc8a 78%, var(--gild)) border-box;
    box-shadow:
      0 0 0 1px oklch(0.36 0.09 56 / 0.6),
      0 0 18px -6px oklch(0.84 0.16 86 / 0.5);
    color: var(--gild-hi);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .outputs__item p {
    max-width: 22rem;
    margin: 0.2rem 0 0;
    color: var(--fg);
    opacity: 0.86;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .seal {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(0, auto) 1fr;
    align-items: center;
    gap: 1.25rem;
    margin-top: clamp(3.5rem, 7vw, 5rem);
  }

  .seal::before {
    content: '';
    position: absolute;
    inset: -20% 15%;
    z-index: -1;
    background: radial-gradient(closest-side, oklch(0.84 0.16 86 / 0.16), oklch(0.55 0.22 300 / 0.14) 55%, transparent);
    filter: blur(24px);
    pointer-events: none;
  }

  .seal__line {
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gild-lo) 40%, var(--gild-hi));
    box-shadow: 0 0 10px oklch(0.84 0.16 86 / 0.45);
  }

  .seal__line:last-child {
    background: linear-gradient(90deg, var(--gild-hi), var(--gild-lo) 60%, transparent);
  }

  .seal__plate {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    max-width: 56rem;
    padding: clamp(2.2rem, 4vw, 2.8rem) clamp(1.75rem, 4vw, 3rem);
    background:
      radial-gradient(34rem 12rem at 50% 0%, oklch(0.84 0.16 86 / 0.2), transparent 70%),
      radial-gradient(30rem 14rem at 50% 100%, oklch(0.6 0.23 302 / 0.22), transparent 70%),
      linear-gradient(180deg, var(--frame-hi), var(--frame-lo));
  }

  .seal__medal {
    width: 5rem;
    height: 5rem;
  }

  .seal__medal :global(.emblem) {
    width: 2.9rem;
    height: 2.9rem;
  }

  .seal__medal--mirror :global(.emblem) {
    transform: scaleX(-1);
  }

  .seal__words {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    min-width: 0;
    text-align: center;
  }

  .seal__text {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.1vw, 2.4rem);
    letter-spacing: 0.01em;
    line-height: 1.2;
    text-wrap: balance;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.9)) drop-shadow(0 0 22px oklch(0.84 0.16 86 / 0.35));
  }

  .seal__rule {
    width: min(18rem, 70%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gild-hi), transparent);
  }

  .seal__note {
    margin: 0;
    color: var(--fg);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(0.82rem, 1.3vw, 0.98rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  @keyframes outputs-sweep {
    to {
      transform: translateX(70%);
    }
  }

  @media (max-width: 720px) {
    .seal {
      grid-template-columns: 1fr;
    }

    .seal__line {
      display: none;
    }

    .seal__plate {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .seal__medal--mirror {
      display: none;
    }
  }

  @media (min-width: 860px) {
    .outputs__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
