---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import { copyFor, type Locale } from '../i18n'

type FaqCopy = { eyebrow: string; title: string; items: { q: string; a: string }[] }

interface Props {
  locale: Locale
  content?: FaqCopy
}

const { locale, content } = Astro.props
const copy: FaqCopy = content ?? copyFor(locale).faq
const emblems: EmblemName[] = ['network', 'chest', 'orb', 'key', 'tome', 'tower']
---

<section class="section section--tight faq" aria-labelledby="faq-title">
  <div class="wrap faq__wrap">
    <div class="head center">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="faq-title" style="--delay: 0.08s">{copy.title}</h2>
      <span class="divider reveal" style="--delay: 0.12s" aria-hidden="true"></span>
    </div>
    <div class="faq__list">
      {
        copy.items.map((item, index) => (
          <Frame size="tile" class="faq__item reveal" style={`--delay: ${0.05 * index}s`}>
            <details class="faq__details" open={index === 0}>
            <summary class="faq__question">
              <span class="medallion faq__medal">
                <Emblem name={emblems[index % emblems.length]} />
              </span>
              <span class="faq__text">{item.q}</span>
              <svg class="faq__toggle" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
                <circle class="faq__ring" cx="16" cy="16" r="13.5" />
                <circle class="faq__dots" cx="16" cy="16" r="10.5" />
                <rect class="faq__bar" x="9.5" y="14.6" width="13" height="2.8" rx="1.4" />
                <rect class="faq__bar faq__bar--cross" x="14.6" y="9.5" width="2.8" height="13" rx="1.4" />
              </svg>
            </summary>
            <div class="faq__answer">
              <p>{item.a}</p>
            </div>
            </details>
          </Frame>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    interpolate-size: allow-keywords;
  }

  .faq__wrap {
    max-width: 54rem;
  }

  .faq__list {
    display: grid;
    gap: 1.7rem;
  }

  .faq__item {
    padding: 0;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.55s var(--ease);
  }

  .faq__item:hover {
    transform: translateY(-3px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 30px -6px oklch(0.84 0.16 86 / 0.45),
      0 22px 40px -22px oklch(0.05 0.04 290 / 0.95);
  }

  .faq__item:has(.faq__details[open]) {
    --frame-hi: oklch(0.3 0.11 301);
    --frame-glow: oklch(0.84 0.16 86 / 0.2);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 34px -6px oklch(0.84 0.16 86 / 0.5),
      0 24px 44px -22px oklch(0.05 0.04 290 / 0.95);
  }

  .faq__details::details-content {
    block-size: 0;
    overflow: clip;
    transition:
      block-size 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      content-visibility 0.5s allow-discrete;
  }

  .faq__details[open]::details-content {
    block-size: auto;
  }

  .faq__question {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem 1.6rem 1.15rem 1.75rem;
    cursor: pointer;
    list-style: none;
    border-radius: 4px;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:focus-visible {
    outline: 2px solid var(--gild);
    outline-offset: -6px;
  }

  .faq__medal {
    width: 3.1rem;
    height: 3.1rem;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .faq__medal :global(.emblem) {
    width: 1.75rem;
    height: 1.75rem;
  }

  .faq__item:hover .faq__medal,
  .faq__details[open] .faq__medal {
    transform: scale(1.06) rotate(-4deg);
  }

  .faq__text {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.22rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--fg);
    text-wrap: balance;
    text-shadow: 0 1px 0 oklch(0.08 0.04 290 / 0.9);
    transition: color 0.3s var(--ease);
  }

  .faq__item:hover .faq__text,
  .faq__details[open] .faq__text {
    color: var(--gild-hi);
  }

  .faq__toggle {
    width: 2.1rem;
    height: 2.1rem;
    flex: none;
    filter: drop-shadow(0 1px 0 oklch(0.28 0.08 56)) drop-shadow(0 2px 6px oklch(0.05 0.04 290 / 0.6));
    transition:
      rotate 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.4s var(--ease);
  }

  .faq__ring {
    fill: oklch(0.2 0.08 296);
    stroke: url(#wov-gold);
    stroke-width: 2.2;
  }

  .faq__dots {
    fill: none;
    stroke: oklch(0.84 0.14 86 / 0.45);
    stroke-width: 0.9;
    stroke-dasharray: 0.6 2.2;
    stroke-linecap: round;
  }

  .faq__bar {
    fill: url(#wov-gold);
    transform-origin: 16px 16px;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .faq__item:hover .faq__toggle {
    filter: drop-shadow(0 1px 0 oklch(0.28 0.08 56)) drop-shadow(0 0 8px oklch(0.84 0.16 86 / 0.6));
  }

  .faq__details[open] .faq__toggle {
    rotate: 180deg;
    filter: drop-shadow(0 1px 0 oklch(0.28 0.08 56)) drop-shadow(0 0 10px oklch(0.84 0.16 86 / 0.7));
  }

  .faq__details[open] .faq__bar--cross {
    transform: scaleY(0);
  }

  .faq__answer {
    padding: 0 1.75rem 1.6rem calc(1.75rem + 3.1rem + 1.1rem);
  }

  .faq__answer p {
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid oklch(0.84 0.14 86 / 0.22);
    color: var(--fg);
    opacity: 0.86;
    font-size: 1.02rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  @media (max-width: 640px) {
    .faq__question {
      gap: 0.85rem;
      padding: 1rem 1.15rem 1rem 1.3rem;
    }

    .faq__medal {
      width: 2.6rem;
      height: 2.6rem;
    }

    .faq__medal :global(.emblem) {
      width: 1.45rem;
      height: 1.45rem;
    }

    .faq__toggle {
      width: 1.8rem;
      height: 1.8rem;
    }

    .faq__text {
      font-size: 1rem;
    }

    .faq__answer {
      padding: 0 1.3rem 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__details::details-content,
    .faq__toggle,
    .faq__bar {
      transition: none;
    }
  }
</style>
