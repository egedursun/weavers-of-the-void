const VIEW: Record<keyof typeof ART, string> = {
  chest: '5.20 6.25 53.60 53.60',
  quill: '-1.30 3.30 60.50 60.50',
  book: '1.30 4.30 61.40 61.40',
  orb: '4.85 6.40 54.30 54.30',
  crown: '-0.20 -2.15 64.40 64.40',
  planet: '1.20 3.20 61.60 61.60',
  scroll: '5.30 5.30 55.40 55.40',
  tome: '5.25 7.20 53.50 53.50',
  key: '5.55 1.80 59.20 59.20',
  tower: '2.80 2.30 58.40 58.40',
  anvil: '3.30 7.30 57.40 57.40',
  map: '3.20 3.20 57.60 57.60',
  network: '3.70 2.20 56.60 56.60',
}

export type EmblemName = keyof typeof ART

interface Props {
  name: EmblemName
  class?: string
}

const { name, class: className } = Astro.props
---

<svg class:list={['emblem', className]} viewBox={VIEW[name]} data-emblem={name} aria-hidden="true" focusable="false" set:html={ART[name]} />

<style is:global>
  .emblem {
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    overflow: visible;
    filter: drop-shadow(0 1px 0 oklch(0.28 0.08 56)) drop-shadow(0 2px 6px oklch(0.05 0.04 290 / 0.6));
  }

  .emblem .g {
    fill: url(#wov-gold);
    stroke: #6b4812;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .emblem .m {
    fill: url(#wov-gold-deep);
    stroke: #5a3b0c;
    stroke-width: 1.2;
    stroke-linejoin: round;
  }

  .emblem .p {
    fill: url(#wov-parchment);
    stroke: #6b4812;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .emblem .d {
    fill: none;
    stroke: #7a5418;
    stroke-width: 1.6;
    stroke-linecap: round;
    opacity: 0.75;
  }

  .emblem .gem {
    fill: url(#wov-gem);
    stroke: #f6d98a;
    stroke-width: 1.2;
  }

  .emblem .hi {
    fill: none;
    stroke: oklch(1 0 0 / 0.75);
    stroke-width: 2.2;
    stroke-linecap: round;
  }

  .emblem .ring {
    fill: none;
    stroke: url(#wov-gold);
    stroke-width: 3.2;
    stroke-linecap: round;
  }

  .emblem .spark {
    fill: #fff6d2;
  }
</style>
