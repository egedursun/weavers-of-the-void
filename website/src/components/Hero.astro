---
import crest from '../assets/ornate/crest.webp'
import star from '../assets/ornate/star.webp'
import Icon from './Icon.astro'
import { REPOSITORY, asset, copyFor, page, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = copyFor(locale).hero
const hand = [
  { number: 36, turn: -48 },
  { number: 18, turn: -32 },
  { number: 61, turn: -16 },
  { number: 74, turn: 0 },
  { number: 52, turn: 16 },
  { number: 67, turn: 32 },
  { number: 86, turn: 48 },
]
const sparks = Array.from({ length: 14 }, (_, index) => ({
  left: 8 + ((index * 53) % 84),
  delay: (index * 0.9) % 7,
  duration: 6 + (index % 5),
  size: 2 + (index % 3),
}))
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__backdrop" aria-hidden="true">
    <span class="hero__nebula hero__nebula--violet"></span>
    <span class="hero__nebula hero__nebula--gold"></span>
    <span class="hero__nebula hero__nebula--teal"></span>
  </div>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="eyebrow rise">{copy.eyebrow}</p>
      <h1 class="hero__title rise" id="hero-title" style="--delay: 0.08s">
        {copy.title} <span class="hero__accent">{copy.titleAccent}</span>
      </h1>
      <p class="lead rise" style="--delay: 0.16s">{copy.lead}</p>
      <div class="hero__actions rise" style="--delay: 0.24s">
        <a class="button button--gold" href={REPOSITORY} target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
          {copy.primary}
        </a>
        <a class="button button--ghost" href={page(locale, 'services')}>
          <Icon name="sparkles" />
          {copy.secondary}
        </a>
      </div>
      <ul class="hero__proof rise" style="--delay: 0.32s">
        {
          copy.proof.map((item) => (
            <li>
              <img class="star-bullet" src={star.src} alt="" width="104" height="108" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="stage rise" style="--delay: 0.12s" role="img" aria-label={copy.boxAlt}>
      <span class="stage__aura" aria-hidden="true"></span>
      <span class="stage__rays" aria-hidden="true"></span>
      <svg class="stage__ring" viewBox="0 0 600 600" aria-hidden="true">
        <defs>
          <path id={`ring-${locale}`} d="M300,300 m-251,0 a251,251 0 1,1 502,0 a251,251 0 1,1 -502,0" />
          <linearGradient id={`ring-gold-${locale}`} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#fff4c4" />
            <stop offset="0.22" stop-color="#e9bd52" />
            <stop offset="0.45" stop-color="#9b6a1c" />
            <stop offset="0.62" stop-color="#f7dc8a" />
            <stop offset="0.8" stop-color="#c58f2c" />
            <stop offset="1" stop-color="#7c5413" />
          </linearGradient>
        </defs>
        <g class="stage__gold">
          <circle cx="300" cy="300" r="285" stroke-width="17" stroke={`url(#ring-gold-${locale})`} />
          <circle cx="300" cy="300" r="293.5" class="stage__rim" />
          <circle cx="300" cy="300" r="276.5" class="stage__rim" />
          <circle cx="300" cy="300" r="290.6" class="stage__beads" />
          <circle cx="300" cy="300" r="279.4" class="stage__beads" />
          <circle cx="300" cy="300" r="285" class="stage__engrave" />
          <circle cx="300" cy="300" r="285" class="stage__engrave stage__engrave--light" />
          <circle cx="300" cy="300" r="226" stroke-width="7" stroke={`url(#ring-gold-${locale})`} />
          <circle cx="300" cy="300" r="230" class="stage__rim stage__rim--thin" />
          <circle cx="300" cy="300" r="222" class="stage__rim stage__rim--thin" />
          <circle cx="300" cy="300" r="226" class="stage__beads stage__beads--small" />
        </g>
        <circle cx="300" cy="300" r="212" class="stage__ring-line stage__ring-line--thin" />
        <g class="stage__ring-words">
          <text>
            <textPath href={`#ring-${locale}`} startOffset="0" textLength="1500" lengthAdjust="spacing" fill={`url(#ring-gold-${locale})`}>{copy.ring}</textPath>
          </text>
        </g>
      </svg>
      <div class="stage__hand" aria-hidden="true">
        {
          hand.map((card, index) => (
            <span class="stage__card" style={`--turn: ${card.turn}deg; --order: ${index}`}>
              <img src={asset(`covers/${card.number}.webp`)} alt="" width="480" height="720" decoding="async" />
            </span>
          ))
        }
      </div>
      <div class="stage__jewels" aria-hidden="true">
        {[0, 90, 180, 270].map((angle) => (
          <span class="stage__slot" style={`--angle: ${angle}deg`}>
            <img class="stage__wings" src={crest.src} alt="" width="480" height="97" />
          </span>
        ))}
        {[45, 135, 225, 315].map((angle) => (
          <span class="stage__slot" style={`--angle: ${angle}deg`}>
            <img class="stage__star" src={star.src} alt="" width="104" height="108" />
          </span>
        ))}
      </div>
      <img class="stage__crest" src={asset('brand/logo-1024.webp')} alt="" width="1024" height="1024" fetchpriority="high" />
      <div class="stage__sparks" aria-hidden="true">
        {
          sparks.map((spark) => (
            <span
              style={`--left: ${spark.left}%; --delay: ${spark.delay}s; --duration: ${spark.duration}s; --size: ${spark.size}px`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(3.5rem, 7vw, 5.5rem);
    isolation: isolate;
  }

  .hero__backdrop {
    position: absolute;
    inset: -80px 0 -160px;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(180deg, #000 0%, #000 60%, transparent 100%);
  }

  .hero__nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.75;
    animation: drift 24s ease-in-out infinite alternate;
  }

  .hero__nebula--violet {
    width: 52rem;
    height: 40rem;
    right: -12rem;
    top: -6rem;
    background: radial-gradient(closest-side, oklch(0.5 0.24 302 / 0.55), transparent);
  }

  .hero__nebula--gold {
    width: 30rem;
    height: 26rem;
    right: 12%;
    top: 30%;
    background: radial-gradient(closest-side, oklch(0.78 0.15 80 / 0.28), transparent);
    animation-duration: 30s;
  }

  .hero__nebula--teal {
    width: 34rem;
    height: 28rem;
    left: -14rem;
    top: 18%;
    background: radial-gradient(closest-side, oklch(0.5 0.13 220 / 0.3), transparent);
    animation-duration: 36s;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.25rem, 4.5vw, 3.7rem);
    line-height: 1.08;
    letter-spacing: 0.005em;
    text-wrap: balance;
    text-shadow: 0 2px 30px oklch(0.1 0.04 290 / 0.8);
  }

  .hero__accent {
    display: block;
    margin-top: 0.08em;
    font-family: var(--font-decorative);
    background: linear-gradient(
      100deg,
      var(--gild-lo) 0%,
      var(--gild) 25%,
      var(--gild-hi) 45%,
      #fffbe8 50%,
      var(--gild-hi) 55%,
      var(--gild) 75%,
      var(--gild-lo) 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: none;
    filter: drop-shadow(0 0 26px oklch(0.84 0.16 86 / 0.32));
    animation: shine 7s ease-in-out infinite;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .hero__proof {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 0.6rem 2rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .hero__proof li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .stage__aura {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, oklch(0.84 0.16 86 / 0.42), transparent 55%),
      radial-gradient(closest-side, oklch(0.55 0.25 302 / 0.65), transparent 90%);
    filter: blur(18px);
    animation: breathe 8s ease-in-out infinite;
  }

  .stage__rays {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    background: repeating-conic-gradient(
      from 0deg,
      oklch(0.96 0.09 96 / 0.16) 0deg 3deg,
      transparent 3deg 18deg
    );
    mask-image: radial-gradient(closest-side, #000 18%, transparent 72%);
    animation: spin 90s linear infinite;
  }

  .stage__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .stage__ring-line {
    fill: none;
    stroke: oklch(0.84 0.16 86 / 0.4);
    stroke-width: 1.2;
  }

  .stage__gold circle {
    fill: none;
  }

  .stage__gold {
    filter: drop-shadow(0 6px 12px oklch(0.05 0.04 290 / 0.75));
  }

  .stage__rim {
    stroke: oklch(0.36 0.09 56);
    stroke-width: 1.4;
  }

  .stage__rim--thin {
    stroke-width: 1;
  }

  .stage__beads {
    stroke: #fff2bf;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 0 5.6;
    opacity: 0.95;
  }

  .stage__beads--small {
    stroke-width: 1.8;
    stroke-dasharray: 0 4.4;
  }

  .stage__engrave {
    stroke: oklch(0.42 0.1 56);
    stroke-width: 3.2;
    stroke-dasharray: 10 4 2 4;
    opacity: 0.85;
  }

  .stage__engrave--light {
    stroke: #fff6d0;
    stroke-width: 1;
    stroke-dashoffset: -1.5;
    opacity: 0.55;
  }

  .stage__jewels {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  .stage__slot {
    position: absolute;
    inset: 0;
    transform: rotate(var(--angle));
  }

  .stage__wings {
    position: absolute;
    left: 50%;
    top: 2.5%;
    width: 30%;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 4px 8px oklch(0.05 0.04 290 / 0.85)) drop-shadow(0 0 12px oklch(0.7 0.19 312 / 0.45));
  }

  .stage__star {
    position: absolute;
    left: 50%;
    top: 2.5%;
    width: 8.5%;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 3px 6px oklch(0.05 0.04 290 / 0.85)) drop-shadow(0 0 10px oklch(0.84 0.16 86 / 0.5));
  }

  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }

  .stage__aura {
    position: absolute;
    inset: 6%;
    border-radius: 50%;
    background:
      radial-gradient(closest-side, oklch(0.84 0.16 86 / 0.42), transparent 55%),
      radial-gradient(closest-side, oklch(0.55 0.25 302 / 0.65), transparent 90%);
    filter: blur(18px);
    animation: breathe 8s ease-in-out infinite;
  }

  .stage__rays {
    position: absolute;
    inset: -6%;
    border-radius: 50%;
    background: repeating-conic-gradient(
      from 0deg,
      oklch(0.96 0.09 96 / 0.16) 0deg 3deg,
      transparent 3deg 18deg
    );
    mask-image: radial-gradient(closest-side, #000 18%, transparent 72%);
    animation: spin 90s linear infinite;
  }

  .stage__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .stage__ring-line {
    fill: none;
    stroke: oklch(0.84 0.16 86 / 0.4);
    stroke-width: 1.2;
  }

  .stage__ring-line--thin {
    stroke: oklch(0.6 0.23 302 / 0.5);
    stroke-dasharray: 2 9;
    stroke-width: 2;
  }

  .stage__ring-words {
    transform-origin: 300px 300px;
    animation: spin 120s linear infinite;
  }

  .stage__ring-words text {
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .stage__hand {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .stage__crest {
    z-index: 2;
    pointer-events: none;
  }

  .stage__card {
    position: absolute;
    left: 50%;
    top: 63%;
    width: 27%;
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid oklch(0.88 0.13 92 / 0.65);
    box-shadow:
      0 18px 36px -14px oklch(0.05 0.04 290 / 0.95),
      0 0 22px -8px oklch(0.84 0.16 86 / 0.55);
    transform-origin: 50% 100%;
    transform: translate(-50%, -100%) rotate(var(--turn)) translateY(-6%) scale(1);
    filter: brightness(0.92) saturate(1.02);
    transition:
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.6s ease,
      box-shadow 0.6s ease,
      border-color 0.6s ease;
    transition-delay: calc(var(--order) * 0.03s);
    animation: deal 1s var(--ease) backwards;
    animation-delay: calc(0.25s + var(--order) * 0.07s);
  }

  .stage__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stage__card::after {
    content: '';
    position: absolute;
    inset: -20% -60%;
    background: linear-gradient(
      105deg,
      transparent 38%,
      oklch(1 0 0 / 0.08) 44%,
      oklch(0.98 0.06 92 / 0.55) 50%,
      oklch(1 0 0 / 0.08) 56%,
      transparent 62%
    );
    transform: translateX(-70%);
    pointer-events: none;
  }

  .stage .stage__card:hover::after {
    animation: sweep 1.1s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .stage:hover .stage__card {
    transform: translate(-50%, -100%) rotate(calc(var(--turn) * 1.12)) translateY(-11%) scale(1);
    filter: brightness(1) saturate(1.05);
  }

  .stage .stage__card:hover {
    z-index: 3;
    transform: translate(-50%, -100%) rotate(calc(var(--turn) * 1.12)) translateY(-22%) scale(1.1);
    filter: brightness(1.12) saturate(1.12);
    border-color: var(--gild-hi);
    box-shadow:
      0 28px 50px -16px oklch(0.05 0.04 290 / 0.95),
      0 0 36px -4px oklch(0.84 0.16 86 / 0.8),
      0 0 0 1px oklch(0.96 0.09 96 / 0.6);
    transition-delay: 0s;
  }

  .stage__crest {
    position: absolute;
    left: 50%;
    top: 61%;
    width: 38%;
    translate: -50% -50%;
    filter:
      drop-shadow(0 0 30px oklch(0.6 0.23 302 / 0.85))
      drop-shadow(0 18px 30px oklch(0.05 0.04 290 / 0.9));
    animation: hover 7s ease-in-out infinite;
  }

  .stage__sparks span {
    position: absolute;
    bottom: 12%;
    left: var(--left);
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    background: var(--gild-hi);
    box-shadow: 0 0 10px 2px oklch(0.84 0.16 86 / 0.8);
    opacity: 0;
    animation: rise-spark var(--duration) linear var(--delay) infinite;
  }

  .rise {
    animation: rise 0.9s var(--ease) both;
    animation-delay: var(--delay, 0s);
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 18px;
    }
  }

  @keyframes sweep {
    to {
      transform: translateX(70%);
    }
  }

  @keyframes deal {
    from {
      opacity: 0;
      transform: translate(-50%, -100%) rotate(0deg) translateY(10%);
    }
  }

  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }

  @keyframes hover {
    50% {
      translate: -50% calc(-50% - 10px);
    }
  }

  @keyframes breathe {
    50% {
      opacity: 0.7;
      scale: 1.06;
    }
  }

  @keyframes shine {
    0%,
    100% {
      background-position: 100% 0;
    }
    50% {
      background-position: 0% 0;
    }
  }

  @keyframes drift {
    to {
      translate: -3rem 2rem;
    }
  }

  @keyframes rise-spark {
    0% {
      opacity: 0;
      translate: 0 0;
    }
    15% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      translate: 0 -320px;
    }
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  @media (max-width: 520px) {
    .hero__proof {
      grid-template-columns: max-content;
    }
  }
</style>
