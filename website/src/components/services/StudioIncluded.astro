---
import Emblem, { type EmblemName } from '../Emblem.astro'
import Frame from '../Frame.astro'
import Icon from '../Icon.astro'
import type { Locale } from '../../i18n'
import { studioCopy } from '../../i18n/studio'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = studioCopy(locale).included
const emblems: EmblemName[] = ['orb', 'planet', 'quill', 'map', 'network', 'book']
---

<section class="section included" aria-labelledby="included-title">
  <div class="wrap">
    <div class="head center">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="included-title" style="--delay: 0.08s">
        {copy.title} <span class="gilded included__accent">{copy.titleAccent}</span>
      </h2>
    </div>

    <ul class="included__grid">
      {
        copy.items.map((item, index) => (
          <Frame as="li" size="tile" class="included__item reveal" style={`--delay: ${0.06 * index}s`}>
            <span class="included__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="medallion included__medal">
              <Emblem name={emblems[index] ?? 'orb'} />
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </Frame>
        ))
      }
    </ul>

    <p class="included__note reveal">
      <Icon name="wrench" />
      <span>{copy.note}</span>
    </p>
  </div>
</section>

<style>
  .included__accent {
    display: block;
  }

  .included__grid {
    display: grid;
    gap: 1.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .included__item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    column-gap: 1rem;
    row-gap: 0.35rem;
    align-items: start;
    padding: 1.5rem 1.4rem;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.55s var(--ease);
  }

  .included__item:hover {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 32px -6px oklch(0.84 0.16 86 / 0.45),
      0 22px 40px -22px oklch(0.05 0.04 290 / 0.95);
  }

  .included__item:hover .included__medal {
    transform: rotate(-8deg) scale(1.06);
  }

  .included__index {
    position: absolute;
    top: 0.9rem;
    right: 1.2rem;
    color: oklch(0.84 0.16 86 / 0.3);
    font-family: var(--font-decorative);
    font-size: 1.6rem;
    line-height: 1;
  }

  .included__medal {
    grid-row: 1 / 3;
    transition: transform 0.45s var(--ease);
  }

  .included__item h3 {
    margin: 0;
    padding-right: 3rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--gild-hi);
  }

  .included__item p {
    margin: 0;
    color: var(--muted);
    font-size: 0.96rem;
    text-wrap: pretty;
  }

  .included__note {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: fit-content;
    max-width: 46rem;
    margin: 2.6rem auto 0;
    padding: 0.75rem 1.2rem;
    border: 1px solid var(--frame-rule);
    border-radius: 12px;
    background: oklch(0.16 0.05 292 / 0.7);
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .included__note :global(svg) {
    color: var(--gild);
  }

  @media (min-width: 720px) {
    .included__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1040px) {
    .included__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
