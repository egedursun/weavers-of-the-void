---
import Emblem, { type EmblemName } from './Emblem.astro'
import Frame from './Frame.astro'
import { asset, copyFor, type Locale } from '../i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const copy = copyFor(locale).audiences
const pictures: Record<string, string> = { novelist: 'audience-novelist', gm: 'audience-gm', studio: 'audience-studio', worldbuilder: 'audience-worldbuilder' }
---

<section class="section audiences" id="for" aria-labelledby="audiences-title">
  <div class="wrap wrap--wide">
    <div class="head center">
      <p class="eyebrow reveal">{copy.eyebrow}</p>
      <h2 class="title reveal" id="audiences-title" style="--delay: 0.08s">{copy.title}</h2>
    </div>
    <ul class="audiences__grid">
      {
        copy.items.map((item, index) => (
          <Frame as="li" size="card" gem class="audiences__card reveal" style={`--delay: ${0.08 * index}s`}>
            <span class="audiences__shine" aria-hidden="true" />
            {pictures[item.key] && (
              <figure class="audiences__picture">
                <img src={asset(`art/minds/${pictures[item.key]}.webp`)} alt="" width="900" height="900" loading="lazy" decoding="async" />
              </figure>
            )}
            <span class:list={['medallion audiences__medal', { 'audiences__medal--over': pictures[item.key] }]}>
              <Emblem name={item.emblem as EmblemName} />
            </span>
            <h3 class="gilded">{item.title}</h3>
            <span class="audiences__rule" aria-hidden="true" />
            <p>{item.text}</p>
          </Frame>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .audiences__grid {
    display: grid;
    gap: 2.8rem 2.8rem;
    margin: 0;
    padding: 1rem 0 0;
    list-style: none;
  }

  .audiences__picture {
    position: relative;
    justify-self: stretch;
    margin: -1rem -0.6rem 0;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 3px;
    padding: 0;
    border: 3px solid transparent;
    background:
      linear-gradient(180deg, oklch(0.16 0.06 294), oklch(0.11 0.04 291)) padding-box,
      linear-gradient(135deg, #fff1b8, var(--gild) 22%, var(--gild-lo) 45%, #f7dc8a 62%, var(--gild) 80%, var(--gild-lo)) border-box;
    box-shadow:
      0 0 0 1px oklch(0.36 0.09 56),
      0 16px 30px -16px oklch(0.05 0.04 290 / 0.9);
  }

  .audiences__picture::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 2px;
    box-shadow:
      inset 0 0 0 1px oklch(0.96 0.09 96 / 0.35),
      inset 0 -50px 40px -30px oklch(0.1 0.05 292 / 0.85);
    pointer-events: none;
  }

  .audiences__picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
    transition:
      transform 1.4s cubic-bezier(0.22, 1, 0.36, 1),
      filter 0.8s ease;
  }

  .audiences__card:hover .audiences__picture img {
    transform: scale(1.05);
    filter: saturate(1.12) brightness(1.06);
  }

  .audiences__medal--over {
    position: relative;
    z-index: 3;
    margin-top: -3.2rem;
  }

  .audiences__card {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.9rem;
    height: 100%;
    padding: 2.8rem 1.7rem 2.3rem;
    text-align: center;
    transition:
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.6s var(--ease);
  }

  .audiences__shine {
    position: absolute;
    inset: 4px;
    z-index: 1;
    overflow: hidden;
    border-radius: 2px;
    pointer-events: none;
  }

  .audiences__shine::after {
    content: '';
    position: absolute;
    inset: -30% -80%;
    background: linear-gradient(
      105deg,
      transparent 40%,
      oklch(1 0 0 / 0.05) 45%,
      oklch(0.98 0.07 92 / 0.22) 50%,
      oklch(1 0 0 / 0.05) 55%,
      transparent 60%
    );
    transform: translateX(-70%);
  }

  .audiences__card:hover {
    transform: translateY(-6px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 40px -6px oklch(0.84 0.16 86 / 0.55),
      0 30px 56px -28px oklch(0.05 0.04 290 / 0.95);
  }

  .audiences__card:hover .audiences__shine::after {
    animation: audiences-sweep 1.2s cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .audiences__medal {
    width: 5.4rem;
    height: 5.4rem;
    margin-bottom: 0.3rem;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .audiences__medal :global(.emblem) {
    width: 3rem;
    height: 3rem;
  }

  .audiences__card:hover .audiences__medal {
    transform: scale(1.08);
  }

  .audiences__card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2vw, 1.6rem);
    line-height: 1.2;
    text-wrap: balance;
    filter: drop-shadow(0 2px 0 oklch(0.25 0.07 56 / 0.85));
  }

  .audiences__rule {
    width: 4.5rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gild-hi), transparent);
  }

  .audiences__card p {
    margin: 0;
    color: var(--fg);
    opacity: 0.86;
    line-height: 1.6;
    text-wrap: pretty;
  }

  @keyframes audiences-sweep {
    to {
      transform: translateX(70%);
    }
  }

  @media (min-width: 720px) {
    .audiences__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1240px) {
    .audiences__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
