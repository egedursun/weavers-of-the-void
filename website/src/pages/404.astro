---
import Base from '../layouts/Base.astro'
import { copyFor, page } from '../i18n'

const copy = copyFor('en')
---

<Base locale="en" path="" title="Lost in the void · Weavers of the Void" description={copy.meta.description}>
  <section class="section center">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1 class="title">Lost in the void</h1>
      <p class="lead">This page drifted beyond the edge of the map. · Bu sayfa haritanın sınırlarının ötesine sürüklendi.</p>
      <p style="margin-top: 2rem; display: flex; gap: 0.9rem; justify-content: center; flex-wrap: wrap;">
        <a class="button button--gold" href={page('en')}>Back home</a>
        <a class="button button--ghost" href={page('tr')}>Ana sayfaya dön</a>
      </p>
    </div>
  </section>
</Base>
