---
import Base from '../../layouts/Base.astro'
import Hero from '../../components/Hero.astro'
import How from '../../components/How.astro'
import Showcase from '../../components/Showcase.astro'
import Cascade from '../../components/Cascade.astro'
import Minds from '../../components/Minds.astro'
import Depth from '../../components/Depth.astro'
import Powers from '../../components/Powers.astro'
import Audiences from '../../components/Audiences.astro'
import Play from '../../components/Play.astro'
import Numbers from '../../components/Numbers.astro'
import CoverWall from '../../components/CoverWall.astro'
import Outputs from '../../components/Outputs.astro'
import Free from '../../components/Free.astro'
import Services from '../../components/Services.astro'
import Contact from '../../components/Contact.astro'
import Faq from '../../components/Faq.astro'
import { LOCALES, copyFor, type Locale } from '../../i18n'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const locale = Astro.params.lang as Locale
const copy = copyFor(locale)
---

<Base locale={locale} title={copy.meta.title} description={copy.meta.description}>
  <Hero locale={locale} />
  <Numbers locale={locale} />
  <How locale={locale} />
  <Cascade locale={locale} />
  <Showcase locale={locale} />
  <Minds locale={locale} />
  <Depth locale={locale} />
  <Powers locale={locale} />
  <CoverWall locale={locale} />
  <Outputs locale={locale} />
  <Audiences locale={locale} />
  <Play locale={locale} />
  <Free locale={locale} />
  <Services locale={locale} compact />
  <Contact locale={locale} />
  <Faq locale={locale} />
</Base>
