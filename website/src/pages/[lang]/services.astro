---
import Base from '../../layouts/Base.astro'
import StudioHero from '../../components/services/StudioHero.astro'
import Services from '../../components/Services.astro'
import Contact from '../../components/Contact.astro'
import { LOCALES, copyFor, type Locale } from '../../i18n'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const locale = Astro.params.lang as Locale
const copy = copyFor(locale)
---

<Base locale={locale} path="services" title={copy.meta.servicesTitle} description={copy.meta.servicesDescription}>
  <StudioHero locale={locale} />
  <Services locale={locale} parts={['packages']} heading={false} id="packages" />
  <Services locale={locale} parts={['offers', 'hourly']} heading={false} detailed id="specialists" />
  <Contact locale={locale} />
</Base>
