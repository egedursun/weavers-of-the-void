---
import Base from '../../../layouts/Base.astro'
import Icon from '../../../components/Icon.astro'
import ExpansionCard from '../../../components/expansions/ExpansionCard.astro'
import ExpansionFeature from '../../../components/expansions/ExpansionFeature.astro'
import Frame from '../../../components/Frame.astro'
import Emblem, { type EmblemName } from '../../../components/Emblem.astro'
import { LOCALES, REPOSITORY, asset, copyFor, type Locale } from '../../../i18n'
import { coverOf, expansionsFor, tallyOf } from '../../../data/expansions'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const locale = Astro.params.lang as Locale
const copy = copyFor(locale)
const text = copy.expansionsPage
const all = expansionsFor(locale)
const [core, loom, ...rest] = all
const tally = tallyOf(all)
const figures: { value: number; label: string; emblem: EmblemName }[] = [
  { value: tally.parts, label: text.stats.parts, emblem: 'planet' },
  { value: tally.governs, label: text.stats.governs, emblem: 'network' },
  { value: tally.values, label: text.stats.values, emblem: 'scroll' },
]
const fan = [loom, rest[6], rest[22], rest[40], rest[61], rest[78], rest[95]].filter(Boolean)
---

<Base locale={locale} path="expansions" title={copy.meta.expansionsTitle} description={copy.meta.expansionsDescription}>
  <section class="section xindex">
    <div class="wrap wrap--wide">
      <div class="xindex__hero">
        <div class="xindex__fan" aria-hidden="true">
          {fan.map((item, index) => <img src={asset(coverOf(item))} alt="" width="480" height="720" style={`--slot: ${index - 3}`} />)}
        </div>
        <div class="head center xindex__head">
          <p class="eyebrow">{text.eyebrow}</p>
          <h1 class="title"><span class="gilded xindex__title">{text.title}</span></h1>
          <p class="lead xindex__lead">{text.lead}</p>
        </div>
      </div>

      <ul class="xindex__figures">
        {
          figures.map((figure) => (
            <Frame as="li" size="tile" class="xindex__figure">
              <span class="medallion xindex__medal" aria-hidden="true"><Emblem name={figure.emblem} /></span>
              <strong class="gilded">{figure.value.toLocaleString(locale)}</strong>
              <span>{figure.label}</span>
            </Frame>
          ))
        }
      </ul>

      <div class="xindex__features">
        <ExpansionFeature locale={locale} item={core} label={text.core} emblem="crown" open={text.open} />
        <ExpansionFeature locale={locale} item={loom} label={text.loom} emblem="network" open={text.open} />
      </div>

      <div class="xindex__tools">
        <label class="xindex__search">
          <Icon name="search" />
          <span class="visually-hidden">{text.search}</span>
          <input type="search" placeholder={text.search} autocomplete="off" data-search />
        </label>
        <p class="xindex__count" aria-live="polite" data-count data-shown={text.shown} data-total={rest.length}>
          {rest.length} {text.shown}
        </p>
      </div>

      <ul class="xindex__grid" data-grid>
        {rest.map((item, index) => <ExpansionCard locale={locale} item={item} labels={{ lists: text.lists, values: text.values }} index={index} />)}
      </ul>

      <div class="xindex__empty" hidden data-empty>
        <p>{text.none}</p>
        <button class="button button--ghost" type="button" data-clear>{text.clear}</button>
      </div>

      <div class="xindex__final center">
        <p class="eyebrow">{text.included}</p>
        <a class="button button--gold" href={REPOSITORY} target="_blank" rel="noopener noreferrer">
          <Icon name="github" />
          {text.cta}
        </a>
      </div>
    </div>
  </section>
</Base>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]')
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'))
  const count = document.querySelector<HTMLElement>('[data-count]')
  const empty = document.querySelector<HTMLElement>('[data-empty]')
  const clear = document.querySelector<HTMLButtonElement>('[data-clear]')
  const locale = document.documentElement.lang
  const apply = () => {
    const words = (input?.value ?? '').toLocaleLowerCase(locale).split(/\s+/).filter(Boolean)
    let shown = 0
    cards.forEach((card) => {
      const haystack = card.dataset.searchText ?? ''
      const match = words.every((word) => haystack.includes(word))
      card.hidden = !match
      if (match) shown += 1
    })
    if (count) count.textContent = `${shown} ${count.dataset.shown ?? ''}`
    if (empty) empty.hidden = shown > 0
  }
  input?.addEventListener('input', apply)
  clear?.addEventListener('click', () => {
    if (input) input.value = ''
    apply()
    input?.focus()
  })
</script>

<style>
  .xindex__hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(1rem, 4vw, 3rem);
  }

  .xindex__hero::before {
    content: '';
    position: absolute;
    inset: -10% 10% 10%;
    z-index: -2;
    background:
      radial-gradient(closest-side, oklch(0.6 0.23 302 / 0.45), transparent 75%),
      radial-gradient(closest-side at 50% 70%, oklch(0.84 0.16 86 / 0.14), transparent 80%);
    filter: blur(20px);
    pointer-events: none;
  }

  .xindex__fan {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: clamp(14rem, 30vw, 22rem);
    display: flex;
    justify-content: center;
    pointer-events: none;
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.55) 55%, transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.55) 55%, transparent 100%);
  }

  .xindex__fan img {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(6.5rem, 12vw, 9.5rem);
    aspect-ratio: 2 / 3;
    object-fit: fill;
    border-radius: 8px;
    border: 2px solid oklch(0.84 0.14 86 / 0.55);
    opacity: 0.42;
    box-shadow: 0 20px 40px -18px oklch(0.04 0.04 290 / 0.95);
    transform: translateX(calc(-50% + var(--slot) * clamp(4.5rem, 9.5vw, 8.5rem))) translateY(calc(var(--slot) * var(--slot) * 0.5rem)) rotate(calc(var(--slot) * 6deg));
    animation: xindex-deal 1.2s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    animation-delay: calc((var(--slot) + 3) * 0.06s);
  }

  .xindex__head {
    position: relative;
    padding-top: clamp(4rem, 12vw, 8.5rem);
  }

  .xindex__title {
    display: inline-block;
    font-size: clamp(2.5rem, 6.4vw, 4.6rem);
    line-height: 1.04;
    filter: drop-shadow(0 3px 0 oklch(0.25 0.07 56 / 0.9)) drop-shadow(0 0 34px oklch(0.84 0.16 86 / 0.4));
  }

  .xindex__lead {
    color: var(--fg);
    opacity: 0.92;
  }

  .xindex__figures {
    display: grid;
    gap: 1.6rem;
    max-width: 66rem;
    margin: 0 auto clamp(3rem, 6vw, 4rem);
    padding: 0;
    list-style: none;
  }

  .xindex__figures :global(.xindex__figure) {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.55rem;
    padding: 1.6rem 1.2rem 1.5rem;
    text-align: center;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.55s var(--ease);
  }

  .xindex__figures :global(.xindex__figure:hover) {
    transform: translateY(-4px);
    box-shadow:
      0 0 0 1px var(--gild-deep),
      0 0 34px -6px oklch(0.84 0.16 86 / 0.55),
      0 22px 40px -22px oklch(0.05 0.04 290 / 0.95);
  }

  .xindex__medal {
    width: 3.4rem;
    height: 3.4rem;
  }

  .xindex__medal :global(.emblem) {
    width: 1.8rem;
    height: 1.8rem;
  }

  .xindex__figures strong {
    font-family: var(--font-decorative);
    font-weight: 700;
    font-size: clamp(2.4rem, 4.4vw, 3.3rem);
    line-height: 1;
    filter: drop-shadow(0 3px 0 oklch(0.25 0.07 56 / 0.9)) drop-shadow(0 0 22px oklch(0.84 0.16 86 / 0.35));
  }

  .xindex__figures span:last-child {
    max-width: 15rem;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--fg);
    opacity: 0.88;
  }

  @keyframes xindex-deal {
    from {
      opacity: 0;
      transform: translateX(-50%) translateY(2rem) rotate(0deg);
    }
  }

  .xindex__features {
    display: grid;
    gap: 2.2rem;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .xindex__tools {
    position: sticky;
    top: 92px;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.75rem;
    padding: 0.75rem 1rem;
    border-radius: 18px;
    border: 1px solid var(--border-strong);
    background: oklch(0.13 0.045 292 / 0.88);
    backdrop-filter: blur(12px);
    box-shadow: 0 18px 40px -24px oklch(0.04 0.04 290 / 0.95);
  }

  .xindex__search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex: 1 1 18rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: oklch(0.1 0.035 290 / 0.8);
    transition:
      border-color 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .xindex__search:focus-within {
    border-color: var(--gild);
    box-shadow: 0 0 0 3px oklch(0.84 0.16 86 / 0.18), 0 0 22px -6px oklch(0.84 0.16 86 / 0.5);
  }

  .xindex__search :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    color: var(--gild);
  }

  .xindex__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: 1rem;
    outline: none;
  }

  .xindex__count {
    margin: 0;
    padding-right: 0.5rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gild);
  }

  .xindex__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 9.4rem), 1fr));
    gap: 1.2rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .xindex__empty {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: 3rem 1rem;
    text-align: center;
  }

  .xindex__empty[hidden] {
    display: none;
  }

  .xindex__final {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
  }

  @media (min-width: 720px) {
    .xindex__tools {
      border-radius: 999px;
    }

    .xindex__grid {
      grid-template-columns: repeat(auto-fill, minmax(13.5rem, 1fr));
      gap: 1.6rem 1.3rem;
    }
  }

  @media (min-width: 720px) {
    .xindex__figures {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xindex__fan img {
      animation: none;
    }
  }

  @media (min-width: 1080px) {
    .xindex__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
