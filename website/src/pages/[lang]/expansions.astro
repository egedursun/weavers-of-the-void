---
import Frame from '../../components/Frame.astro'
import Base from '../../layouts/Base.astro'
import Icon from '../../components/Icon.astro'
import { LOCALES, REPOSITORY, asset, copyFor, type Locale } from '../../i18n'
import { chaptersFor, loomFor, type Expansion } from '../../data/expansions'

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }))
}

const locale = Astro.params.lang as Locale
const copy = copyFor(locale)
const text = copy.expansionsPage
const loom = loomFor(locale)
const chapters = chaptersFor(locale)
const all: Expansion[] = [loom, ...chapters.flatMap((chapter) => chapter.expansions)]
const searchText = (item: Expansion) =>
  [item.name, item.tagline, ...item.intro, ...item.features.map((feature) => `${feature.title} ${feature.text}`), item.story]
    .join(' ')
    .toLowerCase()
---

<Base locale={locale} path="expansions" title={copy.meta.expansionsTitle} description={copy.meta.expansionsDescription}>
  <section class="section section--tight">
    <div class="wrap head center">
      <p class="eyebrow">{text.eyebrow}</p>
      <h1 class="title"><span class="gilded">{text.title}</span></h1>
      <p class="lead">{text.lead}</p>
      <span class="divider" aria-hidden="true"></span>
    </div>

    <div class="wrap">
      <Frame as="button" size="panel" class="loom" type="button" data-open={loom.number} aria-haspopup="dialog">
        <img src={asset(`covers/${loom.number}.webp`)} alt="" width="480" height="720" />
        <span class="loom__body">
          <span class="chip"><Icon name="sparkles" />{text.loomLabel}</span>
          <span class="loom__name">{loom.name}</span>
          <span class="loom__tagline">{loom.tagline}</span>
          <span class="loom__intro">{loom.intro[0]}</span>
          <span class="loom__more">{text.open}<Icon name="arrowRight" /></span>
        </span>
      </Frame>

      <div class="tools" data-tools>
        <label class="search">
          <Icon name="search" />
          <span class="visually-hidden">{text.search}</span>
          <input type="search" placeholder={text.search} data-search autocomplete="off" />
        </label>
        <div class="filters" role="group" aria-label={text.chapter}>
          <button type="button" class="filter" aria-pressed="true" data-filter="all">{text.all}</button>
          {
            chapters.map((chapter) => (
              <button type="button" class="filter" aria-pressed="false" data-filter={chapter.numeral} title={chapter.title}>
                <span aria-hidden="true">{chapter.sign}</span>
                {chapter.numeral}
                <span class="visually-hidden">{chapter.title}</span>
              </button>
            ))
          }
        </div>
        <p class="count" aria-live="polite" data-count data-shown={text.shown}></p>
      </div>

      {
        chapters.map((chapter) => (
          <section class="chapter" data-chapter={chapter.numeral} aria-labelledby={`chapter-${chapter.numeral}`}>
            <h2 class="chapter__title" id={`chapter-${chapter.numeral}`}>
              <span class="chapter__sign" aria-hidden="true">{chapter.sign}</span>
              <span class="chapter__numeral">{text.chapter} {chapter.numeral}</span>
              {chapter.title}
            </h2>
            <ul class="grid">
              {chapter.expansions.map((item) => (
                <li data-card data-search-text={searchText(item)}>
                  <button class="card" type="button" data-open={item.number} aria-haspopup="dialog" data-tilt>
                    <span class="card__art">
                      <img src={asset(`covers/${item.number}.webp`)} alt="" width="480" height="720" loading="lazy" decoding="async" />
                      <span class="card__number">{item.number}</span>
                    </span>
                    <span class="card__name">{item.name}</span>
                    <span class="card__tagline">{item.tagline}</span>
                  </button>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <div class="empty" hidden data-empty>
        <p>{text.none}</p>
        <button type="button" class="button button--ghost" data-clear>{text.clear}</button>
      </div>

      <Frame size="panel" gem class="final center">
        <h2 class="title">{text.cta}</h2>
        <p class="lead">{copy.wall.lead}</p>
        <a class="button button--gold" href={REPOSITORY} target="_blank" rel="noopener noreferrer"><Icon name="github" />{copy.hero.primary}</a>
      </Frame>
    </div>
  </section>

  <dialog class="sheet" data-sheet aria-labelledby="sheet-title">
    <Frame size="panel" class="sheet__inner">
      <div class="sheet__bar">
        <button type="button" class="sheet__icon" data-step="-1" aria-label={text.previous}><Icon name="chevronLeft" /></button>
        <button type="button" class="sheet__icon" data-step="1" aria-label={text.next}><Icon name="chevronRight" /></button>
        <button type="button" class="sheet__icon sheet__close" data-close aria-label={text.close}><Icon name="close" /></button>
      </div>
      {
        all.map((item) => (
          <article class="detail" data-detail={item.number} hidden>
            <div class="detail__box">
              <div class="flip" data-flip>
                <img class="flip__front" src={asset(`covers/${item.number}.webp`)} alt={`${item.name} · ${text.front}`} width="480" height="720" loading="lazy" />
                <img class="flip__back" data-src={asset(`backs/${item.number}.webp`)} alt={`${item.name} · ${text.back}`} width="960" height="1440" />
              </div>
              <button type="button" class="button button--ghost" data-turn><Icon name="rotate" />{text.turn}</button>
            </div>
            <div class="detail__copy">
              <p class="detail__meta">
                <span class="chip"><Icon name="package" />#{item.number}</span>
                <span class="chip"><Icon name="check" />{text.included}</span>
              </p>
              <h2 class="detail__name" data-name>{item.name}</h2>
              <p class="detail__tagline">{item.tagline}</p>
              {item.intro.map((paragraph) => <p class="detail__intro">{paragraph}</p>)}
              <h3 class="detail__heading">{text.features}</h3>
              <ul class="detail__features">
                {item.features.map((feature) => (
                  <li>
                    <strong>{feature.title}</strong>
                    <span>{feature.text}</span>
                  </li>
                ))}
              </ul>
              <figure class="detail__story">
                <Icon name="quote" />
                <figcaption>{text.story}</figcaption>
                <blockquote>{item.story}</blockquote>
              </figure>
            </div>
          </article>
        ))
      }
    </Frame>
  </dialog>
</Base>

<script>
  const sheet = document.querySelector<HTMLDialogElement>('[data-sheet]')
  const details = Array.from(document.querySelectorAll<HTMLElement>('[data-detail]'))
  const order = details.map((detail) => Number(detail.dataset.detail))
  let current = -1

  const show = (number: number) => {
    if (!sheet) return
    current = order.indexOf(number)
    details.forEach((detail) => {
      const chosen = Number(detail.dataset.detail) === number
      detail.hidden = !chosen
      if (chosen) {
        detail.querySelector('[data-flip]')?.classList.remove('is-turned')
        detail.querySelector('h2')?.setAttribute('id', 'sheet-title')
      } else {
        detail.querySelector('h2')?.removeAttribute('id')
      }
    })
    if (!sheet.open) sheet.showModal()
    sheet.querySelector('.sheet__inner')?.scrollTo({ top: 0 })
    history.replaceState(null, '', `#${number}`)
  }

  document.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((button) => {
    button.addEventListener('click', () => show(Number(button.dataset.open)))
  })
  sheet?.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = (current + Number(button.dataset.step) + order.length) % order.length
      show(order[next])
    })
  })
  sheet?.querySelector('[data-close]')?.addEventListener('click', () => sheet.close())
  sheet?.addEventListener('click', (event) => {
    if (event.target === sheet) sheet.close()
  })
  sheet?.addEventListener('close', () => history.replaceState(null, '', window.location.pathname))
  document.addEventListener('keydown', (event) => {
    if (!sheet?.open) return
    if (event.key === 'ArrowRight') show(order[(current + 1) % order.length])
    if (event.key === 'ArrowLeft') show(order[(current - 1 + order.length) % order.length])
  })
  document.querySelectorAll<HTMLButtonElement>('[data-turn]').forEach((button) => {
    button.addEventListener('click', () => {
      const flip = button.parentElement?.querySelector<HTMLElement>('[data-flip]')
      const back = flip?.querySelector<HTMLImageElement>('.flip__back')
      if (back && !back.src && back.dataset.src) back.src = back.dataset.src
      flip?.classList.toggle('is-turned')
    })
  })

  const search = document.querySelector<HTMLInputElement>('[data-search]')
  const filters = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'))
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'))
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter]'))
  const count = document.querySelector<HTMLElement>('[data-count]')
  const empty = document.querySelector<HTMLElement>('[data-empty]')
  let chosenChapter = 'all'

  const apply = () => {
    const words = (search?.value ?? '').trim().toLowerCase().split(/\s+/).filter(Boolean)
    let shown = 0
    chapters.forEach((chapter) => {
      const inChapter = chosenChapter === 'all' || chapter.dataset.chapter === chosenChapter
      let visible = 0
      chapter.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
        const text = card.dataset.searchText ?? ''
        const match = inChapter && words.every((word) => text.includes(word))
        card.hidden = !match
        if (match) visible += 1
      })
      chapter.hidden = visible === 0
      shown += visible
    })
    if (count) count.textContent = `${shown} / ${cards.length} ${count.dataset.shown ?? ''}`
    if (empty) empty.hidden = shown !== 0
  }

  search?.addEventListener('input', apply)
  filters.forEach((button) => {
    button.addEventListener('click', () => {
      chosenChapter = button.dataset.filter ?? 'all'
      filters.forEach((other) => other.setAttribute('aria-pressed', String(other === button)))
      apply()
    })
  })
  document.querySelector('[data-clear]')?.addEventListener('click', () => {
    if (search) search.value = ''
    chosenChapter = 'all'
    filters.forEach((other) => other.setAttribute('aria-pressed', String(other.dataset.filter === 'all')))
    apply()
  })
  apply()

  const fromHash = Number(window.location.hash.slice(1))
  if (window.location.hash && order.includes(fromHash)) show(fromHash)
</script>

<style>
  .loom {
    display: grid;
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: center;
    width: 100%;
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.25rem, 3vw, 2rem);
    text-align: start;
    cursor: pointer;
    color: inherit;
    font: inherit;
    background:
      radial-gradient(40rem 20rem at 0% 50%, oklch(0.6 0.23 302 / 0.25), transparent 70%),
      linear-gradient(180deg, var(--frame-hi), var(--frame-lo));
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease);
  }

  .loom:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }

  .loom img {
    width: min(100%, 220px);
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 20px 40px -18px oklch(0.05 0.04 290 / 0.95);
    justify-self: center;
  }

  .loom__body {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }

  .loom__name {
    font-family: var(--font-decorative);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.05;
    color: var(--gild-hi);
  }

  .loom__tagline {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--gild);
  }

  .loom__intro {
    color: var(--muted);
    max-width: 46rem;
  }

  .loom__more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--gild-hi);
    font-weight: 600;
  }

  .loom__more :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .tools {
    position: sticky;
    top: 76px;
    z-index: 5;
    display: grid;
    gap: 0.9rem;
    margin-bottom: 2rem;
    padding: 0.9rem 0;
    background: linear-gradient(180deg, var(--bg) 70%, transparent);
  }

  .search {
    position: relative;
    display: block;
  }

  .search :global(svg) {
    position: absolute;
    left: 1rem;
    top: 50%;
    width: 1.15rem;
    height: 1.15rem;
    translate: 0 -50%;
    color: var(--gild);
  }

  .search input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem 0.75rem 2.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: oklch(0.15 0.05 292 / 0.9);
  }

  .search input:focus {
    outline: none;
    border-color: var(--gild);
    box-shadow: 0 0 0 3px oklch(0.84 0.16 86 / 0.2);
  }

  .filters {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: none;
  }

  .filters::-webkit-scrollbar {
    display: none;
  }

  .filter {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: oklch(0.2 0.07 296 / 0.6);
    color: var(--muted);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    transition: color 0.2s var(--ease), background-color 0.2s var(--ease), border-color 0.2s var(--ease);
  }

  .filter:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .filter[aria-pressed='true'] {
    background: linear-gradient(180deg, var(--gild-hi), var(--gild));
    border-color: var(--gild);
    color: oklch(0.18 0.06 290);
  }

  .count {
    margin: 0;
    color: var(--faint);
    font-size: 0.9rem;
  }

  .chapter {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .chapter__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid oklch(0.82 0.1 86 / 0.18);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: var(--fg);
  }

  .chapter__sign {
    font-size: 1.1em;
  }

  .chapter__numeral {
    color: var(--gild);
    font-size: 0.6em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: clamp(0.9rem, 2vw, 1.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: grid;
    gap: 0.5rem;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .card__art {
    position: relative;
    display: block;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid oklch(0.82 0.1 86 / 0.24);
    box-shadow: 0 18px 34px -18px oklch(0.05 0.04 290 / 0.95);
    transform: perspective(800px) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transition: transform 0.25s var(--ease), border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .card__art::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at var(--shine-x, 50%) var(--shine-y, 0%), oklch(1 0 0 / 0.18), transparent 55%);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }

  .card:hover .card__art,
  .card:focus-visible .card__art {
    border-color: var(--gild);
    box-shadow: 0 24px 44px -18px oklch(0.05 0.04 290 / 0.95), 0 0 30px -8px oklch(0.84 0.16 86 / 0.5);
  }

  .card:hover .card__art::after {
    opacity: 1;
  }

  .card__art img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
  }

  .card__number {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    display: grid;
    place-items: center;
    min-width: 1.9rem;
    height: 1.9rem;
    padding: 0 0.4rem;
    border-radius: 999px;
    background: oklch(0.12 0.04 291 / 0.85);
    border: 1px solid var(--border-strong);
    color: var(--gild-hi);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .card__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.25;
    color: var(--gild-hi);
  }

  .card__tagline {
    color: var(--faint);
    font-size: 0.86rem;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty {
    padding: 3rem 1rem;
    text-align: center;
    color: var(--muted);
  }

  .final {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding: clamp(2rem, 5vw, 3.5rem) var(--gutter);
  }

  .final .lead {
    margin-top: 0;
  }

  .sheet {
    width: min(100% - 1.5rem, 1080px);
    max-height: calc(100svh - 2rem);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
  }

  .sheet::backdrop {
    background: oklch(0.08 0.03 290 / 0.78);
    backdrop-filter: blur(6px);
  }

  .sheet[open] {
    animation: sheet-in 0.35s var(--ease);
  }

  .sheet__inner {
    max-height: calc(100svh - 2rem);
    overflow-y: auto;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--card-solid);
  }

  .sheet__bar {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .sheet__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: oklch(0.2 0.07 296 / 0.9);
    color: var(--gild-hi);
    cursor: pointer;
  }

  .sheet__icon :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .sheet__icon:hover {
    border-color: var(--gild);
  }

  .detail {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .detail[hidden] {
    display: none;
  }

  .detail__box {
    display: grid;
    justify-items: center;
    gap: 1rem;
    align-content: start;
  }

  .flip {
    position: relative;
    width: min(100%, 320px);
    aspect-ratio: 2 / 3;
    perspective: 1400px;
    transform-style: preserve-3d;
    transition: transform 0.8s var(--ease);
  }

  .flip.is-turned {
    transform: rotateY(180deg);
  }

  .flip img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
    border: 1px solid var(--border-strong);
    backface-visibility: hidden;
    box-shadow: 0 26px 50px -20px oklch(0.05 0.04 290 / 0.95);
  }

  .flip__back {
    transform: rotateY(180deg);
    background: var(--bg-raised);
  }

  .detail__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
  }

  .detail__name {
    margin: 0;
    font-family: var(--font-decorative);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.08;
    color: var(--gild-hi);
  }

  .detail__tagline {
    margin: 0.5rem 0 1rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--gild);
  }

  .detail__intro {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .detail__heading {
    margin: 1.5rem 0 0.9rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gild);
  }

  .detail__features {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail__features li {
    display: grid;
    gap: 0.2rem;
    padding-left: 1rem;
    border-left: 2px solid oklch(0.84 0.16 86 / 0.4);
  }

  .detail__features strong {
    color: var(--fg);
  }

  .detail__features span {
    color: var(--muted);
    font-size: 0.97rem;
  }

  .detail__story {
    position: relative;
    margin: 1.75rem 0 0;
    padding: 1.25rem 1.25rem 1.25rem 3.2rem;
    border-radius: var(--radius-sm);
    background: oklch(0.6 0.23 302 / 0.14);
    border: 1px solid oklch(0.6 0.23 302 / 0.35);
  }

  .detail__story :global(svg) {
    position: absolute;
    left: 1rem;
    top: 1.2rem;
    width: 1.4rem;
    height: 1.4rem;
    color: var(--violet-hi);
  }

  .detail__story figcaption {
    margin-bottom: 0.3rem;
    color: var(--violet-hi);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .detail__story blockquote {
    margin: 0;
    color: var(--fg);
    font-style: italic;
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      translate: 0 20px;
      scale: 0.98;
    }
  }

  @media (min-width: 760px) {
    .loom {
      grid-template-columns: 220px 1fr;
    }

    .grid {
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    }

    .detail {
      grid-template-columns: 320px 1fr;
    }

    .detail__box {
      position: sticky;
      top: 3.5rem;
    }
  }
</style>
