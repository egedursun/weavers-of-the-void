{% macro team_record(record) -%}
{% if record.shown %}
<h3 class="bm2" id="hands-of-the-creator">The Hands of the Creator</h3>
<p class="meta small">The people who shaped this universe as the hand of its Creator, and what each of them did.</p>
{% for hand in record.hands %}
<section class="will-session" id="hand-{{ loop.index }}">
<h4>{{ hand.name }}{% if hand.former %} <span class="meta small">former member</span>{% endif %} <span class="meta small">{{ hand.tally }}{% if hand.epochs %} · {{ hand.epochs }}{% endif %}</span></h4>
{% if hand.most %}<table><thead><tr><th>Kind of act</th><th>Times</th></tr></thead><tbody>{% for label, count in hand.most %}<tr><td>{{ label }}</td><td>{{ count }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if hand.acts %}<ul class="timeline">{% for act in hand.acts %}<li><span class="when">Epoch {{ act.epoch }}</span>{{ act.label }}{% if act.undone %} <span class="meta">undone{% if act.undone_by %} by {{ act.undone_by }}{% endif %}</span>{% endif %}{% if act.summary %} <span class="meta small">— {{ act.summary | plain }}</span>{% endif %}{% if act.reason %}<br><span class="small">Why: {{ act.reason | plain }}</span>{% endif %}</li>{% endfor %}</ul>{% endif %}
</section>
{% endfor %}
{% if record.queue %}<h4 id="queued-acts">Acts that waited for an age to end</h4><table><thead><tr><th>Act</th><th>By</th><th>Epoch</th><th>What became of it</th><th>Why</th><th>Result</th></tr></thead><tbody>{% for line in record.queue %}<tr><td>{{ line.title }}</td><td>{{ line.author }}</td><td>{{ line.epoch }}</td><td>{{ line.status }}</td><td>{{ line.reason or "—" }}</td><td>{{ line.result or "—" }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if record.proposals %}<h4 id="canon-proposals">Proposals to locked canon</h4><table><thead><tr><th>Act</th><th>Proposed by</th><th>Epoch</th><th>Decision</th><th>Decided by</th><th>Why</th><th>Note</th></tr></thead><tbody>{% for line in record.proposals %}<tr><td>{{ line.title }}</td><td>{{ line.author }}</td><td>{{ line.epoch }}</td><td>{{ line.status }}</td><td>{{ line.decided_by or "—" }}</td><td>{{ line.reason or "—" }}</td><td>{{ line.note or "—" }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% endif %}
{%- endmacro %}
