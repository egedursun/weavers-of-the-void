<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Weavers of the Void®{% endblock %}</title>
<style>
@font-face{font-family:"Book Serif";font-weight:400;font-style:normal;src:url("{{ links.font('alegreya-regular.ttf') }}")}
@font-face{font-family:"Book Serif";font-weight:500;font-style:normal;src:url("{{ links.font('alegreya-medium.ttf') }}")}
@font-face{font-family:"Book Serif";font-weight:700;font-style:normal;src:url("{{ links.font('alegreya-bold.ttf') }}")}
@font-face{font-family:"Book Serif";font-weight:400;font-style:italic;src:url("{{ links.font('alegreya-italic.ttf') }}")}
@font-face{font-family:"Book Serif";font-weight:700;font-style:italic;src:url("{{ links.font('alegreya-bold-italic.ttf') }}")}
@font-face{font-family:"Book Caps";font-weight:500;font-style:normal;src:url("{{ links.font('alegreya-sc-medium.ttf') }}")}
@font-face{font-family:"Book Display";font-weight:500;font-style:normal;src:url("{{ links.font('cormorant-medium.ttf') }}")}
@font-face{font-family:"Book Display";font-weight:600;font-style:normal;src:url("{{ links.font('cormorant-semibold.ttf') }}")}
@font-face{font-family:"Book Display";font-weight:700;font-style:normal;src:url("{{ links.font('cormorant-bold.ttf') }}")}
:root{
--paper:#f6efe0;--paper-deep:#efe4cd;--card:#fbf6ea;--ink:#2b2219;--soft:#4a3d2e;--faint:#7a6a52;
--accent:#5b2391;--warn:#a8650a;--gold:#b07d10;--rule:#d9c8a6;--rule-strong:#b9a37a;--secret:#2f2638;--secret-ink:#efe6f7;
--danger:#9b2c1f;--good:#44663a;--shadow:0 1px 0 rgba(80,60,30,.08),0 10px 30px -18px rgba(80,60,30,.45);
--serif:"Book Serif",Alegreya,Georgia,serif;--caps:"Book Caps","Book Serif",Georgia,serif;--display:"Book Display","Cormorant Garamond",Georgia,serif
}
@media (prefers-color-scheme: dark){:root{
--paper:#16130e;--paper-deep:#1f1a13;--card:#1d1812;--ink:#ece2cf;--soft:#d6c9b1;--faint:#a3937a;
--accent:#c9a2f2;--warn:#f0b54a;--gold:#f2c94c;--rule:#3d3427;--rule-strong:#5c4e3a;--secret:#2a2236;--secret-ink:#ece2f6;
--danger:#e0806f;--good:#9cc48c;--shadow:0 10px 30px -18px rgba(0,0,0,.8)
}}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{background:var(--paper)}
body{margin:0;background:var(--paper);background-image:radial-gradient(ellipse at top,var(--card),transparent 60%);color:var(--ink);font-family:var(--serif);font-size:18px;line-height:1.62;font-kerning:normal;font-variant-ligatures:common-ligatures;hyphens:auto;-webkit-font-smoothing:antialiased}
main{max-width:780px;margin:0 auto;padding:32px 22px 120px}
h1,h2,h3,h4,h5,h6{font-family:var(--display);font-weight:600;line-height:1.15;color:var(--ink);margin:1.4em 0 .4em;break-after:avoid;hyphens:manual}
h1{font-size:3.4em;font-weight:700;margin:.2em 0}
h2{font-size:2.5em;margin:0 0 .2em}
h3{font-size:1.85em}
h4{font-size:1.45em}
h5{font-size:1.2em}
h6{font-size:1.08em}
.sublabel{font-family:var(--caps);font-size:.82em;font-weight:500;letter-spacing:.08em;text-transform:lowercase;color:var(--accent);margin:1.3em 0 .3em;break-after:avoid}
p{margin:.55em 0}
a{color:var(--accent);text-decoration:none}
a:hover{text-decoration:underline}
img{max-width:100%}
ul,ol{padding-left:1.25em}
li{margin:.18em 0}
li::marker{color:var(--gold)}
.overline{font-family:var(--caps);letter-spacing:.22em;text-transform:lowercase;color:var(--gold);font-size:.86em;margin:0}
.meta{color:var(--faint);font-style:italic}
.small{font-size:.86em}
.muted{color:var(--faint)}
.lede{font-size:1.12em;color:var(--soft)}
.ornament{display:block;text-align:center;color:var(--gold);font-size:1.3em;letter-spacing:.6em;margin:1.4em 0}
.clear{clear:both}
.toolbar{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--paper) 90%,transparent);backdrop-filter:blur(10px) saturate(1.1);border-bottom:1px solid var(--rule);box-shadow:0 8px 24px -22px rgba(60,40,10,.6);font-size:16px;line-height:1.3}
.toolbar .bar{display:flex;align-items:center;gap:10px 14px;max-width:1180px;margin:0 auto;padding:10px 18px}
.toolbar .icon{width:18px;height:18px;flex:none;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.toolbar .back{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;flex:none;border-radius:50%;border:1px solid var(--rule);background:var(--card);color:var(--soft);transition:border-color .15s,color .15s,transform .15s}
.toolbar .back:hover{border-color:var(--gold);color:var(--gold);text-decoration:none;transform:translateX(-2px)}
.toolbar .heading{display:flex;flex-direction:column;min-width:0;flex:1 1 auto}
.toolbar .eyebrow{font-family:var(--caps);font-size:.72em;letter-spacing:.2em;text-transform:lowercase;color:var(--gold)}
.toolbar .title{font-family:var(--display);font-weight:700;font-size:1.3em;line-height:1.1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.toolbar .group{display:flex;align-items:center;gap:6px;flex:none}
.toolbar .jump{padding:3px;border:1px solid var(--rule);border-radius:999px;background:var(--paper-deep);gap:2px}
.toolbar .jump .tool{border-color:transparent;background:transparent}
.toolbar .jump .tool:hover{background:var(--card);border-color:var(--rule)}
.toolbar .sep{width:1px;height:26px;background:var(--rule);flex:none}
.toolbar .tool{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:7px;height:36px;min-width:36px;padding:0 14px;border-radius:999px;border:1px solid var(--rule);background:var(--card);color:var(--ink);font:inherit;font-size:.86em;font-weight:500;white-space:nowrap;cursor:pointer;text-decoration:none;transition:background .15s,border-color .15s,color .15s,box-shadow .15s,transform .1s}
.toolbar .tool:hover{border-color:var(--rule-strong);text-decoration:none}
.toolbar .tool:active{transform:translateY(1px)}
.toolbar .tool:focus-visible,.toolbar .back:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.toolbar .tool.primary{background:var(--accent);border-color:var(--accent);color:var(--paper);box-shadow:0 6px 16px -10px var(--accent)}
.toolbar .tool.primary:hover{background:color-mix(in srgb,var(--accent) 86%,var(--ink))}
.toolbar .tool[aria-disabled=true]{color:var(--faint);background:var(--paper-deep);border-style:dashed;border-color:var(--rule-strong);cursor:not-allowed;box-shadow:none;transform:none}
.toolbar .tool[aria-disabled=true]:hover{border-color:var(--rule-strong)}
.toolbar .tool[aria-disabled=true] .icon{opacity:.6}
.toolbar .tool.busy[aria-disabled=true]{color:var(--accent);border-style:solid;border-color:color-mix(in srgb,var(--accent) 45%,var(--rule));background:color-mix(in srgb,var(--accent) 9%,var(--card))}
.toolbar .tool.busy[aria-disabled=true] .icon{opacity:1}
.toolbar .tool .size{font-size:.84em;font-weight:400;opacity:.8;padding-left:7px;border-left:1px solid currentColor}
.toolbar .tool .size:empty{display:none}
.toolbar .tool .spin{display:none;animation:book-spin .9s linear infinite}
.toolbar .tool.busy{cursor:progress}
.toolbar .tool.busy .spin{display:block}
.toolbar .tool.busy .rest{display:none}
.toolbar .tool[data-tip]:hover::after,.toolbar .tool[data-tip]:focus-visible::after{content:attr(data-tip);position:absolute;top:calc(100% + 9px);right:0;z-index:6;width:max-content;max-width:260px;padding:6px 10px;border-radius:8px;background:var(--ink);color:var(--paper);font-size:.8rem;font-weight:400;line-height:1.35;white-space:normal;text-align:left;hyphens:manual;box-shadow:var(--shadow);pointer-events:none}
.toolbar .jump .tool[data-tip]:hover::after,.toolbar .jump .tool[data-tip]:focus-visible::after{left:0;right:auto}
.toolbar .status{display:flex;align-items:center;gap:8px 14px;flex-wrap:wrap;max-width:1180px;margin:0 auto;padding:0 18px 9px;font-size:.82em}
.toolbar .chip{display:inline-flex;align-items:center;gap:6px;padding:3px 11px 3px 8px;border-radius:999px;border:1px solid var(--rule);background:var(--card);color:var(--faint);font-weight:500}
.toolbar .chip .icon{width:14px;height:14px}
.toolbar [data-state=ready] .chip{border-color:color-mix(in srgb,var(--good) 45%,var(--rule));color:var(--good);background:color-mix(in srgb,var(--good) 9%,var(--card))}
.toolbar [data-state=stale] .chip{border-color:var(--warn);color:var(--warn);background:color-mix(in srgb,var(--warn) 12%,var(--card))}
.toolbar [data-state=running] .chip{border-color:color-mix(in srgb,var(--accent) 45%,var(--rule));color:var(--accent);background:color-mix(in srgb,var(--accent) 9%,var(--card))}
.toolbar .chip .icon{display:none}
.toolbar [data-state=none] .chip .when-none,.toolbar [data-state=ready] .chip .when-ready,.toolbar [data-state=stale] .chip .when-stale,.toolbar [data-state=running] .chip .when-running{display:block}
.toolbar [data-state=running] .chip .when-running{animation:book-spin .9s linear infinite}
.toolbar .meter{position:relative;flex:1 1 160px;max-width:320px;height:6px;border-radius:999px;background:var(--paper-deep);border:1px solid var(--rule);overflow:hidden}
.toolbar .meter span{position:absolute;inset:0 auto 0 0;width:0;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--gold));transition:width .6s ease}
.toolbar .note{color:var(--faint);font-style:italic}
.toolbar .note:empty{display:none}
@keyframes book-spin{to{transform:rotate(360deg)}}
@media (prefers-reduced-motion:reduce){.toolbar *{transition:none!important;animation:none!important}}
@media (max-width:900px){
.toolbar .tool .label,.toolbar .tool .size{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.toolbar .tool{padding:0;width:38px;height:38px}
}
@media (max-width:560px){
.toolbar .bar{flex-wrap:wrap;padding:8px 14px}
.toolbar .heading{flex-basis:calc(100% - 52px)}
.toolbar .sep{display:none}
.toolbar .actions{margin-left:auto}
.toolbar .status{padding:0 14px 8px}
}
.cover{min-height:92vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px 0;position:relative}
.cover .frame{border:1px solid var(--rule-strong);outline:1px solid var(--rule);outline-offset:6px;padding:48px 36px;width:100%}
.cover h1{font-size:4.2em;letter-spacing:.02em}
.cover .subtitle{font-family:var(--display);font-size:1.5em;color:var(--soft);margin:.2em 0 1em}
.cover .seal{width:280px;height:280px;border-radius:50%;object-fit:cover;border:3px solid var(--gold);box-shadow:var(--shadow);margin:18px auto}
.cover .crest{width:120px;height:120px;object-fit:contain;margin:0 auto 12px;display:block}
.cover .imprint{font-family:var(--caps);letter-spacing:.14em;color:var(--faint);font-size:.8em;margin-top:6px}
.cover .tally{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;margin-top:18px;font-family:var(--caps);letter-spacing:.06em;color:var(--faint)}
.cover .tally b{display:block;font-family:var(--display);font-size:1.7em;color:var(--ink);letter-spacing:0}
.chapter{padding-top:56px}
.chapter-head{text-align:center;margin:0 0 28px}
.chapter-head .part{font-family:var(--caps);letter-spacing:.3em;color:var(--gold);font-size:.9em}
.chapter-head .ornament{margin:.6em 0 0}
.toc ol{list-style:none;padding:0;margin:0;counter-reset:part}
.toc li{display:flex;align-items:baseline;gap:10px;padding:7px 0;border-bottom:1px dotted var(--rule);counter-increment:part}
.toc li::before{content:counter(part,upper-roman);font-family:var(--caps);color:var(--gold);min-width:2.4em}
.toc li a{font-family:var(--display);font-size:1.3em;font-weight:600;color:var(--ink)}
.toc li .count{margin-left:auto;color:var(--faint);font-style:italic;font-size:.88em}
.toc .sub{display:block;font-size:.8em;color:var(--faint);font-style:italic}
.facts{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:1px;background:var(--rule);border:1px solid var(--rule);border-radius:8px;overflow:hidden;margin:14px 0}
.facts div{background:var(--card);padding:8px 12px}
.facts dt{font-family:var(--caps);font-size:.72em;letter-spacing:.1em;text-transform:lowercase;color:var(--faint)}
.facts dd{margin:0;font-weight:500}
.specifics{margin:10px 0}
.typed{break-inside:auto}
.register{margin:18px 0 26px;break-inside:auto}
.register h3{margin-bottom:2px}
.register td{font-size:.92em;word-break:break-word}
.typed .facts{margin:6px 0 10px}
.typed-rows{margin:4px 0 10px;padding-left:1.1em;font-size:.92em}
.typed-rows li{margin:2px 0}
.will-session{margin:16px 0 24px}
.will-cycle{border-top:1px solid var(--rule);padding-top:10px;margin-top:14px;break-inside:auto}
.will-trace{padding-left:1.4em;margin:6px 0 12px;font-size:.92em}
.will-trace li{margin:6px 0}
.will-step{display:block;font-family:var(--caps);font-size:.8em;letter-spacing:.08em;text-transform:lowercase;color:var(--accent)}
.will-facts{margin:4px 0 8px}
.will-value{white-space:pre-wrap;word-break:break-word}
.will-source{white-space:pre-wrap;word-break:break-word;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.84em;line-height:1.45;background:var(--card);border:1px solid var(--rule);border-radius:6px;padding:10px 12px;margin:8px 0}
.specifics dt{font-family:var(--caps);font-size:.8em;letter-spacing:.08em;text-transform:lowercase;color:var(--accent);margin-top:8px}
.specifics dd{margin:0 0 4px}
.stats{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0;padding:0;list-style:none}
.stats li{margin:0;border:1px solid var(--rule);background:var(--card);border-radius:6px;padding:2px 9px;font-size:.84em}
.stats li b{font-family:var(--display);font-size:1.15em;margin-left:4px}
.chips{display:flex;flex-wrap:wrap;gap:5px;margin:8px 0;padding:0;list-style:none}
.chips li{margin:0;border:1px solid var(--rule);border-radius:999px;padding:0 9px;font-size:.78em;color:var(--soft);background:var(--paper-deep)}
.box{border:1px solid var(--rule);background:var(--card);border-radius:8px;padding:12px 16px;margin:14px 0;box-shadow:var(--shadow)}
.box .label,.secret .label,.quote .label{display:block;font-family:var(--caps);font-size:.76em;letter-spacing:.12em;text-transform:lowercase;color:var(--accent);margin-bottom:2px}
.secret{background:var(--secret);color:var(--secret-ink);border-radius:8px;padding:12px 16px;margin:14px 0}
.secret .label{color:#cdb6ef}
.quote,blockquote{margin:14px 0;padding:6px 0 6px 18px;border-left:3px solid var(--gold);font-style:italic;color:var(--soft)}
.quote cite,blockquote cite{display:block;font-style:normal;font-family:var(--caps);font-size:.76em;letter-spacing:.08em;color:var(--faint);margin-top:2px}
.verse{text-align:center;font-style:italic;font-family:var(--display);font-size:1.25em;color:var(--soft);white-space:pre-line;margin:18px 0}
.entry{position:relative;margin:0 0 30px;padding-bottom:18px;border-bottom:1px solid var(--rule)}
.entry:last-child{border-bottom:0}
.entry .head{display:flex;align-items:baseline;flex-wrap:wrap;gap:4px 10px}
.entry .head h3,.entry .head h4,.entry .head h5,.entry .head h6{margin:0}
.entry .kind{font-family:var(--caps);font-size:.74em;letter-spacing:.1em;text-transform:lowercase;color:var(--gold);border:1px solid var(--rule);border-radius:999px;padding:0 8px}
.entry .dagger{color:var(--danger)}
.entry .subtitle{font-style:italic;color:var(--soft);margin:.1em 0 .4em}
.thumb{float:right;width:38%;max-width:260px;margin:4px 0 10px 18px}
.thumb img{display:block;width:100%;border-radius:6px;border:1px solid var(--rule);box-shadow:var(--shadow)}
.thumb.wide{width:46%;max-width:340px}
.figure{margin:18px 0;text-align:center}
.figure img{display:block;margin:0 auto;max-height:520px;border-radius:8px;border:1px solid var(--rule);box-shadow:var(--shadow)}
.figure figcaption{font-style:italic;color:var(--faint);font-size:.88em;margin-top:6px}
.nested{padding-left:16px;border-left:2px solid var(--rule)}
.bonds{list-style:none;padding:0;margin:8px 0;font-size:.92em}
.bonds li{padding:2px 0}
.bonds .relation{font-family:var(--caps);font-size:.86em;letter-spacing:.04em;color:var(--faint);margin-right:4px}
.map{margin:20px 0 10px;break-inside:avoid}
.map .sheet{border:1px solid var(--rule-strong);outline:1px solid var(--rule);outline-offset:4px;border-radius:2px;background:#10141c;line-height:0}
.map svg{display:block;width:100%;height:auto}
.map figcaption{display:flex;flex-wrap:wrap;align-items:center;gap:6px 16px;margin-top:10px;font-size:.82em;color:var(--faint)}
.map figcaption .name{font-style:italic;margin-right:auto}
.heaven{float:right;width:42%;margin:0 0 10px 16px;break-inside:avoid}
.heaven .sky{border:1px solid var(--rule-strong);border-radius:6px;overflow:hidden;line-height:0;background:#0d0620}
.heaven .sky svg{width:100%;height:auto;display:block}
.plan{margin:12px 0;break-inside:avoid}
.plan .ground{border:1px solid var(--rule-strong);border-radius:6px;overflow:hidden;line-height:0}
.plan .ground svg{width:100%;height:auto;max-height:120mm;display:block}
.arms{margin:12px 0;display:flex;gap:12px;align-items:center;break-inside:avoid}
.arms .shield svg{width:28mm;height:auto;display:block}
.arms figcaption{font-style:italic}
.family{margin:14px 0}
.family .tree{overflow-x:auto;border:1px solid var(--rule,#d8c9a3);border-radius:8px}
.family .tree svg{display:block;height:auto;max-width:none}
.family figcaption{font-style:italic;margin-top:6px}
.family table.kin{width:100%;border-collapse:collapse;margin-top:8px;font-size:.92em}
.family table.kin th,.family table.kin td{text-align:left;padding:3px 8px;border-bottom:1px solid var(--rule,#e4d8bc)}
.plan figcaption{font-style:italic;color:var(--faint);font-size:.8em;margin-top:4px;text-align:center}
.heaven figcaption{font-style:italic;color:var(--faint);font-size:.8em;margin-top:4px;text-align:center}
.legend{display:inline-flex;align-items:center;gap:5px}
.legend svg{width:14px;height:14px}
.plates{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:14px 0}
.plates figure{margin:0}
.plates img{display:block;width:100%;aspect-ratio:1;object-fit:cover;border-radius:6px;border:1px solid var(--rule)}
.plates figcaption{font-size:.74em;text-align:center;color:var(--faint);margin-top:3px;font-style:italic}
.epoch{margin:0 0 44px}
.epoch .numeral{font-family:var(--display);font-size:3.2em;font-weight:700;color:var(--gold);line-height:1;float:left;margin:4px 14px 0 0}
.epoch .epoch-title{overflow:hidden}
.epoch .epoch-title h3{margin:0}
.timeline{list-style:none;padding:0;margin:12px 0;border-left:2px solid var(--rule)}
.timeline li{position:relative;padding:3px 0 3px 16px;margin:0}
.timeline li::before{content:"";position:absolute;left:-6px;top:.75em;width:10px;height:10px;border-radius:50%;background:var(--paper);border:2px solid var(--gold)}
.timeline .when{font-family:var(--caps);font-size:.76em;letter-spacing:.08em;color:var(--faint);margin-right:6px}
.timeline .changes{list-style:none;padding:0;margin:4px 0 2px}
.timeline .changes li{padding:1px 0 1px 14px;font-size:.9em}
.timeline .changes li::before{left:2px;top:.72em;width:5px;height:5px;border:0;background:var(--faint)}
.council{border:1px solid var(--rule);border-radius:8px;padding:10px 14px;margin:12px 0;background:var(--card)}
.council .speech{margin:4px 0;font-size:.94em}
.council .speech b{font-family:var(--caps);font-weight:500;letter-spacing:.04em}
.verdict{font-family:var(--caps);letter-spacing:.06em}
.verdict.passed{color:var(--good)}
.verdict.rejected{color:var(--danger)}
.war{border:1px solid var(--rule);border-radius:10px;background:var(--card);padding:14px 18px;margin:0 0 22px;box-shadow:var(--shadow)}
.war .sides{display:grid;grid-template-columns:1fr auto 1fr;gap:10px;align-items:start;margin:10px 0}
.war .side{border-radius:8px;padding:8px 12px;border:1px solid var(--rule)}
.war .side.attackers{border-color:color-mix(in srgb,var(--danger) 35%,var(--rule))}
.war .side .label{font-family:var(--caps);font-size:.74em;letter-spacing:.12em;color:var(--faint);display:block}
.war .vs{font-family:var(--display);font-weight:700;font-size:1.4em;color:var(--gold);align-self:center}
.war .victor{color:var(--gold);font-weight:700}
table{border-collapse:collapse;width:100%;margin:10px 0;font-size:.9em}
th{font-family:var(--caps);font-weight:500;font-size:.8em;letter-spacing:.08em;text-transform:lowercase;color:var(--faint);text-align:left;border-bottom:2px solid var(--rule-strong);padding:6px 8px}
td{border-bottom:1px solid var(--rule);padding:5px 8px;vertical-align:top}
tr:nth-child(even) td{background:color-mix(in srgb,var(--card) 70%,transparent)}
td.word{font-weight:700;font-family:var(--display);font-size:1.12em}
.index-letter{font-family:var(--display);font-size:1.6em;color:var(--gold);border-bottom:1px solid var(--rule);margin:18px 0 6px}
.index-list{columns:2;column-gap:28px;list-style:none;padding:0;margin:0;font-size:.9em}
.index-list li{break-inside:avoid;margin:0 0 2px}
.index-list .kind{color:var(--faint);font-style:italic;font-size:.86em}
.log{columns:2;column-gap:28px;font-size:.84em;padding-left:1em}
.group-head{display:flex;align-items:baseline;gap:10px;border-bottom:1px solid var(--rule-strong);padding-bottom:4px;margin:2.2em 0 .8em}
.group-head h3,.group-head h4{margin:0}
.group-head .count{margin-left:auto;color:var(--faint);font-style:italic;font-size:.9em}
.world-entry .seal{float:right;width:150px;height:150px;border-radius:50%;object-fit:cover;border:2px solid var(--gold);margin:0 0 10px 18px;box-shadow:var(--shadow)}
.portrait-hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.6fr);gap:22px;align-items:start;margin:10px 0 18px}
.portrait-hero img{width:100%;border-radius:10px;border:1px solid var(--rule);box-shadow:var(--shadow)}
.pageref{display:none}
@media (max-width:640px){
body{font-size:17px}
main{padding:20px 16px 96px}
h1{font-size:2.5em}
.cover h1{font-size:2.8em}
.cover .seal{width:200px;height:200px}
.cover .frame{padding:28px 16px}
.thumb,.thumb.wide{float:none;width:100%;max-width:none;margin:8px 0}
.plates{grid-template-columns:repeat(2,1fr)}
.portrait-hero{grid-template-columns:1fr}
.war .sides{grid-template-columns:1fr}
.war .vs{text-align:center}
.index-list,.log{columns:1}
table{display:block;overflow-x:auto}
}
@media screen{article,.register,ul.changes,ul.log{content-visibility:auto;contain-intrinsic-size:auto 480px}}
@media print{.family .tree{overflow:visible;border:none}.family .tree svg{width:100%!important}
:root{--warn:#8a5208;--paper:#fffdf8;--paper-deep:#f6f0e2;--card:#fbf7ee;--ink:#1d1710;--soft:#3d3226;--faint:#6b5c46;--accent:#4a1a7d;--gold:#8f6510;--rule:#d8c9aa;--rule-strong:#a8926a;--secret:#2f2638;--secret-ink:#f2ebf8;--danger:#8d2618;--good:#3b5a32;--shadow:none}
@page{size:A4;margin:19mm 16mm 21mm 19mm;background:var(--paper);
@top-center{content:string(chapter);font-family:var(--caps);font-size:7.5pt;letter-spacing:.18em;color:#8f6a22;text-transform:lowercase}
@bottom-center{content:counter(page);font-family:var(--display);font-size:10pt;color:#6b5c46}}
@page :left{margin-left:16mm;margin-right:19mm}
@page :blank{@top-center{content:none}}
@page cover{margin:0;@top-center{content:none}@bottom-center{content:none}}
@page front{@top-center{content:none}@bottom-center{content:counter(page,lower-roman)}}
html,body{background:var(--paper)}
body{font-size:10pt;line-height:1.42;background-image:none;orphans:3;widows:3}
main{max-width:none;padding:0;margin:0}
.toolbar{display:none}
h1,h2,h3,h4,h5,h6{bookmark-level:none}
.chapter-head h2{bookmark-level:1;string-set:chapter content()}
.bm2{bookmark-level:2}
.bm3{bookmark-level:3}
h2{font-size:26pt}
h3{font-size:17pt}
h4{font-size:13.5pt}
h5{font-size:12pt}
.cover{page:cover;min-height:297mm;height:297mm;padding:26mm 22mm;break-after:page}
.cover .frame{height:100%;display:flex;flex-direction:column;justify-content:center}
.cover h1{font-size:46pt}
.cover .seal{width:85mm;height:85mm}
.cover .crest{width:34mm;height:34mm}
.front{page:front}
.toc{break-after:page}
.toc li a::after{content:leader(". ") target-counter(attr(href url),page);font-family:var(--serif);font-size:.75em;font-weight:400;color:#6b5c46}
.toc li{border-bottom:0}
.toc li .count{display:none}
.chapter{break-before:page;padding-top:18mm}
.chapter-head{margin-bottom:10mm}
.entry{break-inside:auto;margin-bottom:6mm;padding-bottom:4mm}
.entry .head{break-after:avoid}
.thumb{width:30%;max-width:56mm}
.thumb.wide{width:38%;max-width:68mm}
.figure img{max-height:150mm}
#encyclopedia{columns:2;column-gap:7mm;column-fill:auto}
#encyclopedia .chapter-head{column-span:all}
#encyclopedia .entry,#encyclopedia .group-head{font-size:9.5pt}
#encyclopedia .thumb,#encyclopedia .thumb.wide{width:38%;max-width:none}
#encyclopedia h3{font-size:15pt}
#encyclopedia h4{font-size:13pt}
#encyclopedia h5,#encyclopedia h6{font-size:11.5pt}
.portrait-hero{display:grid;grid-template-columns:62mm minmax(0,1fr);gap:6mm;align-items:start;break-inside:avoid}
.portrait-hero>img{width:62mm;margin:0}
.portrait-hero>div{min-width:0}
.portrait-hero .stats{justify-content:flex-start}
.stats,.chips{display:block}
.stats li,.chips li{display:inline-block;margin:0 4px 4px 0;vertical-align:top}
.facts{display:block;background:none;border:0;border-top:1px solid var(--rule);border-radius:0}
.facts div{display:inline-block;width:32%;vertical-align:top;background:none;padding:1.5mm 2mm;border-bottom:1px solid var(--rule)}
.plates{display:block}
.plates figure{display:inline-block;width:31.5%;margin:0 1.5% 3mm 0;vertical-align:top}
.plates img{height:auto}
.war .sides{display:table;width:100%;border-spacing:3mm 0}
.war .sides>*{display:table-cell;vertical-align:top}
.war .vs{width:10mm;text-align:center;vertical-align:middle}
.map{break-before:page;break-inside:avoid}
.map .sheet{outline:0}
.plates figure,.secret,.facts,.war .sides,figure{break-inside:avoid}
.epoch{break-inside:auto}
.index-list,.log{column-gap:8mm}
.pageref{display:inline;color:#6b5c46;font-size:.85em}
.pageref::after{content:target-counter(attr(href url),page)}
a{color:inherit}
table{font-size:8.6pt}
tr{break-inside:avoid}
thead{display:table-header-group}
}
</style>
</head>
<body>
{% macro icon(name, extra="") %}<svg class="icon{% if extra %} {{ extra }}{% endif %}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{% if name == "back" %}<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>{% elif name == "contents" %}<path d="M3 6h.01"/><path d="M3 12h.01"/><path d="M3 18h.01"/><path d="M8 6h13"/><path d="M8 12h13"/><path d="M8 18h13"/>{% elif name == "index" %}<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20"/><path d="m8 13 4-7 4 7"/><path d="M9.1 11h5.7"/>{% elif name == "book" %}<path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/>{% elif name == "generate" %}<path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M12 18v-6"/><path d="M9 15h6"/>{% elif name == "download" %}<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/><path d="M12 15V3"/>{% elif name == "print" %}<path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><path d="M6 9V3a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6"/><rect x="6" y="14" width="12" height="8" rx="1"/>{% elif name == "spinner" %}<path d="M21 12a9 9 0 1 1-6.219-8.56"/>{% elif name == "check" %}<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>{% elif name == "warn" %}<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/>{% elif name == "empty" %}<circle cx="12" cy="12" r="10"/><path d="M8 12h8"/>{% endif %}</svg>{% endmacro %}
{% if not links.printing %}
<header class="toolbar">
<div class="bar">
<a class="back" href="/" aria-label="Back to Weavers of the Void" title="Back to Weavers of the Void">{{ icon("back") }}</a>
<div class="heading"><span class="eyebrow">{% if single %}From the book{% else %}The book of the world{% endif %}</span><span class="title">{% block toolbar_title %}{{ self.title() }}{% endblock %}</span></div>
<nav class="group jump" aria-label="Book sections">
{% if not single %}
<a class="tool" href="#contents" data-tip="Jump to the table of contents">{{ icon("contents") }}<span class="label">Contents</span></a>
<a class="tool" href="#index" data-tip="Jump to the index of every name">{{ icon("index") }}<span class="label">Index</span></a>
{% else %}
<a class="tool" href="/api/book" data-tip="Open the whole book">{{ icon("book") }}<span class="label">Whole book</span></a>
{% endif %}
</nav>
<span class="sep" aria-hidden="true"></span>
<div class="group actions" role="group" aria-label="PDF and printing">
{% if pdf is not none %}
<button type="button" id="pdf-make" class="tool{% if not pdf.ready or pdf.stale %} primary{% endif %}" aria-describedby="pdf-state-text" data-tip="{% if pdf.ready %}Typeset the whole book again and replace the stored PDF{% else %}Typeset the whole book into a PDF on the server{% endif %}">{{ icon("generate", "rest") }}{{ icon("spinner", "spin") }}<span class="label" id="pdf-make-label">{% if pdf.ready %}Regenerate PDF{% else %}Generate PDF{% endif %}</span></button>
<a id="pdf-download" class="tool{% if pdf.ready and not pdf.stale %} primary{% endif %}" data-url="{{ pdf.url }}" aria-describedby="pdf-state-text" {% if pdf.ready %}href="{{ pdf.url }}" download data-tip="Download the PDF"{% else %}role="link" tabindex="0" aria-disabled="true" data-tip="Generate the PDF first; there is nothing to download yet"{% endif %}>{{ icon("download") }}<span class="label">Download PDF</span><span class="size" id="pdf-size">{% if pdf.ready %}{{ pdf.size_mb }} MB{% endif %}</span></a>
{% endif %}
<button type="button" id="print-book" class="tool" data-tip="Open your browser's print dialog for this page">{{ icon("print") }}<span class="label">Print</span></button>
</div>
</div>
{% if pdf is not none %}
<div class="status" id="pdf" data-state="{% if not pdf.ready %}none{% elif pdf.stale %}stale{% else %}ready{% endif %}" role="status" aria-live="polite">
<span class="chip">{{ icon("empty", "when-none") }}{{ icon("check", "when-ready") }}{{ icon("warn", "when-stale") }}{{ icon("spinner", "when-running") }}<span id="pdf-state-text">{% if not pdf.ready %}No PDF yet: generate it to download{% elif pdf.stale %}PDF out of date: made at epoch {{ pdf.epoch }}, the world is at epoch {{ pdf.world_epoch }}{% else %}PDF up to date, made at epoch {{ pdf.epoch }}{% endif %}</span></span>
<span class="meter" id="pdf-meter" hidden><span id="pdf-meter-fill"></span></span>
<span class="note" id="pdf-note"></span>
</div>
{% endif %}
</header>
{% endif %}
<main>
{% block body %}{% endblock %}
</main>
{% if not links.printing %}
<script nonce="{{ nonce }}">
(function () {
  document.getElementById("print-book").addEventListener("click", function () { window.print(); });
  var holder = document.getElementById("pdf");
  if (!holder) return;
  var make = document.getElementById("pdf-make");
  var makeLabel = document.getElementById("pdf-make-label");
  var download = document.getElementById("pdf-download");
  var size = document.getElementById("pdf-size");
  var stateText = document.getElementById("pdf-state-text");
  var meter = document.getElementById("pdf-meter");
  var fill = document.getElementById("pdf-meter-fill");
  var note = document.getElementById("pdf-note");
  var polling = false;
  var starting = false;
  function message(body) {
    if (!body) return "Something went wrong.";
    if (typeof body.message === "string") return body.message;
    if (body.error && typeof body.error.message === "string") return body.error.message;
    if (typeof body.detail === "string") return body.detail;
    return "Something went wrong.";
  }
  function busy(on, label) {
    make.classList.toggle("busy", on);
    make.setAttribute("aria-disabled", on ? "true" : "false");
    if (on) {
      make.classList.remove("primary");
      makeLabel.textContent = label;
      make.dataset.tip = "The book is being typeset; wait for it to finish";
    }
  }
  function offer(state) {
    if (state.ready) {
      var megabytes = (state.size / 1048576).toFixed(1);
      download.href = download.dataset.url;
      download.setAttribute("download", "");
      download.removeAttribute("aria-disabled");
      download.removeAttribute("role");
      download.removeAttribute("tabindex");
      download.dataset.tip = "Download the PDF (" + megabytes + " MB)";
      size.textContent = megabytes + " MB";
    } else {
      download.removeAttribute("href");
      download.removeAttribute("download");
      download.setAttribute("role", "link");
      download.setAttribute("tabindex", "0");
      download.setAttribute("aria-disabled", "true");
      download.dataset.tip = "Generate the PDF first; there is nothing to download yet";
      size.textContent = "";
    }
  }
  function show(state) {
    offer(state);
    if (state.job_id) {
      var percent = Math.round((state.progress || 0) * 100);
      holder.dataset.state = "running";
      busy(true, "Typesetting " + percent + "%");
      download.classList.remove("primary");
      stateText.textContent = state.stage ? "Typesetting: " + state.stage + "…" : "Typesetting the book…";
      meter.hidden = false;
      fill.style.width = Math.max(4, percent) + "%";
      note.textContent = "";
      polling = true;
      setTimeout(poll, 2000);
      return;
    }
    starting = false;
    busy(false);
    meter.hidden = true;
    makeLabel.textContent = state.ready ? "Regenerate PDF" : "Generate PDF";
    make.dataset.tip = state.ready ? "Typeset the whole book again and replace the stored PDF" : "Typeset the whole book into a PDF on the server";
    make.classList.toggle("primary", !state.ready || Boolean(state.stale));
    download.classList.toggle("primary", Boolean(state.ready) && !state.stale);
    holder.dataset.state = !state.ready ? "none" : state.stale ? "stale" : "ready";
    stateText.textContent = !state.ready
      ? "No PDF yet: generate it to download"
      : state.stale
        ? "PDF out of date: made at epoch " + state.epoch + ", the world is at epoch " + state.world_epoch
        : "PDF up to date, made at epoch " + state.epoch;
    if (polling) {
      polling = false;
      note.textContent = state.ready ? "Your PDF is ready to download." : "";
    }
  }
  function lost() {
    starting = false;
    busy(false);
    makeLabel.textContent = download.hasAttribute("href") ? "Regenerate PDF" : "Generate PDF";
    note.textContent = "Lost touch with the server. Try again.";
  }
  function poll() {
    fetch("/api/book/pdf", { headers: { accept: "application/json" } })
      .then(function (response) { return response.json(); })
      .then(show)
      .catch(lost);
  }
  download.addEventListener("click", function (event) {
    if (download.getAttribute("aria-disabled") === "true") event.preventDefault();
  });
  make.addEventListener("click", function () {
    if (starting || make.getAttribute("aria-disabled") === "true") return;
    starting = true;
    busy(true, "Starting…");
    holder.dataset.state = "running";
    stateText.textContent = "Starting the typesetting…";
    note.textContent = "";
    fetch("/api/book/pdf", { method: "POST", headers: { accept: "application/json" } })
      .then(function (response) {
        if (response.ok) { polling = true; setTimeout(poll, 600); return null; }
        return response.json().then(function (body) { lost(); note.textContent = message(body); poll(); });
      })
      .catch(lost);
  });
  poll();
})();
</script>
{% endif %}
</body>
</html>
