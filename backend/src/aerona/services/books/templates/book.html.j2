{% extends "layout.html.j2" %}
{% from "macros.html.j2" import link, facts, stats, chips, thumb, entity_depth, god_depth, personality, epic, picture, entity_article, son_article, god_article, chronicle_lines, chapter_head %}
{% block title %}{{ book.cosmos.name }}{% endblock %}
{% block body %}
{% set world_count = book.stars | sum(attribute="worlds", start=[]) | length %}
{% set parts = [] %}
{% if book.cosmos.cosmology or book.laws %}{% set _ = parts.append(("cosmology", "Cosmology", "How the world began")) %}{% endif %}
{% if book.creator %}{% set _ = parts.append(("creator", book.creator.name, book.creator.title or "The Creator")) %}{% endif %}
{% set _ = parts.append(("cosmos", "The Heavens", world_count ~ " worlds")) %}
{% if book.foreign_gods %}{% set _ = parts.append(("foreign-gods", "Foreign Gods", book.foreign_gods | length ~ " gods")) %}{% endif %}
{% if book.sons %}{% set _ = parts.append(("pantheon", "The Pantheon", book.sons | length ~ " children")) %}{% endif %}
{% if book.chapters %}{% set _ = parts.append(("epochs", "The Epochs", book.chapters | length ~ " books")) %}{% endif %}
{% if book.wars %}{% set _ = parts.append(("wars", "Wars", book.wars | length ~ " wars")) %}{% endif %}
{% set _ = parts.append(("encyclopedia", "Encyclopedia", book.record_count ~ " records")) %}
{% if book.knowledge %}{% set _ = parts.append(("knowledge", "Knowledge", book.knowledge | length ~ " discoveries")) %}{% endif %}
{% if book.languages %}{% set _ = parts.append(("languages", "Tongues and Dictionaries", book.languages | length ~ " languages")) %}{% endif %}
{% if book.open_threads or book.closed_threads or book.facts or book.prayers %}{% set _ = parts.append(("stories", "Stories, Facts and Prayers", "")) %}{% endif %}
{% if book.achievements or book.scenarios or book.scores %}{% set _ = parts.append(("achievements", "Deeds and Trials", book.achievements | length ~ " achievements")) %}{% endif %}
{% if book.ledger %}{% set _ = parts.append(("ledger", "Fate's Ledger", book.ledger | length ~ " entries")) %}{% endif %}
{% if book.chapters | selectattr("raw_lines") | list %}{% set _ = parts.append(("event-log", "Event Log", "")) %}{% endif %}
{% set _ = parts.append(("index", "Index", "")) %}
{% macro numeral(id) -%}{% for part in parts %}{% if part[0] == id %}{{ ["I","II","III","IV","V","VI","VII","VIII","IX","X","XI","XII","XIII","XIV","XV","XVI","XVII"][loop.index0] }}{% endif %}{% endfor %}{%- endmacro %}

<section class="cover">
<div class="frame">
<img class="crest" src="{{ links.logo() }}" alt="Weavers of the Void">
<p class="overline">The book of</p>
<h1>{{ book.cosmos.name }}</h1>
{% if book.creator %}<p class="subtitle">as witnessed by {{ book.creator.name }}{% if book.creator.title %}, {{ book.creator.title }}{% endif %}</p>{% endif %}
{% if book.cover %}<img class="seal" src="{{ links.media(book.cover, 'cover') }}" alt="{{ book.cosmos.name }}">{% endif %}
<div class="tally">
<span><b>{{ book.epochs_count }}</b>epochs</span>
<span><b>{{ book.world_year }}</b>years</span>
<span><b>{{ book.sons | length }}</b>children</span>
<span><b>{{ world_count }}</b>worlds</span>
<span><b>{{ book.record_count }}</b>records</span>
</div>
<span class="ornament">&#10087;</span>
<p class="imprint">Weavers of the Void® · Worldbuilding Studio</p>
</div>
</section>

<section class="front toc" id="contents">
<header class="chapter-head"><p class="part">&#160;</p><h2>Contents</h2><span class="ornament">&#10087;</span></header>
<ol>{% for id, title, count in parts %}<li><a href="#{{ id }}">{{ title }}</a>{% if count %}<span class="count">{{ count }}</span>{% endif %}</li>{% endfor %}</ol>
</section>

{% if book.cosmos.cosmology or book.laws %}
<section class="chapter" id="cosmology">
{{ chapter_head("cosmology", numeral("cosmology"), "Cosmology", book.cosmos.tone) }}
{{ book.cosmos.cosmology | paragraphs }}
{% if book.cosmos.seed_idea %}<div class="box"><span class="label">The seed of creation</span>{{ book.cosmos.seed_idea }}</div>{% endif %}
{% if book.laws %}<h3 class="bm2">Laws of nature</h3>{% for law in book.laws %}{{ entity_article(law, false, links) }}{% endfor %}{% endif %}
</section>
{% endif %}

{% if book.creator %}
<section class="chapter" id="creator">
{{ chapter_head("creator", numeral("creator"), book.creator.name, book.creator.title) }}
<div class="portrait-hero">
{% if book.creator_cover %}<img src="{{ links.media(book.creator_cover, 'portrait') }}" alt="{{ book.creator.name }}">{% else %}<div></div>{% endif %}
<div>
<ul class="stats"><li>Contentment<b>{{ book.creator.mood_contentment }}</b></li><li>Anger<b>{{ book.creator.mood_anger }}</b></li><li>Interest<b>{{ book.creator.mood_interest }}</b></li><li>Loneliness<b>{{ book.creator.mood_loneliness }}</b></li></ul>
{% if book.creator.passions %}<p class="sublabel">Passions</p>{{ chips(book.creator.passions) }}{% endif %}
{% if book.creator.note %}<div class="box"><span class="label">The creator's own note</span>{{ book.creator.note }}</div>{% endif %}
</div>
</div>
{% if book.creator.appearance %}<p class="sublabel">Appearance</p>{{ book.creator.appearance | paragraphs }}{% endif %}
{% if book.creator.temperament %}<p class="sublabel">Temperament</p>{{ book.creator.temperament | paragraphs }}{% endif %}
{{ epic(book.creator.epic) }}
{{ god_depth(book.creator.depth) }}
{% if book.creator_beliefs %}<h3 class="bm2">Through the peoples' eyes</h3>{% for belief in book.creator_beliefs %}<div class="quote"><span class="label">{{ book.names.get(belief.people_entity_id, "?") }} call {{ book.creator.name }} “{{ belief.local_name or book.creator.name }}”</span>{{ belief.account }}{% if belief.misconception %}<cite>Misconception: {{ belief.misconception }}</cite>{% endif %}</div>{% endfor %}{% endif %}
{% if book.creator_hand %}<h3 class="bm2" id="creator-hand">The Creator's hand</h3>{% for hand in book.creator_hand %}<h5>Epoch {{ hand.epoch }}</h5><ul class="timeline">{% for deed in hand.deeds %}<li>{{ deed.text }}{% if deed.undone %} <span class="meta">(undone)</span>{% endif %}{% if deed.unledgered %} <span class="meta">(of its own accord)</span>{% endif %}</li>{% endfor %}</ul>{% endfor %}{% endif %}
</section>
{% endif %}

<section class="chapter" id="cosmos">
{{ chapter_head("cosmos", numeral("cosmos"), "The Heavens", "Stars, worlds and the roads between them") }}
{% for section in book.stars %}
{% if section.star %}
<article class="entry" id="{{ section.anchor }}">
<div class="head"><h3 class="bm2">{{ section.star.name }}</h3><span class="kind">star</span></div>
{{ thumb(section.cover, section.star.name, links) }}
{{ facts(section.facts) }}
{{ section.star.description | paragraphs }}
{{ entity_depth(section.star.depth) }}
<div class="clear"></div>
</article>
{% elif section.worlds %}<h3 class="bm2">Wandering worlds</h3>{% endif %}
{% for world in section.worlds %}
{% set level = [4 + world.depth_level, 6] | min %}
<article class="entry world-entry" id="{{ world.anchor }}">
<div class="head"><h{{ level }} class="bm3">{{ world.world.name }}</h{{ level }}><span class="kind">{{ world.meta | join(" · ") }}</span></div>
{% if world.cover %}<img class="seal" src="{{ links.media(world.cover, 'article') }}" alt="{{ world.world.name }}" loading="lazy" decoding="async">{% endif %}
{{ world.world.description | paragraphs }}
{{ facts(world.facts) }}
<div class="clear"></div>
{{ picture(world.picture, links, world.world.name ~ ": the known world") }}
{% if world.world.cosmology %}<p class="sublabel">What its peoples believe</p>{{ world.world.cosmology | paragraphs }}{% endif %}
{{ entity_depth(world.world.depth) }}
{% set guide = world.guide %}
{% if guide.dangers or guide.peoples or guide.resources or guide.routes or guide.foreign_gods or guide.sky %}
<div class="box"><span class="label">Traveller's guide</span>
{% if guide.climate %}<p><b class="small">Climate.</b> {{ guide.climate }}{% if guide.climate_epochs_left %} <span class="meta">for {{ guide.climate_epochs_left }} more epochs</span>{% endif %}</p>{% endif %}
{% if guide.dangers %}<p><b class="small">Dangers.</b> {% for danger in guide.dangers %}{{ danger.name }} <span class="meta">({{ danger.reason }})</span>{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
{% if guide.peoples %}<p><b class="small">Peoples.</b> {% for people in guide.peoples %}{{ link("entity", people.id, people.name, false) }} <span class="meta">{{ people.population }}{% if people.language %}, speaking {{ people.language }}{% endif %}{% if people.god %}, worshipping {{ people.god }}{% endif %}</span>{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
{% if guide.resources %}<p><b class="small">Riches.</b> {% for resource in guide.resources %}{{ link("entity", resource.id, resource.name, false) }}{% if resource.mechanics %} <span class="meta">[{{ resource.mechanics }}]</span>{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
{% if guide.routes %}<p><b class="small">Roads out.</b> {% for route in guide.routes %}{{ route.target }} <span class="meta">({{ route.method }}, {{ route.duration }} epochs, danger {{ route.danger }}{% if not route.active %}, sealed{% endif %}{% if not route.known %}, unknown{% endif %})</span>{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
{% if guide.foreign_gods %}<p><b class="small">Gods of this world.</b> {% for god in guide.foreign_gods %}<a href="#foreign-god-{{ god.id }}">{{ god.name }}</a>{% if god.title %} <span class="meta">{{ god.title }}</span>{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
{% if guide.sky %}<p><b class="small">In the sky.</b> {% for body in guide.sky %}{{ link("entity", body.id, body.name, false) }}{% if not loop.last %}; {% endif %}{% endfor %}</p>{% endif %}
</div>
{% endif %}
</article>
{% endfor %}
{% endfor %}
{% if book.routes %}<h3 class="bm2">Roads between worlds</h3><table><thead><tr><th>Between</th><th>Way</th><th>Epochs</th><th>Danger</th><th>Opened</th></tr></thead><tbody>{% for first, second, route in book.routes %}<tr><td>{{ first }} &#8596; {{ second }}{% if route.description %}<br><span class="meta small">{{ route.description }}</span>{% endif %}</td><td>{{ route.method.value | replace("_", " ") }}{% if not route.active %} <span class="meta">sealed</span>{% endif %}{% if not route.known %} <span class="meta">unknown</span>{% endif %}</td><td>{{ route.duration_epochs }}</td><td>{{ route.danger }}</td><td>Epoch {{ route.created_epoch }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if book.journeys %}<h3 class="bm2">Journeys</h3><ul class="timeline">{% for traveller, journey in book.journeys %}<li><span class="when">Epoch {{ journey.start_epoch }}</span>{{ traveller }} · {{ journey.intent.value | replace("_", " ") }} · <i>{{ journey.status.value | replace("_", " ") }}</i></li>{% endfor %}</ul>{% endif %}
</section>

{% if book.foreign_gods %}
<section class="chapter" id="foreign-gods">
{{ chapter_head("foreign-gods", numeral("foreign-gods"), "Foreign Gods", "Powers that were not born of the Creator") }}
{% for article in book.foreign_gods %}{{ god_article(article, links) }}{% endfor %}
</section>
{% endif %}

{% if book.sons %}
<section class="chapter" id="pantheon">
{{ chapter_head("pantheon", numeral("pantheon"), "The Pantheon", "The Creator's children, in the order they were born") }}
{% for article in book.sons %}{{ son_article(article, false, links) }}{% endfor %}
</section>
{% endif %}

{% if book.chapters %}
<section class="chapter" id="epochs">
{{ chapter_head("epochs", numeral("epochs"), "The Epochs", book.epochs_count ~ " epochs, " ~ book.world_year ~ " years") }}
{% if book.cosmic %}
{% set world_names = book.cosmic | map(attribute="worlds") | sum(start=[]) | map(attribute="name") | unique | list %}
<h3 class="bm2">The cosmic chronicle</h3>
<table><thead><tr><th>Epoch</th>{% for name in world_names %}<th>{{ name }}</th>{% endfor %}</tr></thead><tbody>
{% for epoch in book.cosmic %}<tr><td>{{ epoch.epoch }}{% if epoch.name %}<br><span class="meta small">{{ epoch.name }}</span>{% endif %}</td>{% for name in world_names %}{% set found = epoch.worlds | selectattr("name", "equalto", name) | list %}<td class="small">{{ found[0].headlines[:2] | join("; ") if found else "" }}</td>{% endfor %}</tr>{% endfor %}
</tbody></table>
{% endif %}
{% for chapter in book.chapters %}
<article class="epoch" id="{{ chapter.anchor }}">
<span class="numeral">{{ chapter.numeral }}</span>
<div class="epoch-title">
<p class="overline">Book {{ chapter.numeral }}{% if chapter.row and chapter.row.year_start is not none %} · years {{ chapter.row.year_start }}–{{ chapter.row.year_end }}{% endif %}</p>
<h3 class="bm2">{% if chapter.row and chapter.row.name %}{{ chapter.row.name }}{% else %}Epoch {{ chapter.epoch }}{% endif %}</h3>
</div>
<div class="clear"></div>
{% if chapter.row %}
{% if chapter.row.summary %}<p class="lede">{{ chapter.row.summary }}</p>{% endif %}
{% if chapter.row.chronicler_name %}<p class="meta small">Set down by {{ chapter.row.chronicler_name }}{% if chapter.row.chronicler_identity %}, {{ chapter.row.chronicler_identity }}{% endif %}</p>{% endif %}
{% endif %}
{% if chapter.plates %}<div class="plates">{% for id, name, cover in chapter.plates %}<figure><a href="#entity-{{ id }}"><img src="{{ links.media(cover, 'plate') }}" alt="{{ name }}" loading="lazy" decoding="async"></a><figcaption>{{ name }}</figcaption></figure>{% endfor %}</div>{% endif %}
{% if chapter.row %}{{ chapter.row.narrative | paragraphs }}{% endif %}
{% for world_name, narrative in chapter.world_chapters %}<h5>On {{ world_name }}</h5>{{ narrative.narrative | paragraphs }}{% endfor %}
{% if chapter.stats %}<ul class="stats"><li>Population<b>{{ chapter.stats.population }}</b></li><li>Followers<b>{{ chapter.stats.followers }}</b></li><li>Records<b>{{ chapter.stats.entities }}</b></li><li>Languages<b>{{ chapter.stats.languages }}</b></li><li>Words<b>{{ chapter.stats.words }}</b></li><li>Knowledge<b>{{ chapter.stats.knowledge }}</b></li><li>Wars<b>{{ chapter.stats.wars }}</b></li><li>Trade<b>{{ chapter.stats.trade_routes }}</b></li><li>Alliances<b>{{ chapter.stats.alliances }}</b></li><li>Dead<b>{{ chapter.stats.dead }}</b></li></ul>{% endif %}
{% for people, view in chapter.perspectives %}<div class="quote">{{ view.text }}<cite>As {{ people }}'s historian tells it{% if view.historian %} · {{ view.historian }}{% endif %}</cite></div>{% endfor %}
{% for council in chapter.councils %}<div class="council"><span class="label overline">Council</span><h5>{{ council.topic }}</h5>{% for speech in council.minutes.speeches %}<p class="speech"><b>{{ speech.name }}.</b> {{ speech.words }}</p>{% endfor %}<p><i>{{ council.minutes.motion }}</i> — <span class="verdict {{ 'passed' if council.passed else 'rejected' }}">{{ "passed" if council.passed else "rejected" }}</span>. {{ council.minutes.decision }}</p></div>{% endfor %}
{% if chapter.lines %}<p class="sublabel">Chronicle</p>{{ chronicle_lines(chapter.lines, book, false) }}{% endif %}
{% if chapter.born %}<p class="meta small">Born in this epoch: {% for id, name in chapter.born %}{{ link("entity", id, name, false) }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
</article>
{% endfor %}
</section>
{% endif %}

{% if book.wars %}
<section class="chapter" id="wars">
{{ chapter_head("wars", numeral("wars"), "Wars", "Every war, its sides, its battles and its end") }}
{% for war in book.wars %}
<article class="war" id="{{ war.anchor }}">
<div class="head"><h4 class="bm3"><a href="#{{ war.event_anchor }}">{{ war.name }}</a></h4></div>
<p class="meta small">{{ war.world }} · {{ war.war.cause.value | replace("_", " ") }} · {% if war.war.ended_epoch is not none %}epochs {{ war.war.started_epoch }}–{{ war.war.ended_epoch }}{% else %}since epoch {{ war.war.started_epoch }}, {{ war.war.status.value }}{% endif %}{% if war.war.ending %} · ended in {{ war.war.ending.value | replace("_", " ") }}{% endif %}{% if war.instigator %} · stirred by {{ war.instigator }}{% endif %}</p>
{% if war.war.cause_text %}<p>{{ war.war.cause_text }}</p>{% endif %}
<div class="sides">
<div class="side attackers"><span class="label">Attackers</span>{% for name in war.attackers %}<div{% if name == war.victor %} class="victor"{% endif %}>{{ name }}</div>{% else %}<div class="meta">no one</div>{% endfor %}</div>
<span class="vs">vs</span>
<div class="side"><span class="label">Defenders</span>{% for name in war.defenders %}<div{% if name == war.victor %} class="victor"{% endif %}>{{ name }}</div>{% else %}<div class="meta">no one</div>{% endfor %}</div>
</div>
<ul class="stats"><li>Battles<b>{{ war.war.battles }}</b></li><li>Momentum<b>{{ war.war.score }}</b></li>{% if war.war.violence is not none %}<li>Violence<b>{{ war.war.violence }}</b></li>{% endif %}{% if war.victor %}<li>Victor<b>{{ war.victor }}</b></li>{% endif %}</ul>
{% if war.battles %}<table><thead><tr><th>Epoch</th><th>Battle</th><th>Victor</th><th>Defeated</th><th>Outcome</th></tr></thead><tbody>{% for battle in war.battles %}<tr><td>{{ battle.epoch }}</td><td>{{ battle.name or ("Battle " ~ battle.sequence) }}{% if battle.place %}<br><span class="meta small">at {{ battle.place }}</span>{% endif %}</td><td>{{ battle.winner }}</td><td>{{ battle.loser }}</td><td>{{ battle.outcome }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if war.sieges %}<p class="sublabel">Sieges</p><ul class="timeline">{% for siege in war.sieges %}<li><span class="when">Epoch {{ siege.started_epoch }}{% if siege.ended_epoch is not none %}–{{ siege.ended_epoch }}{% endif %}</span>{{ siege.besieger }} besieged {{ siege.besieged }} · {{ siege.status }}, {{ siege.rounds }} rounds</li>{% endfor %}</ul>{% endif %}
</article>
{% endfor %}
</section>
{% endif %}

<section class="chapter" id="encyclopedia">
{{ chapter_head("encyclopedia", numeral("encyclopedia"), "Encyclopedia", book.record_count ~ " records of everything that is and was") }}
{% for group in book.encyclopedia %}
{% if group.name %}<div class="group-head"><h3 class="bm2">{{ group.name }}</h3></div>{% endif %}
{% for label, articles in group.groups %}
<div class="group-head"><h4 class="{{ 'bm3' if group.name else 'bm2' }}">{{ label }}</h4><span class="count">{{ articles | length }}</span></div>
{% for article in articles %}{{ entity_article(article, false, links) }}{% endfor %}
{% endfor %}
{% endfor %}
</section>

{% if book.knowledge %}
<section class="chapter" id="knowledge">
{{ chapter_head("knowledge", numeral("knowledge"), "Knowledge", "What the mortals have learned, and who knows it") }}
<table><thead><tr><th>Discovery</th><th>Branch</th><th>Level</th><th>Known by</th></tr></thead><tbody>
{% for item, branch, level, knowers in book.knowledge %}<tr><td><a href="#entity-{{ item.id }}"><b>{{ item.name }}</b></a></td><td>{{ branch or "" }}</td><td>{{ level if level is not none else "" }}</td><td class="small">{{ knowers | join(", ") }}</td></tr>{% endfor %}
</tbody></table>
</section>
{% endif %}

{% if book.languages %}
<section class="chapter" id="languages">
{{ chapter_head("languages", numeral("languages"), "Tongues and Dictionaries", "Every language and every word") }}
{% for language in book.languages %}
{{ entity_article(language.article, false, links) }}
<p class="meta small">{{ language.words | length }} words · {% if language.speakers %}spoken by {{ language.speakers | join(", ") }}{% else %}a dead language{% endif %}</p>
{% if language.words %}<table><thead><tr><th>Word</th><th>Kind</th><th>Meaning</th><th>Origin</th><th>Example</th></tr></thead><tbody>{% for word in language.words %}<tr><td class="word">{{ word.word }}</td><td class="meta">{{ word.part_of_speech.value if word.part_of_speech else "" }}</td><td>{{ word.meaning }}</td><td class="small">{{ word.etymology or "" }}</td><td class="small"><i>{{ word.example or "" }}</i></td></tr>{% endfor %}</tbody></table>{% endif %}
{% endfor %}
</section>
{% endif %}

{% if book.open_threads or book.closed_threads or book.facts or book.prayers %}
<section class="chapter" id="stories">
{{ chapter_head("stories", numeral("stories"), "Stories, Facts and Prayers") }}
{% if book.open_threads %}<h3 class="bm2">Stories still unfolding</h3><ul class="timeline">{% for thread in book.open_threads %}<li><span class="when">Epoch {{ thread.epoch }}</span>{{ thread.text }}</li>{% endfor %}</ul>{% endif %}
{% if book.closed_threads %}<h3 class="bm2">Stories that ended</h3><ul class="timeline">{% for thread in book.closed_threads %}<li><span class="when">Epochs {{ thread.epoch }}–{{ thread.closed_epoch }}</span>{{ thread.text }}{% if thread.closing_text %} <i>— {{ thread.closing_text }}</i>{% endif %}</li>{% endfor %}</ul>{% endif %}
{% if book.facts %}<h3 class="bm2">Canon facts</h3><table><thead><tr><th>Subject</th><th>Fact</th><th>Object</th><th>Epoch</th></tr></thead><tbody>{% for subject, fact, target in book.facts %}<tr><td>{{ subject }}</td><td><i>{{ fact.predicate | replace("_", " ") }}</i></td><td>{{ target }}</td><td>{{ fact.epoch }}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if book.prayers %}<h3 class="bm2">Prayers and answers</h3>{% for sender, recipient, message in book.prayers %}<div class="quote"><span class="label">{{ sender }} &#8594; {{ recipient }} · {{ message.intent.value | replace("_", " ") }}{% if message.request %} · {{ message.request.value | replace("_", " ") }}{% endif %}</span>{{ message.text }}</div>{% endfor %}{% endif %}
</section>
{% endif %}

{% if book.achievements or book.scenarios or book.scores %}
<section class="chapter" id="achievements">
{{ chapter_head("achievements", numeral("achievements"), "Deeds and Trials") }}
{% if book.scores %}<ul class="stats"><li>Score<b>{{ book.scores[-1].total }}</b></li><li>Achievements<b>{{ book.achievements | length }}</b></li></ul>{% endif %}
{% if book.achievements %}<h3 class="bm2">Achievements</h3><ul class="timeline">{% for name, epoch in book.achievements %}<li><span class="when">Epoch {{ epoch }}</span>{{ name }}</li>{% endfor %}</ul>{% endif %}
{% if book.scenarios %}<h3 class="bm2">Trials</h3><table><thead><tr><th>Trial</th><th>State</th><th>Epochs</th></tr></thead><tbody>{% for name, scenario in book.scenarios %}<tr><td>{{ name }}</td><td>{{ scenario.status.value | replace("_", " ") }}</td><td>{{ scenario.start_epoch }}{% if scenario.end_epoch %}–{{ scenario.end_epoch }}{% endif %}</td></tr>{% endfor %}</tbody></table>{% endif %}
{% if book.scores %}<h3 class="bm2">Score by epoch</h3><ul class="stats">{% for score in book.scores %}<li>E{{ score.epoch }}<b>{{ score.total }}</b></li>{% endfor %}</ul>{% endif %}
</section>
{% endif %}

{% if book.ledger %}
<section class="chapter" id="ledger">
{{ chapter_head("ledger", numeral("ledger"), "Fate's Ledger", "Every hand laid upon the world") }}
<ul class="timeline">{% for entry in book.ledger %}<li><span class="when">Epoch {{ entry.epoch }}</span>{{ entry.actor_name }} · {{ entry.tool | replace("_", " ") | replace(":", " ") }}{% if entry.undone %} <span class="meta">undone</span>{% endif %}{% if entry.input_summary %} <span class="meta small">— {{ entry.input_summary }}</span>{% endif %}</li>{% endfor %}</ul>
</section>
{% endif %}

{% if book.chapters | selectattr("raw_lines") | list %}
<section class="chapter" id="event-log">
{{ chapter_head("event-log", numeral("event-log"), "Event Log", "The engine's own terse record") }}
{% for chapter in book.chapters if chapter.raw_lines %}<h5>Epoch {{ chapter.epoch }}</h5><ul class="log">{% for line in chapter.raw_lines %}<li>{{ line }}</li>{% endfor %}</ul>{% endfor %}
</section>
{% endif %}

<section class="chapter" id="index">
{{ chapter_head("index", numeral("index"), "Index") }}
{% for letter, entries in book.index.items() %}<div class="index-letter">{{ letter }}</div><ul class="index-list">{% for entry in entries %}<li><a href="#{{ entry.anchor }}">{{ entry.name }}</a> <span class="kind">{{ entry.kind }}</span> <a class="pageref" href="#{{ entry.anchor }}"></a></li>{% endfor %}</ul>{% endfor %}
</section>
{% endblock %}
