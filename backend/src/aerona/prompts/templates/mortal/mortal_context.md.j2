{% from "shared/macros.md.j2" import entity_line, chronicle_rows %}
{% set m = rules.mortal_tools %}
{% set c = rules.context %}
{% set trim = c.budget_trim_min_chars %}
{% set header = world_header ~ "\n" ~ world_line %}
{% set you_text = "\nYOU:\n" ~ budget(self_detail, m.ctx_self_chars, "look at yourself with inspect_entity", trim) %}
{% set character_text %}
{% if character %}

YOUR CHARACTER AND WAY OF LIFE:
{% set body %}
{% for item in character %}
- {{ item.label }}: {{ item.value }}
{% endfor %}
{% endset %}
{{ budget(body | trim, m.ctx_character_chars, "look at yourself with inspect_entity", trim) }}
{% endif %}
{% endset %}
{% set god_text %}

YOUR GOD: {% if god.kind == "son" %}son#{{ god.id }} {{ god.name }}{% if god.title %}, {{ god.title }}{% endif %} ({{ god.domain_1 }}/{{ god.domain_2 }}){% elif god.kind == "foreign_god" %}foreign god {{ god.name }}{% if god.title %}, {{ god.title }}{% endif %} (foreign#{{ god.id }}; not of the pantheon){% else %}you do not worship anyone yet{% endif %}

{% if folk_gods %}

THE GODS IN YOUR TELLING (call them by these names when you speak):
{% for item in folk_gods %}
- {{ item.name }} (son#{{ item.son_id }}): {{ item.story }}
{% endfor %}
{% endif %}
{% endset %}
{% set language_text %}

YOUR LANGUAGE: {% if language %}#{{ language.id }} {{ language.name }}. From its lexicon: {% if language.words %}{% for word in language.words[:30] %}{{ word.word }} = {{ word.meaning }}{% if not loop.last %}; {% endif %}{% endfor %}{% else %}empty{% endif %}{% else %}you have no language yet; you can give birth to your own language with found_language{% endif %}

{% endset %}
{% set land_text %}

YOUR LAND: {% if land %}#{{ land.id }} {{ land.name }}{% if land.elevation_label %}, {{ land.elevation_label }}{% endif %}{% if land.coastal %}, coastal{% endif %}{% if land.ground %}; {{ land.ground }}{% endif %}{% if land.weather %}; now {{ land.weather }}{% endif %}; neighbouring regions: {% if land.neighbours %}{% for item in land.neighbours %}#{{ item.id }} {{ item.name }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}none{% endif %}{% else %}unknown{% endif %}

{% endset %}
{% set near_body %}
{% for item in near %}
{{ entity_line(item) }}
{% endfor %}
{% endset %}
{% set near_text = "NEAR YOU:\n" ~ (budget(near_body | trim, m.ctx_nearby_chars, "look with look_at_world and search_entities", trim) if near else "(nobody)") %}
{% set events_text = "\nRECENT EVENTS:\n" ~ (budget(chronicle_rows(recent_events) | string, m.ctx_events_chars, "see the chronicle", trim) if recent_events else "(none)") %}
{% set knowledge_body %}
WHAT YOU KNOW: {% if known %}{% for item in known %}#{{ item.id }} {{ item.name }} ({{ item.branch_label }}{% if item.level %}, level {{ item.level }}{% endif %}){% if not loop.last %}, {% endif %}{% endfor %}{% else %}no knowledge yet{% endif %}

KNOWLEDGE IN THE WORLD: {% if world_knowledge %}{% for item in world_knowledge %}#{{ item.id }} {{ item.name }} ({{ item.branch_label }}){% if not loop.last %}, {% endif %}{% endfor %}{% else %}none{% endif %}
{% endset %}
{% set knowledge_text = "\n" ~ budget(knowledge_body | trim, m.ctx_knowledge_chars, "look with search_entities", trim) %}
{% set owned_text %}

WHAT YOU OWN: resources: {% if resources %}{% for item in resources %}#{{ item.id }} {{ item.name }} (abundance {{ item.abundance }}{% if item.yields %}; {{ item.yields }}{% endif %}){% if not loop.last %}, {% endif %}{% endfor %}{% else %}none{% endif %}; items: {% if items %}{% for item in items %}#{{ item.id }} {{ item.name }}{% if not loop.last %}, {% endif %}{% endfor %}{% else %}none{% endif %}
{% if stores %}YOUR PEOPLE'S STORES ({{ stores.community }}): {% if stores.materials %}{{ stores.materials | join('; ') }}{% else %}nothing of note{% endif %}{% if stores.short %}; running short of {{ stores.short | join(', ') }}{% endif %}{% if stores.routes %}; trade roads: {{ stores.routes | join('; ') }}{% endif %}{% if stores.prices %}; market prices against the usual 100: {{ stores.prices | join(', ') }}{% endif %}{% if stores.currency %}; your people count in {{ stores.currency }}{% endif %}{% if stores.loans %}; your people's loans: {{ stores.loans | join('; ') }}{% endif %}{% if stores.debts %}; debts: {{ stores.debts | join('; ') }}{% endif %}{% if stores.job %}
YOUR WORK: {{ stores.job }}{% endif %}{% endif %}
{% if home %}YOUR HOME ({{ home.community }}){% if home.tier %}: a {{ home.tier }}{% endif %}{% if home.order is not none %}; order {{ home.order }}, crime {{ home.crime }}, unrest {{ home.unrest }}{% endif %}{% if home.social_class %}; you are of the {{ home.social_class }} class{% if home.satisfaction is not none %} (content {{ home.satisfaction }} of 100){% endif %}{% endif %}{% if home.customs %}; your people's ways: {{ home.customs | join(', ') }}{% endif %}{% if home.sickness %}; sickness in the land: {{ home.sickness | join(', ') }}{% endif %}{% if home.realm %}; your realm: {{ home.realm }}{% endif %}{% if home.office %}; you hold the office of {{ home.office }}{% endif %}{% if home.house %}; you are of {{ home.house }}{% endif %}{% if home.oaths %}; you are bound by: {{ home.oaths | join(', ') }}{% endif %}{% if home.succession %}; the succession: {{ home.succession }}{% endif %}{% if home.claims %}; claims to thrones: {{ home.claims | join('; ') }}{% endif %}{% if home.treaties %}; treaties in force: {{ home.treaties | join('; ') }}{% endif %}{% if home.laws %}; the laws you live under: {{ home.laws | join('; ') }}{% endif %}{% if home.factions %}; your factions: {{ home.factions | join('; ') }}{% endif %}{% if home.wars %}; at war: {{ home.wars | join('; ') }}{% endif %}{% if home.command %}; you command {{ home.command }}{% endif %}{% if home.occupied_by %}; your land is occupied by {{ home.occupied_by }}{% endif %}{% if home.captives %}; your people hold {{ home.captives }} captives{% endif %}{% if home.tenets %}; your faith teaches: {{ home.tenets | join(', ') }}{% endif %}{% if home.judgement %}; your god judges the dead by {{ home.judgement }}{% endif %}{% if home.zeal is not none %}, and the faith burns with zeal {{ home.zeal }}{% endif %}{% if home.tongues %}; you speak: {{ home.tongues | join(', ') }}{% endif %}{% if home.techniques %}; your people know how to: {{ home.techniques | join(', ') }}{% endif %}{% if home.creed %}; the realm holds to the creed of {{ home.creed }}{% endif %}{% if home.legends %}; your people believe: {{ home.legends | join(', ') }}{% endif %}{% if home.traditions %}; your people keep: {{ home.traditions | join(', ') }}{% endif %}{% if home.prophecies %}; prophecies hang over you: {{ home.prophecies | join('; ') }}{% endif %}{% if home.rites %}; you know the rites: {{ home.rites | join(', ') }}{% endif %}{% if home.treasures %}; you hold: {{ home.treasures | join(', ') }}{% endif %}{% if home.wildlife %}; the wild kinds of your land: {{ home.wildlife | join(', ') }}{% endif %}{% if home.herds %}; your people keep herds of: {{ home.herds | join(', ') }}{% endif %}{% if home.beasts %}; beasts haunt your land: {{ home.beasts | join(', ') }}{% endif %}{% if home.works %}; the works of your home: {{ home.works | join('; ') }}{% endif %}{% endif %}
{% if home and (home.needs or home.wealth or home.loyalty or home.labour) %}YOUR LOT{% if home.needs %}: your class goes short of {{ home.needs | join(', ') }}{% endif %}{% if home.wealth %}; {{ home.wealth }}{% endif %}{% if home.loyalty %}; {{ home.loyalty }}{% endif %}{% if home.labour %}; the work of your home: {{ home.labour | join(', ') }}{% endif %}{% endif %}

{% endset %}
{% set mentions_text = "\nRECORDS THAT MENTION YOU:\n" ~ (budget(chronicle_rows(mentions) | string, m.ctx_mentions_chars, "see the chronicle", trim) if mentions else "(none)") %}
{% set rumours_body %}{% for item in rumours %}- (age {{ item.age }}, {{ item.fidelity }}% true to what happened) {{ item.text }}
{% endfor %}{% endset %}
{% set rumours_text = "\nWHAT YOUR PEOPLE HAVE HEARD (rumour, perhaps garbled):\n" ~ (budget(rumours_body | trim, m.ctx_events_chars, "rumours are uncertain", trim) if rumours else "(nothing)") %}
{% set languages_text = "\nLANGUAGES OF THE WORLD:\n" ~ (budget(languages, m.ctx_languages_chars, "look at the language's lexicon with inspect_entity", trim) if languages else "(none yet)") %}
{% set worlds_text %}
{% if other_worlds %}

OTHER WORLDS:
{{ other_worlds }}
{% if routes %}

KNOWN ROUTES OUT OF THIS WORLD (launch_expedition):
{% for route in routes %}
- route#{{ route.id }} {{ route.world_a }} ↔ {{ route.world_b }} ({{ route.method_label }}, {{ route.duration }} ages)
{% endfor %}
{% else %}

There is no known route out of this world (find_route).
{% endif %}
{% endif %}
{% endset %}
{% set expeditions_text %}
{% if expeditions %}

YOUR ONGOING EXPEDITIONS: {% for item in expeditions %}{{ item.intent_label }}, {{ item.remaining }} ages left, {{ item.people }} people{% if not loop.last %}; {% endif %}{% endfor %}

{% endif %}
{% endset %}
{% set floor = c.section_min_chars %}
{% set hint = "look with look_at_world, search_entities and inspect_entity" %}
{% set parts = [(header, header | length, hint)] %}
{% for text in [you_text, character_text, god_text, language_text, land_text, "\n" ~ near_text, events_text, rumours_text, knowledge_text, owned_text, mentions_text, languages_text, worlds_text, expeditions_text] %}
{% set _ = parts.append((text.rstrip() if text.strip() else "", floor, hint)) %}
{% endfor %}
{{ sectioned(parts, c.mortal_context_chars * (c.read_tool_multiplier if full else 1), trim) }}
