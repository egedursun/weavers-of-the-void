story#{{ thread.id }} (Age {{ thread.age }}{% if thread.worlds %}, {{ thread.worlds | join(" + ") }}{% endif %}{% if thread.advanced %}, advanced {{ thread.advanced | several("time", "times") }}, last Age {{ thread.last_age if thread.last_age is not none else thread.age }}{% else %}, never advanced{% endif %}): {{ thread.text }}{% if thread.related_ids %} [related: {% for related in thread.related_ids %}#{{ related }}{% if not loop.last %}, {% endif %}{% endfor %}]{% endif %}
