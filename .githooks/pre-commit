run storage_keys sh -c 'cd frontend && node scripts/check_storage_keys.mjs'
run spec_coverage "$PYTHON" scripts/spec_coverage.py check
run inventory "$PYTHON" scripts/check_inventory.py check

if echo "$STAGED" | grep -qE '^backend/src/aerona/(db/tables|db/alembic|domain/enums)/.*\.py$|^scripts/check_enum_constraints\.py$'; then
  run enum_constraints "$PYTHON" scripts/check_enum_constraints.py
fi

if echo "$STAGED" | grep -qE '^(backend/|scripts/).*\.py$'; then
  run static sh -c 'cd backend && .venv/bin/ruff check src && .venv/bin/ruff format --check src && .venv/bin/mypy src/aerona && .venv/bin/lint-imports'
fi

PROVING=""
if echo "$STAGED" | grep -qE '^backend/src/aerona/(engine|db|catalog|rules)/.*\.py$|^backend/tests/engine/core/(test_god_control|test_eager_epochs|test_age_coherence_lived|stirring)\.py$'; then
  PROVING="tests/engine/core/test_god_control.py tests/engine/core/test_eager_epochs.py tests/engine/core/test_age_coherence_lived.py tests/unit/test_age_paths.py tests/unit/test_method_fit.py tests/engine/core/test_unordered_reads.py tests/engine/core/test_every_change_recorded.py tests/engine/core/test_moments.py tests/engine/core/test_terms.py tests/engine/core/test_parallel_engine.py::test_a_tick_of_the_reference_world_stays_within_its_statement_budget"
fi
if echo "$STAGED" | grep -qE '^backend/(src|tests)/.*\.py$|^backend/pyproject\.toml$'; then
  PROVING="$PROVING tests/tools/test_every_tool.py tests/tools/test_catalogue.py tests/services/player/test_every_lever.py tests/services/player/test_every_job.py tests/api/test_every_endpoint.py"
  PROVING="$PROVING tests/epoch/test_epoch_llm.py::test_full_epoch_with_scripted_model"
  PROVING="$PROVING tests/epoch/test_epoch_engine_only.py::test_engine_only_epochs_run_end_to_end"
  PROVING="$PROVING tests/unit/test_total_tables.py tests/unit/test_word_matching.py tests/unit/test_tool_enum_lists.py tests/unit/test_mechanic_compliance.py tests/unit/test_model_schemas.py tests/unit/test_produced_kinds.py tests/unit/test_rule_registry.py tests/unit/test_derived_world_fields.py tests/api/test_frontend_types.py tests/unit/test_unique_levers.py tests/api/test_unique_schema_names.py tests/unit/test_json_enum_columns.py tests/unit/test_enum_text_fields.py tests/unit/test_inline_enum_tables.py tests/unit/test_ordered_set_builds.py tests/unit/test_attr_history_reads.py tests/unit/test_status_companions.py tests/unit/test_prose_enum_values.py tests/unit/test_every_incident_kind.py tests/unit/test_reaction_order.py tests/unit/test_faction_kind_reads.py tests/unit/test_engine_makes_records.py"
  PROVING="$PROVING $("$PYTHON" scripts/covering_tests.py | tr '\n' ' ')"
fi
if echo "$STAGED" | grep -qE '^backend/(src|tests)/.*\.py$|^frontend/src/.*\.(ts|tsx)$|^scripts/check_frontend_orphans\.py$'; then
  PROVING="$PROVING tests/api/test_frontend_reads_every_field.py tests/unit/test_frontend_orphans.py tests/unit/test_editable_fields.py tests/api/test_material_slot_fields.py"
fi
if echo "$STAGED" | grep -qE '^backend/(src|tests)/|^frontend/src/|^scripts/|^docs/spec/'; then
  PROVING="$PROVING tests/api/test_static.py $(cd backend && grep -lE '\.rglob\(|os\.walk\(' tests/unit/test_*.py | tr '\n' ' ')"
fi
if echo "$STAGED" | grep -qE '^backend/src/aerona/(engine|rules|catalog)/|^scripts/balance_sim\.py$|^docs/spec/13-balance-bands\.json$'; then
  PROVING="$PROVING tests/engine/integration/test_balance_bands.py tests/engine/interconnect/test_annotations.py tests/unit/test_interconnection_registry.py"
fi
if echo "$STAGED" | grep -qE '^backend/src/aerona/(db/tables|db/alembic|db/migrations\.py|domain/enums)'; then
  PROVING="$PROVING tests/db/test_schema.py"
fi
LONG_FILES="tests/engine/core/test_eager_epochs.py tests/engine/integration/test_balance_bands.py tests/engine/core/test_moments.py tests/db/test_schema.py tests/engine/core/test_god_control.py tests/engine/core/test_every_change_recorded.py tests/engine/core/test_unordered_reads.py tests/engine/core/test_terms.py tests/engine/core/test_age_coherence_lived.py tests/epoch/test_epoch_llm.py tests/epoch/test_epoch_engine_only.py tests/services/player/test_every_job.py"
UNIQUE=$(printf '%s\n' $PROVING | awk 'NF && !seen[$0]++')
LONG=""
for file in $LONG_FILES; do
  for test in $UNIQUE; do
    if [ "${test%%::*}" = "$file" ]; then LONG="$LONG $test"; fi
  done
done
REST=""
for test in $UNIQUE; do
  case " $LONG_FILES " in
    *" ${test%%::*} "*) ;;
    *) REST="$REST $test" ;;
  esac
done
CORES=$(getconf _NPROCESSORS_ONLN)
LONG_WORKERS=0
if [ -n "$LONG" ]; then
  LONG_WORKERS=4
  run proving_long sh -c "cd backend && .venv/bin/pytest -q -p no:cacheprovider --basetemp='$LOGS/pytest_long' -n $LONG_WORKERS --dist load --maxschedchunk 1 --durations=12 $LONG"
fi
REST_WORKERS=$((CORES - LONG_WORKERS))
if [ "$REST_WORKERS" -lt 4 ]; then REST_WORKERS=4; fi
if [ -n "$REST" ]; then
  run proving sh -c "cd backend && nice -n 10 .venv/bin/pytest -q -p no:cacheprovider --basetemp='$LOGS/pytest' -n $REST_WORKERS --dist worksteal --durations=15 $REST"
fi

FRONT=$(echo "$STAGED" | grep -E '^frontend/.*\.(ts|tsx)$' | grep -v '^frontend/src/api/generated/' | sed 's#^frontend/##' || true)
if [ -n "$FRONT" ]; then
  echo "$FRONT" > "$LOGS/front.list"
  run frontend sh -c "cd frontend && npx tsc -b && xargs npx eslint --no-warn-ignored < '$LOGS/front.list' && xargs npx prettier --check < '$LOGS/front.list'"
  "$PYTHON" scripts/covering_frontend_tests.py > "$LOGS/front_tests.list"
  if [ -s "$LOGS/front_tests.list" ]; then
    run frontend_tests sh -c "cd frontend && xargs npx vitest run < '$LOGS/front_tests.list'"
  fi
fi

echo "pre-commit: running$JOBS in parallel"
wait
FAILED=""
for name in $JOBS; do
  status=$(cat "$LOGS/$name.status" 2>/dev/null || echo 1)
  if [ "$status" = "0" ]; then
    echo "pre-commit: $name ok ($(grep -v "^[[:space:]]*$" "$LOGS/$name.log" | tail -n 1))"
    if [ "$name" = "proving" ] || [ "$name" = "proving_long" ]; then
      sed -n '/slowest/,/^$/p' "$LOGS/$name.log" | head -n 17
    fi
  else
    echo "pre-commit: $name FAILED"
    cat "$LOGS/$name.log"
    FAILED="$FAILED $name"
  fi
done
if [ -n "$FAILED" ]; then
  echo "pre-commit: failed:$FAILED"
  exit 1
fi
