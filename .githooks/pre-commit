#!/bin/sh
set -e
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0
PYTHON="$ROOT/backend/.venv/bin/python"
LOGS=$(mktemp -d)
trap 'rm -rf "$LOGS"' EXIT
JOBS=""

run() {
  name=$1
  shift
  ("$@" > "$LOGS/$name.log" 2>&1; echo $? > "$LOGS/$name.status") &
  JOBS="$JOBS $name"
}

run source_rules "$PYTHON" scripts/check_source_rules.py
run prompt_bias "$PYTHON" scripts/check_prompt_bias.py
run wiring "$PYTHON" scripts/check_wiring.py
run control "$PYTHON" scripts/check_control.py
run deprecated_apis "$PYTHON" scripts/check_deprecated_apis.py
run transfers "$PYTHON" scripts/check_transfers.py
run import_cycles "$PYTHON" scripts/check_import_cycles.py
run hidden_controls "$PYTHON" scripts/check_hidden_controls.py
run label_maps "$PYTHON" scripts/check_label_maps.py
run unpaged_lists "$PYTHON" scripts/check_unpaged_lists.py
run raw_ids "$PYTHON" scripts/check_raw_ids.py
run pane_grids "$PYTHON" scripts/check_pane_grids.py
run shared_labels "$PYTHON" scripts/check_shared_labels.py
run orphans "$PYTHON" scripts/check_orphans.py
run frontend_orphans "$PYTHON" scripts/check_frontend_orphans.py
run folk_queries "$PYTHON" scripts/check_folk_queries.py
run coin_units "$PYTHON" scripts/check_coin_units.py
run zero_fallbacks "$PYTHON" scripts/check_zero_fallbacks.py
run scene_colors "$PYTHON" scripts/check_scene_colors.py
run counts "$PYTHON" scripts/check_counts.py
run theme_tokens "$PYTHON" scripts/check_theme_tokens.py
run zero_ids "$PYTHON" scripts/check_zero_ids.py
run record_cuts "$PYTHON" scripts/check_record_cuts.py
run canned_lines "$PYTHON" scripts/check_canned_lines.py
run moon_orbits "$PYTHON" scripts/check_moon_orbits.py
run goods_ledger "$PYTHON" scripts/check_goods_ledger.py
run town_people "$PYTHON" scripts/check_town_people.py
run war_foes "$PYTHON" scripts/check_war_foes.py
run point_shares "$PYTHON" scripts/check_point_shares.py
run held_ids "$PYTHON" scripts/check_held_ids.py
run ended_war_sides "$PYTHON" scripts/check_ended_war_sides.py
run purse_welfare "$PYTHON" scripts/check_purse_welfare.py
run method_orphans "$PYTHON" scripts/check_method_orphans.py
run food_energy "$PYTHON" scripts/check_food_energy.py
run spec_coverage "$PYTHON" scripts/spec_coverage.py check

if echo "$STAGED" | grep -qE '^(backend/|scripts/).*\.py$'; then
  run static sh -c 'cd backend && .venv/bin/ruff check src && .venv/bin/ruff format --check src && .venv/bin/mypy src/aerona && .venv/bin/lint-imports'
fi

PROVING=""
if echo "$STAGED" | grep -qE '^backend/src/aerona/(engine|db)/.*\.py$|^backend/tests/engine/core/(test_god_control|test_eager_epochs|stirring)\.py$'; then
  PROVING="tests/engine/core/test_god_control.py tests/engine/core/test_eager_epochs.py"
fi
if echo "$STAGED" | grep -qE '^backend/(src|tests)/.*\.py$|^backend/pyproject\.toml$'; then
  PROVING="$PROVING tests/tools/test_every_tool.py tests/tools/test_catalogue.py tests/services/player/test_every_lever.py tests/services/player/test_every_job.py tests/api/test_every_endpoint.py"
  PROVING="$PROVING tests/epoch/test_epoch_llm.py::test_full_epoch_with_scripted_model"
  PROVING="$PROVING tests/epoch/test_epoch_engine_only.py::test_engine_only_epochs_run_end_to_end"
  PROVING="$PROVING tests/unit/test_total_tables.py tests/unit/test_word_matching.py tests/unit/test_tool_enum_lists.py tests/unit/test_mechanic_compliance.py tests/unit/test_model_schemas.py tests/unit/test_produced_kinds.py tests/unit/test_rule_registry.py tests/unit/test_derived_world_fields.py tests/api/test_frontend_types.py tests/unit/test_unique_levers.py tests/api/test_unique_schema_names.py tests/unit/test_json_enum_columns.py"
  PROVING="$PROVING $("$PYTHON" scripts/covering_tests.py | tr '\n' ' ')"
fi
if echo "$STAGED" | grep -qE '^backend/(src|tests)/.*\.py$|^frontend/src/.*\.(ts|tsx)$|^scripts/check_frontend_orphans\.py$'; then
  PROVING="$PROVING tests/api/test_frontend_reads_every_field.py tests/unit/test_frontend_orphans.py tests/unit/test_editable_fields.py tests/api/test_material_slot_fields.py"
fi
if [ -n "$PROVING" ]; then
  run proving sh -c "cd backend && .venv/bin/pytest -q -p no:cacheprovider --basetemp='$LOGS/pytest' -n auto --dist worksteal --durations=15 $PROVING"
fi

FRONT=$(echo "$STAGED" | grep -E '^frontend/.*\.(ts|tsx)$' | grep -v '^frontend/src/api/generated/' | sed 's#^frontend/##' || true)
if [ -n "$FRONT" ]; then
  echo "$FRONT" > "$LOGS/front.list"
  run frontend sh -c "cd frontend && npx tsc -b && xargs npx eslint --no-warn-ignored < '$LOGS/front.list' && xargs npx prettier --check < '$LOGS/front.list'"
  "$PYTHON" scripts/covering_frontend_tests.py > "$LOGS/front_tests.list"
  if [ -s "$LOGS/front_tests.list" ]; then
    run frontend_tests sh -c "cd frontend && xargs npx vitest run < '$LOGS/front_tests.list'"
  fi
fi

echo "pre-commit: running$JOBS in parallel"
wait
FAILED=""
for name in $JOBS; do
  status=$(cat "$LOGS/$name.status" 2>/dev/null || echo 1)
  if [ "$status" = "0" ]; then
    echo "pre-commit: $name ok ($(grep -v "^[[:space:]]*$" "$LOGS/$name.log" | tail -n 1))"
    if [ "$name" = "proving" ]; then
      sed -n '/slowest/,/^$/p' "$LOGS/$name.log" | head -n 17
    fi
  else
    echo "pre-commit: $name FAILED"
    cat "$LOGS/$name.log"
    FAILED="$FAILED $name"
  fi
done
if [ -n "$FAILED" ]; then
  echo "pre-commit: failed:$FAILED"
  exit 1
fi
